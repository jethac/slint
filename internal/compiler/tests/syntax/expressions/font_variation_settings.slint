// Malformed `font-variation-settings` shorthand: parse errors.

export component TestCase inherits Window {

    Text {
        font-variation-settings: "wght" 700, "wdth" 85;
    }

    Text {
        // A missing comma between pairs is a parse error.
        font-variation-settings: "wght" 700 "wdth" 85;
//                                          >    <error{Syntax error: expected ';'}
//                                          >    <^error{Parse error}
    }

    Text {
        // Axis tags must be string literals.
        font-variation-settings: wght 700;
//                                    > <error{Syntax error: expected ';'}
//                                    > <^error{Parse error}
    }
}
