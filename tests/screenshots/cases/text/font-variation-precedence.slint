// The embed-assets driver embeds glyphs at compile time without axis collection on
// this branch; the mcu branch collects the tuples and removes this ignore.
//ignore: software-embed-assets
// SIZE=140x120

// CSS precedence between `Window`'s `default-font-*` properties and per-element
// settings: per-tag, an element's own `font-variation-settings` wins over the
// window default, while unset tags inherit; `font-stretch` overrides the
// `wdth` tag like CSS's two-level font-variation-settings model.
export component TestCase inherits Window {
    width: 140px;
    height: 120px;
    background: white;
    default-font-family: "Noto Sans";
    default-font-size: 13px;
    default-font-variation-settings: "wght" 900, "wdth" 62.5;

    VerticalLayout {
        // Inherits wght 900 + wdth 62.5 from the window.
        Text { text: "w900 narrow"; }
        // wght overridden per element; wdth 62.5 still inherited.
        Text { text: "w100 narrow"; font-variation-settings: "wght" 100; }
        // font-stretch wins over the wdth tag on this element only.
        Text { text: "w900 stretch100"; font-stretch: 100%; }
        // font-variation-settings list replaces the wdth tag from the window.
        Text { text: "w900 wdth100"; font-variation-settings: "wdth" 100; }
    }
}
