// The embed-assets driver embeds glyphs at compile time without axis collection on
// this branch; the mcu branch collects the tuples and removes this ignore.
// Skia rasterizes variable-font instances differently per
// platform (macOS vs Linux references differ by up to ~200/255 per pixel).
//ignore:skia
//ignore: software-embed-assets
// SIZE=140x120

// The opsz axis on Roboto Flex: explicit `opsz` values through
// `font-variation-settings`, and `font-optical-sizing: auto` picking opsz from
// the used pixel size (18px text at auto looks different from opsz pinned to 8).
export component TestCase inherits Window {
    width: 140px;
    height: 120px;
    background: white;
    default-font-family: "Roboto Flex";
    default-font-size: 18px;
    VerticalLayout {
        Text { text: "opsz 8"; font-variation-settings: "opsz" 8; }
        Text { text: "opsz 144"; font-variation-settings: "opsz" 144; }
        Text { text: "opsz auto"; font-optical-sizing: auto; }
        Text { text: "opsz none"; font-optical-sizing: none; }
    }
}
