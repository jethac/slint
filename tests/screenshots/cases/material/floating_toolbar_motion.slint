// Scene: floating-toolbar-motion — generated from `ui-libraries/material/parity/scenes/floating-toolbar-motion.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=motion
//SIZE=400x240
//TIMES=0,400,800,2000
//TRACE_ELEMENTS=appbar0,container,fab
//ACTION=press:130,110
//ACTION=release:130,110
//MASK_DECOR=appbar0+8@0,400,800,2000
//MASK_DECOR=container+12@0,400,800,2000
//MASK_DECOR=fab+12@0,400,800,2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { FloatingToolbarColorStyle, FloatingToolbarHorizontalFabPosition, HorizontalFloatingToolbar, IconButton, Icons, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    appbar0 := HorizontalFloatingToolbar {
        x: 120px;
        y: 80px;
        fab-icon: Icons.edit;
        touch-target: false;
        IconButton { icon: Icons.check; enforce-touch-target: false; }
        IconButton { icon: Icons.menu; enforce-touch-target: false; }
        IconButton { icon: Icons.close; enforce-touch-target: false; }
    }

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if self.mouse-x >= appbar0.x && self.mouse-x <= appbar0.x + appbar0.width &&
                    self.mouse-y >= appbar0.y && self.mouse-y <= appbar0.y + appbar0.height {
                    appbar0.expanded = !appbar0.expanded;
                }
            }
        }
    }

}
