// Scene: chip-filter-states — generated from `ui-libraries/material/parity/scenes/chip-filter-states.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=xfail:skia: issue #6: on skia the drop-shadow penumbra around an elevated/pressed chip's graphicsLayer-softened edge lands ~4px inside the Compose silhouette — the corner-band edge comparison reports slint ~3 vs compose ~7 while software/femtovg match
//SIZE=712x96
//TRACE_PROPS=shadow_elevation
//TRACE_ELEMENTS=button0,button1,button2,button3,button4,button5
//MASK_INNER=button2@2000
//MASK_INNER=button3@2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { FilterChip, Icons, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := FilterChip {
        x: 16px;
        y: 32px;
        text: "Filter";
    }

    out property <length> shadow_elevation: button0.shadow_elevation;

    button1 := FilterChip {
        x: 136px;
        y: 32px;
        text: "Filter";
        icon: self.checked ? Icons.check : @image-url("");
        checked: true;
    }

    button2 := FilterChip {
        x: 256px;
        y: 32px;
        text: "Filter";
        simulate_hover: true;
    }

    button3 := FilterChip {
        x: 376px;
        y: 32px;
        text: "Filter";
        simulate_press: true;
    }

    button4 := FilterChip {
        x: 496px;
        y: 32px;
        text: "Filter";
        enabled: false;
    }

    button5 := FilterChip {
        x: 616px;
        y: 32px;
        text: "Filter";
        icon: self.checked ? Icons.check : @image-url("");
        checked: true;
        enabled: false;
    }

}
