// Scene: switch-hover — generated from `ui-libraries/material/parity/scenes/switch-hover.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=xfail:femtovg: issue #53 class: femtovg rasterizes edges via stencil+fringe with the AA band running -0.5px inside to +1.5px outside, so a border edge landing at a fractional device position covers a device-px sliver differently than coverage-integral drivers (software, skia, vello, Compose) — every switch track outline ring-diffs ~0.5-1px at d2 with a few strict pixels left in the edge slivers while track fill, thumb and geometry match; a silent pass on femtovg would mean the harness went blind
//SIZE=176x96
//TRACE_ELEMENTS=button0,button1
//MASK_DECOR=button0@0,2000
//MASK_DECOR=button1@0,2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { MaterialPalette, MaterialTheme, MaterialWindow, Switch } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := Switch {
        x: 16px;
        y: 32px;
        simulate_hover: true;
        enforce_touch_target: false;
    }

    button1 := Switch {
        x: 96px;
        y: 32px;
        checked: true;
        simulate_hover: true;
        enforce_touch_target: false;
    }

}
