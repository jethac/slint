// Scene: floating-toolbars — generated from `ui-libraries/material/parity/scenes/floating-toolbars.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
//SIZE=700x500
//TRACE_ELEMENTS=appbar0,appbar1,appbar2,appbar3
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { FloatingToolbarColorStyle, FloatingToolbarHorizontalFabPosition, FloatingToolbarVerticalFabPosition, HorizontalFloatingToolbar, IconButton, Icons, MaterialPalette, MaterialTheme, MaterialWindow, VerticalFloatingToolbar } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    appbar0 := HorizontalFloatingToolbar {
        x: 242px;
        y: 30px;
        leading-items: [{ icon: Icons.check, enabled: true }, { icon: Icons.edit, enabled: true }];
        trailing-items: [{ icon: Icons.close, enabled: true }, { icon: Icons.more_vert, enabled: true }];
        touch-target: false;
        IconButton { icon: Icons.menu; enforce-touch-target: false; }
    }

    appbar1 := HorizontalFloatingToolbar {
        x: 322px;
        y: 130px;
        leading-items: [{ icon: Icons.check, enabled: true }];
        trailing-items: [{ icon: Icons.close, enabled: true }];
        expanded: false;
        touch-target: false;
        IconButton { icon: Icons.menu; enforce-touch-target: false; }
    }

    appbar2 := VerticalFloatingToolbar {
        x: 610px;
        y: 110px;
        leading-items: [{ icon: Icons.edit, enabled: true }];
        trailing-items: [{ icon: Icons.close, enabled: true }];
        touch-target: false;
        IconButton { icon: Icons.check; enforce-touch-target: false; }
        IconButton { icon: Icons.menu; enforce-touch-target: false; }
    }

    appbar3 := VerticalFloatingToolbar {
        x: 613px;
        y: 320px;
        leading-items: [{ icon: Icons.check, enabled: true }];
        trailing-items: [{ icon: Icons.close, enabled: true }];
        expanded: false;
        touch-target: false;
        IconButton { icon: Icons.menu; enforce-touch-target: false; }
        IconButton { icon: Icons.check; enforce-touch-target: false; }
    }

}
