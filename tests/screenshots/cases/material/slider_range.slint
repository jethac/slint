// Scene: slider-range — generated from `ui-libraries/material/parity/scenes/slider-range.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=xfail:software: issue #50 — the software renderer quantizes element geometry to integer device pixels; fractional track edges diverge up to ~1 device px
//SIZE=340x330
//TRACE_ELEMENTS=slider0,slider1,slider2,slider3,slider4
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { MaterialPalette, MaterialSliderLabelBehavior, MaterialTheme, MaterialWindow, RangeSlider } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    slider0 := RangeSlider {
        x: 16px;
        y: 20px;
        minimum: 0;
        maximum: 1;
        start-value: 0.25;
        end-value: 0.75;
        width: 300px;
        enforce-touch-target: false;
        label-behavior: MaterialSliderLabelBehavior.gone;
    }

    slider1 := RangeSlider {
        x: 16px;
        y: 80px;
        minimum: 0;
        maximum: 1;
        start-value: 0.1;
        end-value: 0.9;
        steps: 4;
        width: 300px;
        enforce-touch-target: false;
        label-behavior: MaterialSliderLabelBehavior.gone;
    }

    slider2 := RangeSlider {
        x: 16px;
        y: 140px;
        minimum: 0;
        maximum: 1;
        start-value: 0;
        end-value: 1;
        width: 300px;
        enforce-touch-target: false;
        label-behavior: MaterialSliderLabelBehavior.gone;
    }

    slider3 := RangeSlider {
        x: 16px;
        y: 200px;
        minimum: 0;
        maximum: 1;
        start-value: 0.5;
        end-value: 0.5;
        steps: 2;
        width: 300px;
        enforce-touch-target: false;
        label-behavior: MaterialSliderLabelBehavior.gone;
    }

    slider4 := RangeSlider {
        x: 16px;
        y: 260px;
        minimum: 0;
        maximum: 1;
        start-value: 0.3;
        end-value: 0.7;
        enabled: false;
        width: 300px;
        enforce-touch-target: false;
        label-behavior: MaterialSliderLabelBehavior.gone;
    }

}
