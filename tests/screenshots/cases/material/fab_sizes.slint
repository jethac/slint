// Scene: fab-sizes — generated from `ui-libraries/material/parity/scenes/fab-sizes.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
//SIZE=376x128
//TRACE_ELEMENTS=button0,button1,button2,button3
//MASK_DECOR=button0@0,2000
//MASK_DECOR=button1@0,2000
//MASK_DECOR=button2@0,2000
//MASK_DECOR=button3@0,2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { ExtendedFabSize, FabAlignment, FabElevation, FabSize, FloatingActionButton, IconButtonWidth, Icons, MaterialButtonShape, MaterialButtonSize, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := FloatingActionButton {
        x: 16px;
        y: 44px;
        size: FabSize.small;
        icon: Icons.add;
        enforce_touch_target: false;
    }

    button1 := FloatingActionButton {
        x: 80px;
        y: 36px;
        size: FabSize.baseline;
        icon: Icons.add;
        enforce_touch_target: false;
    }

    button2 := FloatingActionButton {
        x: 160px;
        y: 24px;
        size: FabSize.medium;
        icon: Icons.add;
        enforce_touch_target: false;
    }

    button3 := FloatingActionButton {
        x: 264px;
        y: 16px;
        size: FabSize.large;
        icon: Icons.add;
        enforce_touch_target: false;
    }

}
