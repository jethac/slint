// Scene: docked-toolbars — generated from `ui-libraries/material/parity/scenes/docked-toolbars.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
//SIZE=400x270
//TRACE_ELEMENTS=appbar0,appbar1,appbar2
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { BottomAppBarArrangement, FlexibleBottomAppBar, Icons, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    appbar0 := FlexibleBottomAppBar {
        x: 20px;
        y: 20px;
        items: [{ icon: Icons.check, enabled: true }, { icon: Icons.edit, enabled: true }, { icon: Icons.menu, enabled: true }, { icon: Icons.close, enabled: true }];
        width: 360px;
        touch-target: false;
    }

    appbar1 := FlexibleBottomAppBar {
        x: 20px;
        y: 104px;
        arrangement: BottomAppBarArrangement.spaced;
        spacing: 32px;
        items: [{ icon: Icons.check, enabled: true }, { icon: Icons.menu, enabled: true }, { icon: Icons.close, enabled: true }];
        width: 360px;
        touch-target: false;
    }

    appbar2 := FlexibleBottomAppBar {
        x: 20px;
        y: 188px;
        items: [{ icon: Icons.check, enabled: true }, { icon: Icons.menu, enabled: true }, { icon: Icons.close, enabled: true }, { icon: Icons.edit, enabled: true }];
        height-offset: -30px;
        width: 360px;
        touch-target: false;
    }

}
