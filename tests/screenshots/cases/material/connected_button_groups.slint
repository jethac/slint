import "../../fonts/Roboto-VariableFont.ttf";
import { ConnectedButton, ConnectedButtonGroup, ConnectedButtonPosition, Icons, MaterialPalette, MaterialTheme, MaterialWindow, VerticalConnectedButtonGroup } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    group0 := ConnectedButtonGroup {
        x: 16px;
        y: 20px;
        items: [{ icon: @image-url(""), checked_icon: @image-url(""), text: "Day", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Week", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Month", tooltip: "", disabled: false, checked: false }];
        selected_index: 1;
        enforce_touch_target: false;
    }

    group1 := ConnectedButtonGroup {
        x: 16px;
        y: 84px;
        items: [{ icon: @image-url(""), checked_icon: @image-url(""), text: "Mon", tooltip: "", disabled: false, checked: true }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Tue", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Wed", tooltip: "", disabled: false, checked: true }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Thu", tooltip: "", disabled: false, checked: false }];
        multi_select: true;
        selected_index: -1;
        enforce_touch_target: false;
    }

    group2 := ConnectedButtonGroup {
        x: 16px;
        y: 148px;
        items: [{ icon: Icons.edit, checked_icon: Icons.check, text: "Edit", tooltip: "", disabled: false, checked: false }, { icon: Icons.menu, checked_icon: Icons.check, text: "Save", tooltip: "", disabled: false, checked: false }, { icon: Icons.arrow_right, checked_icon: Icons.check, text: "Go", tooltip: "", disabled: false, checked: false }];
        selected_index: 2;
        simulate_hover_index: 2;
        enforce_touch_target: false;
    }

    group3 := ConnectedButtonGroup {
        x: 16px;
        y: 212px;
        items: [{ icon: @image-url(""), checked_icon: @image-url(""), text: "One", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Two", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Three", tooltip: "", disabled: false, checked: false }];
        selected_index: -1;
        simulate_press_index: 1;
        enforce_touch_target: false;
    }

    group4 := ConnectedButtonGroup {
        x: 16px;
        y: 276px;
        items: [{ icon: @image-url(""), checked_icon: @image-url(""), text: "Yes", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "No", tooltip: "", disabled: true, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Maybe", tooltip: "", disabled: false, checked: false }];
        selected_index: 0;
        enforce_touch_target: false;
    }

    group5 := VerticalConnectedButtonGroup {
        x: 16px;
        y: 340px;
        items: [{ icon: @image-url(""), checked_icon: @image-url(""), text: "Top", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Mid", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Bot", tooltip: "", disabled: false, checked: false }];
        selected_index: 0;
        enforce_touch_target: false;
    }

    button0 := ConnectedButton {
        x: 300px;
        y: 340px;
        position: ConnectedButtonPosition.start;
        text: "Start";
        width: 80px;
        enforce_touch_target: false;
    }

    button1 := ConnectedButton {
        x: 300px;
        y: 404px;
        position: ConnectedButtonPosition.middle;
        text: "Mid";
        icon: Icons.edit;
        checked_icon: Icons.check;
        checked: true;
        width: 90px;
        enforce_touch_target: false;
    }

    button2 := ConnectedButton {
        x: 300px;
        y: 468px;
        position: ConnectedButtonPosition.end;
        text: "End";
        width: 80px;
        enforce_touch_target: false;
    }

}
