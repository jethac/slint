// Scene: list-select-morph — generated from `ui-libraries/material/parity/scenes/list-select-morph.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=xfail: the click-select morph and ripple ink run through identical-timestamp frames on different engine clocks: mid-flight spring radii lead each other by a few px and the bounded ink circle reads as a silhouette edge where the container fill is within the scan epsilon of the outside color — a silent pass would mean the harness went blind
//SIZE=200x96
//TIMES=0,15,30,60,120,200,333,500,800,1500
//TRACE_PROPS=container_radius
//TRACE_ELEMENTS=item0
//ACTION=press:100,48
//ACTION=release:100,48
//ACTION=move@1:0,0
//MASK_INNER=item0@15,30,60,120,200,333,500,800,1500
//XFAIL_TEXT=issue #28: Slint ceils text layout widths where Compose keeps fractional advances
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { ListTile, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    item0 := ListTile {
        x: 8px;
        y: 20px;
        text: "Label";
        selectable: true;
        width: 184px;
        enforce_touch_target: false;
        clicked => {
            self.selected = !self.selected;
        }
    }

    out property <length> container_radius: item0.container_radius;

}
