// Scene: card-states-outlined — generated from `ui-libraries/material/parity/scenes/card-states-outlined.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
//SIZE=856x112
//TRACE_ELEMENTS=card0,card1,card2,card3,card4
//ACTION=key:Tab
//ACTION=key:Tab
//ACTION=key:Tab
//MASK_INNER=card2@2000
//MASK_DECOR=card0@2000
//MASK_DECOR=card1@2000
//MASK_DECOR=card2@2000
//MASK_DECOR=card3@2000
//MASK_DECOR=card4+14@2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { MaterialPalette, MaterialTheme, MaterialWindow, OutlinedCard } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    card0 := OutlinedCard {
        x: 16px;
        y: 16px;
        width: 120px;
        height: 80px;
        clickable: true;
    }

    card1 := OutlinedCard {
        x: 156px;
        y: 16px;
        width: 120px;
        height: 80px;
        clickable: true;
        simulate_hover: true;
    }

    card2 := OutlinedCard {
        x: 296px;
        y: 16px;
        width: 120px;
        height: 80px;
        clickable: true;
    }

    card3 := OutlinedCard {
        x: 436px;
        y: 16px;
        width: 120px;
        height: 80px;
        clickable: true;
        enabled: false;
    }

    card4 := OutlinedCard {
        x: 576px;
        y: 16px;
        width: 120px;
        height: 80px;
        clickable: true;
        dragged: true;
    }

}
