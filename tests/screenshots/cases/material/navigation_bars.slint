// Scene: navigation-bars — generated from `ui-libraries/material/parity/scenes/navigation-bars.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
//SIZE=360x420
//TRACE_ELEMENTS=navbar0,navbar1,navbar2,navbar3,navbar4
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { Icons, MaterialPalette, MaterialTheme, MaterialWindow, NavigationBar, NavigationItemIconPosition, ShortNavigationBar, ShortNavigationBarArrangement } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    navbar0 := NavigationBar {
        x: 0px;
        y: 0px;
        width: 360px;
        current-index: 0;
        items: [
            { icon: Icons.check, selected-icon: Icons.arrow_right, text: "Inbox", badge: "3", show-badge: true, enabled: true },
            { icon: Icons.schedule, text: "Sent", enabled: true },
            { icon: Icons.keyboard, text: "Files", enabled: false },
            { icon: Icons.close, text: "Trash", enabled: true },
        ];
    }

    navbar1 := NavigationBar {
        x: 0px;
        y: 96px;
        width: 360px;
        always-show-label: false;
        current-index: 1;
        items: [
            { icon: Icons.check, text: "Inbox", enabled: true },
            { icon: Icons.schedule, text: "Sent", enabled: true },
            { icon: Icons.keyboard, text: "Files", enabled: true },
            { icon: Icons.close, text: "Trash", enabled: true },
        ];
    }

    navbar2 := ShortNavigationBar {
        x: 0px;
        y: 192px;
        width: 360px;
        item-min-size: 0px;
        current-index: 0;
        items: [
            { icon: Icons.check, selected-icon: Icons.arrow_right, text: "Inbox", badge: "3", show-badge: true, enabled: true },
            { icon: Icons.schedule, text: "Sent", enabled: true },
            { icon: Icons.keyboard, text: "Files", enabled: false },
        ];
    }

    navbar3 := ShortNavigationBar {
        x: 0px;
        y: 272px;
        width: 360px;
        arrangement: ShortNavigationBarArrangement.centered;
        icon-position: NavigationItemIconPosition.start;
        item-min-size: 0px;
        current-index: 1;
        items: [
            { icon: Icons.check, selected-icon: Icons.arrow_right, text: "Inbox", enabled: true },
            { icon: Icons.schedule, text: "Sent", enabled: true },
            { icon: Icons.keyboard, text: "Files", enabled: false },
        ];
    }

    navbar4 := ShortNavigationBar {
        x: 0px;
        y: 352px;
        width: 360px;
        item-min-size: 0px;
        current-index: 2;
        items: [
            { icon: Icons.check, text: "", enabled: true },
            { icon: Icons.schedule, text: "", enabled: true },
            { icon: Icons.keyboard, text: "", enabled: true },
            { icon: Icons.close, text: "", enabled: true },
        ];
    }

}
