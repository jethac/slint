// Scene: card-variants — generated from `ui-libraries/material/parity/scenes/card-variants.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
// the elevated card's graphicsLayer-softened shadow penumbra lands ~1px inside the strict band (residual <=15 channel diff); the strict interior and silhouette stay unchanged
//PARITY_EPS=16
//SIZE=832x112
//TRACE_ELEMENTS=card0,card1,card2,card3,card4,card5
//MASK_DECOR=card0@2000
//MASK_DECOR=card3@2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { ElevatedCard, FilledCard, MaterialPalette, MaterialTheme, MaterialWindow, OutlinedCard } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    card0 := ElevatedCard {
        x: 16px;
        y: 16px;
        width: 120px;
        height: 80px;
    }

    card1 := FilledCard {
        x: 152px;
        y: 16px;
        width: 120px;
        height: 80px;
    }

    card2 := OutlinedCard {
        x: 288px;
        y: 16px;
        width: 120px;
        height: 80px;
    }

    card3 := ElevatedCard {
        x: 424px;
        y: 16px;
        width: 120px;
        height: 80px;
        clickable: true;
    }

    card4 := FilledCard {
        x: 560px;
        y: 16px;
        width: 120px;
        height: 80px;
        clickable: true;
    }

    card5 := OutlinedCard {
        x: 696px;
        y: 16px;
        width: 120px;
        height: 80px;
        clickable: true;
    }

}
