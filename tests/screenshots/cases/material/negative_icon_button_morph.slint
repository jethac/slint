// Scene: negative-icon-button-morph — generated from `ui-libraries/material/parity/scenes/negative-icon-button-morph.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=negative: the covering rectangle repaints the pressed icon button at its resting 28px radius — a corner that fails to morph on press must fail
//SIZE=120x96
//TRACE_ELEMENTS=button0
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { FilledIconButton, IconButtonWidth, Icons, MaterialButtonShape, MaterialButtonSize, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := FilledIconButton {
        x: 32px;
        y: 20px;
        size: MaterialButtonSize.medium;
        icon: Icons.check;
        simulate_press: true;
        enforce_touch_target: false;
    }

    // Deliberate defect (scene `slint_overrides.cover`).
    Rectangle {
        x: button0.x;
        y: button0.y;
        width: button0.width;
        height: button0.height;
        border-radius: 28px;
        background: MaterialPalette.primary;
        opacity: 1;
        Text {
            text: "";
            color: MaterialPalette.on_primary;
            font-family: "Roboto";
            font-weight: 500;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

}
