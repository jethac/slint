// Scene: toggle-fab-morph — generated from `ui-libraries/material/parity/scenes/toggle-fab-morph.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=motion
//SIZE=140x140
//TIMES=0,33,66,100,150,200,300,400,600
//TRACE_PROPS=container_radius,container_size,checked_progress
//TRACE_ELEMENTS=button0,button0>button-bg
//ACTION=press:70,70
//ACTION=release:70,70
//ACTION=move@1:0,0
//MASK_SHADOW=button0@0,33,66,100,150,200,300,400,600
//MASK_SHADOW=button0>button-bg0@0,33,66,100,150,200,300,400,600
//PHASE_TOL_MS=16
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { FabMenuSize, Icons, MaterialPalette, MaterialTheme, MaterialWindow, ToggleFloatingActionButton } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := ToggleFloatingActionButton {
        x: 30px;
        y: 30px;
        size: FabMenuSize.medium;
        icon: Icons.edit;
        checked-icon: Icons.close;
    }

    out property <length> container_radius: button0.container_radius;

    out property <length> container_size: button0.container_size;

    out property <float> checked_progress: button0.checked_progress;

}
