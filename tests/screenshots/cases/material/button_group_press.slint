// Scene: button-group-press — generated from `ui-libraries/material/parity/scenes/button-group-press.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=motion
//SIZE=340x96
//TRACE_PROPS=g0i0_w,g0i1_w,g0i2_w,g0i1_x
//TRACE_ELEMENTS=group0
//TRACE_ELEMENT_PROPS=button0:button0_x:button0_y:button0_w:button0_h,button1:button1_x:button1_y:button1_w:button1_h,button2:button2_x:button2_y:button2_w:button2_h
//MASK_INNER=button1@2000
//XFAIL_TEXT=*1.5: issue #28: Slint ceils text layout widths where Compose keeps fractional advances
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { ButtonGroup, ButtonGroupSelection, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    group0 := ButtonGroup {
        x: 16px;
        y: 28px;
        simulate-press: true;
        simulate-index: 1;
        items: [{ text: "Day", }, { text: "Week", }, { text: "Month", }];
    }

    out property <length> g0i0_w: group0.items[0].final-w;

    out property <length> g0i1_w: group0.items[1].final-w;

    out property <length> g0i2_w: group0.items[2].final-w;

    out property <length> g0i1_x: group0.items[1].x-pos;

    out property <length> button0_x: group0.items[0].abs-x;
    out property <length> button0_y: group0.items[0].abs-y;
    out property <length> button0_w: group0.items[0].final-w;
    out property <length> button0_h: group0.items[0].item-h;

    out property <length> button1_x: group0.items[1].abs-x;
    out property <length> button1_y: group0.items[1].abs-y;
    out property <length> button1_w: group0.items[1].final-w;
    out property <length> button1_h: group0.items[1].item-h;

    out property <length> button2_x: group0.items[2].abs-x;
    out property <length> button2_y: group0.items[2].abs-y;
    out property <length> button2_w: group0.items[2].final-w;
    out property <length> button2_h: group0.items[2].item-h;

}
