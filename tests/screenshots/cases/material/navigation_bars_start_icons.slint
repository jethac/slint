// Scene: navigation-bars-start-icons — generated from `ui-libraries/material/parity/scenes/navigation-bars-start-icons.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=xfail: issue #28: Slint ceils text layout widths where Compose keeps fractional advances; start-icon item geometry is label-width-driven, so icon/pill/badge positions shift ~1px (strict-pixel-only divergence)
//SIZE=360x152
//TRACE_ELEMENTS=navbar0,navbar1
//DENSITIES=1
import "../../fonts/Roboto-VariableFont.ttf";
import { Icons, MaterialPalette, MaterialTheme, MaterialWindow, NavigationItemIconPosition, ShortNavigationBar, ShortNavigationBarArrangement } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    navbar0 := ShortNavigationBar {
        x: 0px;
        y: 0px;
        width: 360px;
        icon-position: NavigationItemIconPosition.start;
        item-min-size: 0px;
        current-index: 0;
        items: [
            { icon: Icons.check, selected-icon: Icons.arrow_right, text: "Inbox", badge: "3", show-badge: true, enabled: true },
            { icon: Icons.schedule, text: "Share", enabled: true },
            { icon: Icons.keyboard, text: "Saved", enabled: false },
        ];
    }

    navbar1 := ShortNavigationBar {
        x: 0px;
        y: 80px;
        width: 360px;
        arrangement: ShortNavigationBarArrangement.centered;
        icon-position: NavigationItemIconPosition.start;
        item-min-size: 0px;
        current-index: 1;
        items: [
            { icon: Icons.check, selected-icon: Icons.arrow_right, text: "Inbox", enabled: true },
            { icon: Icons.schedule, text: "Share", enabled: true },
            { icon: Icons.keyboard, text: "Saved", enabled: false },
        ];
    }

}
