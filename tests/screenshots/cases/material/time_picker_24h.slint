// Scene: time-picker-24h — generated from `ui-libraries/material/parity/scenes/time-picker-24h.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
// llvmpipe coverage rasterization lands the dial circle's flattest bottom arc ~9-10 channels off the Compose reference on 2-6 edge pixels at 2x; skia/software/vello_cpu match within the default 8 - AA sampling noise on a near-horizontal curve, not geometry
//PARITY_EPS=12
// skia on macOS rasterizes the display separator's ":" a hint-step off the Linux path — the settled frame's colon cell drifts to mean diff 50 vs the 48 text bound while geometry and strict pixels all match; relax only the text-cell mean for this case (not an xfail: nothing here diverges)
//PARITY_TEXT_EPS=56
//SIZE=400x560
//TRACE_ELEMENTS=picker0
//MASK_DECOR=picker0+4@2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { MaterialPalette, MaterialTheme, MaterialWindow, TimePicker, TimePickerLayoutType, TimePickerSelection } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    picker0 := TimePicker {
        x: Math.round((parent.width - self.width) / 1phx / 2) * 1phx;
        y: Math.round((parent.height - self.height) / 1phx / 2) * 1phx;
        hour: 22;
        minute: 45;
        use_24_hour_format: true;
    }

}
