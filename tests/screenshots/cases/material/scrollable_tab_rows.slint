import "../../fonts/Roboto-VariableFont.ttf";
import { Icons, MaterialPalette, MaterialTheme, MaterialWindow, ScrollableSecondaryTabBar, ScrollableTabBar } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    tabrow0 := ScrollableTabBar {
        x: 16px;
        y: 16px;
        items: [{ icon: @image-url(""), selected_icon: @image-url(""), text: "All", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Images", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Videos", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "News", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Books", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Flights", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Shopping", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Finance", disabled: false, leading_icon: false }];
        current_index: 5;
