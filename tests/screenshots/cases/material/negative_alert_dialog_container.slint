// Scene: negative-alert-dialog-container — generated from `ui-libraries/material/parity/scenes/negative-alert-dialog-container.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=negative: the pane fills with surface-container-lowest instead of the dialog token's surface-container-high
//SIZE=500x360
//TRACE_ELEMENTS=scrim0,dialog0
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { AlertDialogContent, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    scrim0 := Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: MaterialPalette.background_modal;
    }

    dialog0 := AlertDialogContent {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        available_width: parent.width;
        cast_shadow: false;
        action_enforce_touch_target: false;
        title: "Discard draft?";
        text: "A dialog is a type of modal window that appears in front of app content.";
        actions: ["Dismiss", "Delete"];
        container_color: MaterialPalette.surface_container_lowest;
    }

}
