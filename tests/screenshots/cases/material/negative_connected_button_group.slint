// Scene: negative-connected-button-group — generated from `ui-libraries/material/parity/scenes/negative-connected-button-group.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=negative: slint_overrides force `selected_index: 0` where the reference selects item 1 (wrong item morphs to CornerFull) and force `position: middle` on the standalone leading item (inner corners rendered on both sides) — each must fail
//SIZE=360x160
//TRACE_ELEMENTS=group0,button0
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { ConnectedButton, ConnectedButtonGroup, ConnectedButtonPosition, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    group0 := ConnectedButtonGroup {
        x: 16px;
        y: 20px;
        items: [{ icon: @image-url(""), checked_icon: @image-url(""), text: "Day", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Week", tooltip: "", disabled: false, checked: false }, { icon: @image-url(""), checked_icon: @image-url(""), text: "Month", tooltip: "", disabled: false, checked: false }];
        selected_index: 0;
        enforce_touch_target: false;
    }

    button0 := ConnectedButton {
        x: 16px;
        y: 100px;
        position: ConnectedButtonPosition.middle;
        text: "Start";
        width: 88px;
        enforce_touch_target: false;
    }

}
