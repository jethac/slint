// Scene: fab-menu — generated from `ui-libraries/material/parity/scenes/fab-menu.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
//SIZE=640x300
//TRACE_PROPS=checked_progress
//TRACE_ELEMENTS=menu0,menu0>toggle,menu0>container,menu1,menu1>toggle,menu1>container,menu2,menu2>toggle,menu2>container
//MASK_SHADOW=menu0@0,2000
//MASK_SHADOW=menu0>container0@0,2000
//MASK_SHADOW=menu0>container1@0,2000
//MASK_SHADOW=menu0>container2@0,2000
//MASK_SHADOW=menu0>toggle0@0,2000
//MASK_SHADOW=menu1@0,2000
//MASK_SHADOW=menu1>container0@0,2000
//MASK_SHADOW=menu1>container1@0,2000
//MASK_SHADOW=menu1>container2@0,2000
//MASK_SHADOW=menu1>toggle0@0,2000
//MASK_SHADOW=menu2@0,2000
//MASK_SHADOW=menu2>container0@0,2000
//MASK_SHADOW=menu2>container1@0,2000
//MASK_SHADOW=menu2>container2@0,2000
//MASK_SHADOW=menu2>toggle0@0,2000
//XFAIL_TEXT=issue #28: Slint ceils text layout widths where Compose keeps fractional advances
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { FabMenuSize, FloatingActionButtonMenu, Icons, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    menu0 := FloatingActionButtonMenu {
        x: 440px;
        y: 44px;
        expanded: true;
        button-icon: Icons.edit;
        button-checked-icon: Icons.close;
        items: [{ icon: Icons.check, text: "Compose", enabled: true }, { icon: Icons.schedule, text: "Send", enabled: true }, { icon: Icons.arrow_right, text: "Archive", enabled: true }];
    }

    out property <float> checked_progress: menu0.checked_progress;

    menu1 := FloatingActionButtonMenu {
        x: 220px;
        y: 44px;
        expanded: true;
        button-size: FabMenuSize.medium;
        button-icon: Icons.edit;
        button-checked-icon: Icons.close;
        horizontal-alignment: LayoutAlignment.center;
        items: [{ icon: Icons.check, text: "Compose", enabled: true }, { icon: Icons.schedule, text: "Send", enabled: true }, { icon: Icons.arrow_right, text: "Archive", enabled: true }];
    }

    menu2 := FloatingActionButtonMenu {
        x: 20px;
        y: 44px;
        expanded: true;
        button-size: FabMenuSize.large;
        button-icon: Icons.edit;
        button-checked-icon: Icons.close;
        horizontal-alignment: LayoutAlignment.start;
        items: [{ icon: Icons.check, text: "Compose", enabled: true }, { icon: Icons.schedule, text: "Send", enabled: true }, { icon: Icons.arrow_right, text: "Archive", enabled: true }];
    }

}
