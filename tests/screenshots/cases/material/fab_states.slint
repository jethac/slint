// Scene: fab-states — generated from `ui-libraries/material/parity/scenes/fab-states.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
// issue #6: the layoutlib-vs-SkShadowUtils elevation shadow penumbra diverges ~11-20 channels around 6-8dp widgets at 2x; the container silhouette itself matches within 1px
//PARITY_EPS=24
//SIZE=568x112
//TRACE_PROPS=shadow_elevation
//TRACE_ELEMENTS=button0,button1,button2,button3,button4,button5
//ACTION=key:Tab
//ACTION=key:Tab
//MASK_DECOR=button0@0,2000
//MASK_DECOR=button1@0,2000
//MASK_DECOR=button2@0,2000
//MASK_DECOR=button3@0,2000
//MASK_DECOR=button4@0,2000
//MASK_DECOR=button5@0,2000
//MASK_DECOR=button6@0,2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { ExtendedFabSize, FabAlignment, FabElevation, FabSize, FloatingActionButton, Icons, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := FloatingActionButton {
        x: 16px;
        y: 28px;
        icon: Icons.add;
        simulate_hover: true;
        enforce_touch_target: false;
    }

    out property <length> shadow_elevation: button0.shadow_elevation;

    button1 := FloatingActionButton {
        x: 176px;
        y: 28px;
        icon: Icons.add;
        enforce_touch_target: false;
    }

    button2 := FloatingActionButton {
        x: 256px;
        y: 28px;
        icon: Icons.add;
        enforce_touch_target: false;
    }

    button3 := FloatingActionButton {
        x: 336px;
        y: 28px;
        icon: Icons.add;
        elevation_style: FabElevation.lowered;
        enforce_touch_target: false;
    }

    button4 := FloatingActionButton {
        x: 416px;
        y: 28px;
        icon: Icons.add;
        elevation_style: FabElevation.bottom_app_bar;
        enforce_touch_target: false;
    }

    button5 := FloatingActionButton {
        x: 496px;
        y: 28px;
        icon: Icons.add;
        container_color: MaterialPalette.secondary_container;
        content_color: MaterialPalette.on_secondary_container;
        enforce_touch_target: false;
    }

}
