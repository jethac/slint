// Scene: negative-toggle-select — generated from `ui-libraries/material/parity/scenes/negative-toggle-select.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=negative: slint_overrides drops `checkable`, so the Slint widget renders the resting round shape while checked — a toggle that does not morph on selection must fail
//SIZE=240x96
//TRACE_ELEMENTS=button0
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { FilledButton, IconButtonWidth, MaterialButtonShape, MaterialButtonSize, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := FilledButton {
        x: 16px;
        y: 28px;
        text: "Label";
        size: MaterialButtonSize.small;
        checked: true;
        width: 86px;
        enforce_touch_target: false;
    }

}
