// Scene: connected-button-morph — generated from `ui-libraries/material/parity/scenes/connected-button-morph.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=motion
//SIZE=200x96
//TIMES=0,15,30,60,120,200,333,500,800,1500
//TRACE_PROPS=corner_top_left,corner_top_right,corner_bottom_right,corner_bottom_left
//TRACE_ELEMENTS=button0
//ACTION=press:84,48
//ACTION=release:84,48
//ACTION=move@1:0,0
//MASK_INNER=button0@15,30,60,120,200,333,500,800,1500
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { ConnectedButton, ConnectedButtonPosition, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := ConnectedButton {
        x: 40px;
        y: 28px;
        position: ConnectedButtonPosition.end;
        text: "End";
        width: 88px;
        enforce_touch_target: false;
    }

    out property <length> corner_top_left: button0.corner_top_left;

    out property <length> corner_top_right: button0.corner_top_right;

    out property <length> corner_bottom_right: button0.corner_bottom_right;

    out property <length> corner_bottom_left: button0.corner_bottom_left;

}
