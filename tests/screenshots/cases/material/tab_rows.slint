//TRACE_ITEMS=tabrow0:item,tabrow1:item,tabrow2:item,tabrow3:item,tabrow4:item
//XFAIL_TEXT=issue #28: Slint ceils text layout widths where Compose keeps fractional advances
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { Icons, MaterialPalette, MaterialTheme, MaterialWindow, SecondaryTabBar, TabBar } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    tabrow0 := TabBar {
        x: 16px;
        y: 16px;
        items: [{ icon: @image-url(""), selected_icon: @image-url(""), text: "Movies", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "TV", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Music", disabled: false, leading_icon: false }];
        current_index: 1;
        width: 608px;
    }

    tabrow1 := TabBar {
        x: 16px;
        y: 80px;
        items: [{ icon: Icons.edit, selected_icon: @image-url(""), text: "Edit", disabled: false, leading_icon: false }, { icon: Icons.calendar_today, selected_icon: @image-url(""), text: "Calendar", disabled: false, leading_icon: false }, { icon: Icons.schedule, selected_icon: @image-url(""), text: "Clock", disabled: false, leading_icon: false }];
        current_index: 0;
        width: 608px;
    }

    tabrow2 := TabBar {
        x: 16px;
        y: 168px;
        items: [{ icon: Icons.edit, selected_icon: @image-url(""), text: "Edit", disabled: false, leading_icon: true }, { icon: Icons.calendar_today, selected_icon: @image-url(""), text: "Calendar", disabled: false, leading_icon: true }, { icon: Icons.schedule, selected_icon: @image-url(""), text: "Clock", disabled: false, leading_icon: true }];
        current_index: 2;
        width: 608px;
    }

    tabrow3 := SecondaryTabBar {
        x: 16px;
        y: 232px;
        items: [{ icon: @image-url(""), selected_icon: @image-url(""), text: "Overview", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Details", disabled: false, leading_icon: false }, { icon: @image-url(""), selected_icon: @image-url(""), text: "Reviews", disabled: false, leading_icon: false }];
        current_index: 0;
        width: 608px;
    }

    tabrow4 := SecondaryTabBar {
        x: 16px;
        y: 296px;
        items: [{ icon: Icons.check, selected_icon: @image-url(""), text: "Done", disabled: false, leading_icon: false }, { icon: Icons.menu, selected_icon: @image-url(""), text: "Menu", disabled: false, leading_icon: false }, { icon: Icons.keyboard, selected_icon: @image-url(""), text: "Keys", disabled: false, leading_icon: false }];
        current_index: 1;
        width: 608px;
    }

}
