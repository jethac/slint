// Scene: radio-states — generated from `ui-libraries/material/parity/scenes/radio-states.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=xfail:femtovg: issue #53: femtovg's stencil+fringe rasterizer runs the AA band -0.5px inside to +1.5px outside the path edge, so the radio ring/dot edges sit ~0.5px outside the coverage-integral drivers' silhouette — 8-16 strict pixels at d2 with channel diffs 11-27; trace and text layers still verify on femtovg — a silent pass would mean the harness went blind
//SIZE=240x96
//TRACE_ELEMENTS=button0,button1,button2,button3,button4,button5
//ACTION=key:Tab
//ACTION=key:Tab
//ACTION=key:Tab
//MASK_DECOR=button2@0,2000
//MASK_DECOR=button3@0,2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { MaterialPalette, MaterialTheme, MaterialWindow, RadioButton } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := RadioButton {
        x: 16px;
        y: 36px;
        enforce_touch_target: false;
    }

    button1 := RadioButton {
        x: 56px;
        y: 36px;
        checked: true;
        enforce_touch_target: false;
    }

    button2 := RadioButton {
        x: 96px;
        y: 36px;
        checked: true;
        enforce_touch_target: false;
    }

    button3 := RadioButton {
        x: 136px;
        y: 36px;
        simulate_hover: true;
        enforce_touch_target: false;
    }

    button4 := RadioButton {
        x: 176px;
        y: 36px;
        checked: true;
        enabled: false;
        enforce_touch_target: false;
    }

    button5 := RadioButton {
        x: 216px;
        y: 36px;
        enabled: false;
        enforce_touch_target: false;
    }

}
