// Scene: tooltips — generated from `ui-libraries/material/parity/scenes/tooltips.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
//SIZE=360x500
//TRACE_ELEMENTS=tooltip0,tooltip1,tooltip2,tooltip3,tooltip4
//XFAIL_TEXT=tooltip label advance drift: the issue-#28 text-metric ceil moves glyphs inside otherwise identical container bounds (the traced tooltip boxes compare clean at both densities; the drift only shows inside text cells)
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { MaterialPalette, MaterialTheme, MaterialWindow, PlainTooltip, RichTooltip } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    tooltip0 := PlainTooltip {
        x: 16px;
        y: 16px;
        text: "Tooltip";
    }

    tooltip1 := PlainTooltip {
        x: 16px;
        y: 56px;
        text: "Tooltips display informative text when users hover over an element.";
    }

    tooltip2 := PlainTooltip {
        x: 16px;
        y: 132px;
        text: "Tooltip";

        container_color: MaterialPalette.primary;    }

    tooltip3 := RichTooltip {
        x: 16px;
        y: 176px;
        text: "Rich tooltips inform users.";
        title: "Permissions";
    }

    tooltip4 := RichTooltip {
        x: 16px;
        y: 312px;
        text: "Rich tooltips inform users.";
        title: "Permissions";
        action_text: "MANAGE";
    }

}
