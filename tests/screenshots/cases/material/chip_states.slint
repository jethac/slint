// Scene: chip-states — generated from `ui-libraries/material/parity/scenes/chip-states.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=xfail:skia: issue #6: on skia the elevated chip's shadow penumbra inside the strict band diffs up to ~33 channel units while software/femtovg match within eps 16
// issue #6: the elevated assist chip's graphicsLayer-softened edge and drop-shadow penumbra land ~1px inside the strict band (residual <=14 channel diff); the silhouette boundary check stays strict (band 2.0)
//PARITY_EPS=16
//SIZE=712x96
//TRACE_PROPS=shadow_elevation
//TRACE_ELEMENTS=button0,button1,button2,button3,button4,button5
//ACTION=key:Tab
//ACTION=key:Tab
//ACTION=key:Tab
//ACTION=key:Tab
//MASK_INNER=button2@2000
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { AssistChip, ElevatedAssistChip, MaterialPalette, MaterialTheme, MaterialWindow } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    button0 := AssistChip {
        x: 16px;
        y: 32px;
        text: "Assist";
    }

    out property <length> shadow_elevation: button0.shadow_elevation;

    button1 := AssistChip {
        x: 136px;
        y: 32px;
        text: "Assist";
        simulate_hover: true;
    }

    button2 := AssistChip {
        x: 256px;
        y: 32px;
        text: "Assist";
        simulate_press: true;
    }

    button3 := AssistChip {
        x: 376px;
        y: 32px;
        text: "Assist";
    }

    button4 := AssistChip {
        x: 496px;
        y: 32px;
        text: "Assist";
        enabled: false;
    }

    button5 := ElevatedAssistChip {
        x: 616px;
        y: 32px;
        text: "Assist";
    }

}
