// Scene: basic-alert-dialog — generated from `ui-libraries/material/parity/scenes/basic-alert-dialog.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
//SIZE=500x360
//TRACE_ELEMENTS=scrim0,basic0,basic0action0
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { MaterialPalette, MaterialStyleMetrics, MaterialText, MaterialTheme, MaterialTypography, MaterialWindow, TextButton } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    scrim0 := Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: MaterialPalette.background_modal;
    }

    basic0 := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        // The Compose `sizeIn` clamp grows the pane to the widest child's
        // preferred width; the wrapping title under-measures as min-width,
        // so `measure0` (invisible twin) supplies the preferred term.
        measure0 := MaterialText {
            visible: false;
            text: "Custom content";
            style: MaterialTypography.headline_small;
        }
        width: min(max(280px, inner.min_width, measure0.preferred-width + 48px), min(560px, parent.width));
        height: inner.min_height;
        border-radius: MaterialStyleMetrics.border_radius_28;
        background: MaterialPalette.surface_container_high;
        clip: true;
        inner := VerticalLayout {
            padding: 24px;
            spacing: 24px;
            MaterialText {
                text: "Custom content";
                style: MaterialTypography.headline_small;
                color: MaterialPalette.on_surface;
                wrap: word_wrap;
                width: min(self.preferred-width, root.width - 48px);
            }

            // align(End) on the actions box
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                for action_text[index] in ["Dismiss"] : action := TextButton {
                    text: action_text;
                    enforce_touch_target: false;
                    // The mirror renders the stable `TextButton` overload.
                    expressive: false;
                }

            }
        }
    }

}
