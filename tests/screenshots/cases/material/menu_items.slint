// Scene: menu-items — generated from `ui-libraries/material/parity/scenes/menu-items.json`
// (edit the scene, regenerate with `cargo run -p material-parity-generator`).
//PARITY=static
// (undocumented)
//PARITY_EPS=10
//SIZE=520x640
//TRACE_ELEMENTS=menu0,menu1,menu2,menu3
//MASK_DECOR=menu0+16@0,2000
//MASK_DECOR=menu1+16@0,2000
//MASK_DECOR=menu2+16@0,2000
//MASK_DECOR=menu3+16@0,2000
//XFAIL_TEXT=issue #28: Slint ceils text layout widths where Compose keeps fractional advances
//DENSITIES=1,2
import "../../fonts/Roboto-VariableFont.ttf";
import { Icons, MaterialPalette, MaterialTheme, MaterialWindow, MenuInner, MenuItemKind, MenuVariant } from "@material";

export component TestCase inherits MaterialWindow {
    init => {
        // The scene pins seed #6750A4, tonal-spot, spec2025, light, contrast 0
        // (all the library defaults; restated here so a default change can't
        // silently move the parity baseline).
        MaterialTheme.seed-color = #6750A4;
        MaterialTheme.dark = false;
        MaterialTheme.contrast-level = 0;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.plain-family = "Roboto";
        MaterialTheme.brand-family = "Roboto";
        // Compose builds its scene scheme from the same seed — use the
        // runtime-generated scheme, not the static expressive table.
        MaterialPalette.dynamic = true;
    }

    menu0 := MenuInner {
        x: 16px;
        y: 8px;
        items: [{ text: "Menu item", }, { text: "Edit", icon: Icons.edit, }, { text: "Share", trailing_icon: Icons.arrow_right, }, { text: "Shortcut", trailing_text: "Ctrl+K", }, { text: "Rich item", icon: Icons.edit, trailing_icon: Icons.check, supporting_text: "Secondary text", }, { text: "Disabled", icon: Icons.edit, disabled: true, }, { text: "Hovered", }, { text: "Focused", }];
        item-kind: MenuItemKind.standard;
        variant: MenuVariant.standard;
        // The references cannot render platform shadows (layoutlib
        // deadlocks on `Surface.shadowElevation`).
        cast-shadow: false;
        width: 193px;
        simulate-hover-item: 6;
        focused-item: 7;
    }

    menu1 := MenuInner {
        x: 272px;
        y: 8px;
        items: [{ text: "Option A", selected_icon: Icons.check, selected: true, }, { text: "Option B", }, { text: "With icon", icon: Icons.menu, selected_icon: Icons.check, selected: true, }, { text: "Hovered", }, { text: "Disabled", disabled: true, }];
        item-kind: MenuItemKind.selectable;
        variant: MenuVariant.standard;
        // The references cannot render platform shadows (layoutlib
        // deadlocks on `Surface.shadowElevation`).
        cast-shadow: false;
        width: 125px;
        simulate-hover-item: 3;
    }

    menu2 := MenuInner {
        x: 16px;
        y: 330px;
        items: [{ text: "Checked", selected_icon: Icons.check, checked: true, }, { text: "Swap", icon: Icons.remove, selected_icon: Icons.check, checked: true, }, { text: "Unchecked", icon: Icons.remove, selected_icon: Icons.check, }, { text: "Hovered", }, { text: "Disabled", selected_icon: Icons.check, checked: true, disabled: true, }];
        item-kind: MenuItemKind.checkable;
        variant: MenuVariant.vibrant;
        // The references cannot render platform shadows (layoutlib
        // deadlocks on `Surface.shadowElevation`).
        cast-shadow: false;
        width: 136px;
        simulate-hover-item: 3;
    }

    menu3 := MenuInner {
        x: 272px;
        y: 330px;
        items: [{ text: "Vibrant item", }, { text: "Icons", icon: Icons.edit, trailing_icon: Icons.arrow_right, }, { text: "Supporting", trailing_text: "F2", supporting_text: "Detail line", }, { text: "Disabled", disabled: true, }];
        item-kind: MenuItemKind.standard;
        variant: MenuVariant.vibrant;
        // The references cannot render platform shadows (layoutlib
        // deadlocks on `Surface.shadowElevation`).
        cast-shadow: false;
        width: 133px;
    }

}
