import { StateLayer } from "../../../ui-libraries/material/src/ui/components/state_layer.slint";
import {
    ToggleButton, FilledTonalToggleButton, ElevatedToggleButton, OutlinedToggleButton,
    IconToggleButton, FilledIconToggleButton, FilledTonalIconToggleButton, OutlinedIconToggleButton, ExtendedTouchArea,
    ConnectedButton, ConnectedButtonGroup, VerticalConnectedButtonGroup, ConnectedButtonGroupItem,
    ButtonGroup, ButtonGroupItem, ButtonGroupSelection, SegmentedButton, MaterialPalette,
} from "../../../ui-libraries/material/src/material.slint";

export component TestCase inherits Window {
    width: 300px;
    height: 480px;
    in-out property <bool> controls-enabled: true;
    out property <int> clicks;
    out property <int> requests;
    out property <bool> callback-state-matches: true;
    out property <bool> test: root.clicks == 32 && !root.controls-enabled;
    out property <bool> first-pressed: first.pressed;
    out property <bool> first-checked: first.checked;
    out property <bool> first-focused: first.has-focus;

    VerticalLayout {
        first := ToggleButton { text: "Filled"; enabled: root.controls-enabled; checked-changed(checked) => { root.requests += 1; root.callback-state-matches = root.callback-state-matches && self.checked == checked; } clicked => { root.clicks += 1; } }
        FilledTonalToggleButton { text: "Tonal"; enabled: root.controls-enabled; checked-changed(checked) => { root.requests += 1; root.callback-state-matches = root.callback-state-matches && self.checked == checked; } clicked => { root.clicks += 1; } }
        ElevatedToggleButton { text: "Elevated"; enabled: root.controls-enabled; checked-changed(checked) => { root.requests += 1; root.callback-state-matches = root.callback-state-matches && self.checked == checked; } clicked => { root.clicks += 1; } }
        OutlinedToggleButton { text: "Outlined"; enabled: root.controls-enabled; checked-changed(checked) => { root.requests += 1; root.callback-state-matches = root.callback-state-matches && self.checked == checked; } clicked => { root.clicks += 1; } }
        IconToggleButton { tooltip: "Icon"; enabled: root.controls-enabled; checked-changed(checked) => { root.requests += 1; root.callback-state-matches = root.callback-state-matches && self.checked == checked; } clicked => { root.clicks += 1; } }
        FilledIconToggleButton { tooltip: "Filled icon"; enabled: root.controls-enabled; checked-changed(checked) => { root.requests += 1; root.callback-state-matches = root.callback-state-matches && self.checked == checked; } clicked => { root.clicks += 1; } }
        FilledTonalIconToggleButton { tooltip: "Tonal icon"; enabled: root.controls-enabled; checked-changed(checked) => { root.requests += 1; root.callback-state-matches = root.callback-state-matches && self.checked == checked; } clicked => { root.clicks += 1; } }
        OutlinedIconToggleButton { tooltip: "Outlined icon"; enabled: root.controls-enabled; checked-changed(checked) => { root.requests += 1; root.callback-state-matches = root.callback-state-matches && self.checked == checked; } clicked => { root.clicks += 1; } }
    }
}

export component ControlledCase inherits Window {
    width: 300px;
    height: 480px;
    in-out property <bool> controls-enabled: true;
    in-out property <bool> selected;
    in-out property <bool> accept-requests;
    out property <int> requests;
    out property <int> clicks;
    out property <bool> last-request;
    out property <bool> ordered: true;

    function request(checked: bool) {
        root.ordered = root.ordered && root.requests == root.clicks;
        root.requests += 1;
        root.last-request = checked;
        if root.accept-requests {
            root.selected = checked;
        }
    }

    VerticalLayout {
        ToggleButton {
            text: "Filled";
            enabled: root.controls-enabled;
            checked: root.selected;
            toggle-on-click: false;
            checked-changed(checked) => { root.request(checked); }
            clicked => {
                root.ordered = root.ordered && root.requests == root.clicks + 1;
                root.clicks += 1;
            }
        }
        FilledTonalToggleButton {
            text: "Tonal";
            enabled: root.controls-enabled;
            checked: root.selected;
            toggle-on-click: false;
            checked-changed(checked) => { root.request(checked); }
            clicked => {
                root.ordered = root.ordered && root.requests == root.clicks + 1;
                root.clicks += 1;
            }
        }
        ElevatedToggleButton {
            text: "Elevated";
            enabled: root.controls-enabled;
            checked: root.selected;
            toggle-on-click: false;
            checked-changed(checked) => { root.request(checked); }
            clicked => {
                root.ordered = root.ordered && root.requests == root.clicks + 1;
                root.clicks += 1;
            }
        }
        OutlinedToggleButton {
            text: "Outlined";
            enabled: root.controls-enabled;
            checked: root.selected;
            toggle-on-click: false;
            checked-changed(checked) => { root.request(checked); }
            clicked => {
                root.ordered = root.ordered && root.requests == root.clicks + 1;
                root.clicks += 1;
            }
        }
        IconToggleButton {
            tooltip: "Icon";
            enabled: root.controls-enabled;
            checked: root.selected;
            toggle-on-click: false;
            checked-changed(checked) => { root.request(checked); }
            clicked => {
                root.ordered = root.ordered && root.requests == root.clicks + 1;
                root.clicks += 1;
            }
        }
        FilledIconToggleButton {
            tooltip: "Filled icon";
            enabled: root.controls-enabled;
            checked: root.selected;
            toggle-on-click: false;
            checked-changed(checked) => { root.request(checked); }
            clicked => {
                root.ordered = root.ordered && root.requests == root.clicks + 1;
                root.clicks += 1;
            }
        }
        FilledTonalIconToggleButton {
            tooltip: "Tonal icon";
            enabled: root.controls-enabled;
            checked: root.selected;
            toggle-on-click: false;
            checked-changed(checked) => { root.request(checked); }
            clicked => {
                root.ordered = root.ordered && root.requests == root.clicks + 1;
                root.clicks += 1;
            }
        }
        OutlinedIconToggleButton {
            tooltip: "Outlined icon";
            enabled: root.controls-enabled;
            checked: root.selected;
            toggle-on-click: false;
            checked-changed(checked) => { root.request(checked); }
            clicked => {
                root.ordered = root.ordered && root.requests == root.clicks + 1;
                root.clicks += 1;
            }
        }
    }
}

export component ExtendedCase inherits Window {
    width: 100px;
    height: 100px;
    in-out property <bool> controls-enabled: true;
    out property <bool> active: area.enter-pressed;
    out property <int> clicks;
    area := ExtendedTouchArea {
        enabled: root.controls-enabled;
        clicked => { root.clicks += 1; }
    }
}


export component HorizontalGroupCase inherits Window {
    width: 400px;
    height: 300px;
    in-out property <bool> multiple;
    in-out property <bool> automatic;
    in-out property <bool> accept-requests;
    in-out property <int> selected: 0;
    in-out property <[ConnectedButtonGroupItem]> items: [
        { text: "First" }, { text: "Second" }, { text: "Disabled", disabled: true },
    ];
    out property <int> requests;
    out property <int> requested-index: -1;
    out property <bool> requested-checked;
    out property <int> observed-selection: group.selected-index;
    out property <bool> model-checked: root.items[0].checked;

    group := ConnectedButtonGroup {
        items: root.items;
        multi-select: root.multiple;
        selection-on-click: root.automatic;
        selected-index: root.selected;
        selected-index-changed(index) => {
            root.requests += 1;
            root.requested-index = index;
            if root.accept-requests {
                root.selected = index;
            }
        }
        item-checked-changed(index, checked) => {
            root.requests += 1;
            root.requested-index = index;
            root.requested-checked = checked;
            if root.accept-requests {
                root.items[index].checked = checked;
            }
        }
    }
}

export component VerticalGroupCase inherits Window {
    width: 400px;
    height: 300px;
    in-out property <bool> multiple;
    in-out property <bool> automatic;
    in-out property <bool> accept-requests;
    in-out property <int> selected: 0;
    in-out property <[ConnectedButtonGroupItem]> items: [
        { text: "First" }, { text: "Second" }, { text: "Disabled", disabled: true },
    ];
    out property <int> requests;
    out property <int> requested-index: -1;
    out property <bool> requested-checked;
    out property <int> observed-selection: group.selected-index;
    out property <bool> model-checked: root.items[0].checked;

    group := VerticalConnectedButtonGroup {
        items: root.items;
        multi-select: root.multiple;
        selection-on-click: root.automatic;
        selected-index: root.selected;
        selected-index-changed(index) => {
            root.requests += 1;
            root.requested-index = index;
            if root.accept-requests {
                root.selected = index;
            }
        }
        item-checked-changed(index, checked) => {
            root.requests += 1;
            root.requested-index = index;
            root.requested-checked = checked;
            if root.accept-requests {
                root.items[index].checked = checked;
            }
        }
    }
}


export component StandardGroupCase inherits Window {
    width: 400px;
    height: 200px;
    in-out property <length> available-width: 400px;
    in-out property <bool> multiple;
    in-out property <bool> clickable;
    in-out property <bool> automatic;
    in-out property <bool> accept-requests;
    in-out property <bool> controls-enabled: true;
    in-out property <int> selected: 0;
    in-out property <[ButtonGroupItem]> items: [
        { text: "First" }, { text: "Second" }, { text: "Disabled", enabled: false },
    ];
    out property <int> requests;
    out property <int> activations;
    out property <int> requested-index: -1;
    out property <bool> requested-checked;
    out property <int> observed-selection: group.current-index;
    out property <bool> model-checked: root.items[0].checked;

    group := ButtonGroup {
        width: root.available-width;
        height: 40px;
        items: root.items;
        selection: root.clickable ? ButtonGroupSelection.none : root.multiple ? ButtonGroupSelection.multiple : ButtonGroupSelection.single;
        selection-on-click: root.automatic;
        current-index: root.selected;
        enabled: root.controls-enabled;
        current-index-changed(index) => {
            if root.accept-requests {
                root.selected = index;
            }
        }
        item-checked-changed(index, checked) => {
            root.requests += 1;
            root.requested-index = index;
            root.requested-checked = checked;
            if root.accept-requests && root.multiple {
                root.items[index].checked = checked;
            }
        }
        activated(index) => { root.activations += 1; }
    }
}

export component SegmentedCase inherits Window {
    width: 400px;
    height: 100px;
    in-out property <int> selected;
    in-out property <bool> automatic;
    in-out property <bool> accept-requests;
    in-out property <bool> controls-enabled: true;
    out property <int> requests;
    out property <int> requested-index: -1;
    out property <int> observed-selection: group.current-index;
    group := SegmentedButton {
        enabled: root.controls-enabled;
        items: [{text: "First"}, {text: "Second"}];
        current-index: root.selected;
        selection-on-click: root.automatic;
        index-changed(index) => {
            root.requests += 1;
            root.requested-index = index;
            if root.accept-requests {
                root.selected = index;
            }
        }
    }
}

export component ElevationCase inherits Window {
    width: 200px;
    height: 480px;
    in-out property <int> hover-index: -1;
    in-out property <int> press-index: -1;
    in-out property <bool> controls-enabled: true;
    in-out property <bool> reduced-motion: true;
    in-out property <length> resting-elevation: 2px;
    in-out property <length> pressed-elevation: 6px;
    in-out property <length> hovered-elevation: 8px;
    in-out property <length> focused-elevation: 10px;
    in-out property <length> disabled-elevation: 1px;
    out property <[length]> elevations: [button0.shadow-elevation, button1.shadow-elevation, button2.shadow-elevation, button3.shadow-elevation, button4.shadow-elevation, button5.shadow-elevation, button6.shadow-elevation, button7.shadow-elevation];
    out property <[bool]> focused: [button0.has-focus, button1.has-focus, button2.has-focus, button3.has-focus, button4.has-focus, button5.has-focus, button6.has-focus, button7.has-focus];
    init => { MaterialPalette.reduced-motion = root.reduced-motion; }
    changed reduced-motion => { MaterialPalette.reduced-motion = root.reduced-motion; }
    public function focus-outside() { outside-focus.focus(); }
    VerticalLayout {
        button0 := ToggleButton {
            text: "ToggleButton";
            enabled: root.controls-enabled;
            simulate-hover: root.hover-index == 0;
            simulate-press: root.press-index == 0;
            elevation-default: root.resting-elevation;
            elevation-pressed: root.pressed-elevation;
            elevation-hovered: root.hovered-elevation;
            elevation-focused: root.focused-elevation;
            elevation-disabled: root.disabled-elevation;
        }
        button1 := FilledTonalToggleButton {
            text: "FilledTonalToggleButton";
            enabled: root.controls-enabled;
            simulate-hover: root.hover-index == 1;
            simulate-press: root.press-index == 1;
            elevation-default: root.resting-elevation;
            elevation-pressed: root.pressed-elevation;
            elevation-hovered: root.hovered-elevation;
            elevation-focused: root.focused-elevation;
            elevation-disabled: root.disabled-elevation;
        }
        button2 := ElevatedToggleButton {
            text: "ElevatedToggleButton";
            enabled: root.controls-enabled;
            simulate-hover: root.hover-index == 2;
            simulate-press: root.press-index == 2;
            elevation-default: root.resting-elevation;
            elevation-pressed: root.pressed-elevation;
            elevation-hovered: root.hovered-elevation;
            elevation-focused: root.focused-elevation;
            elevation-disabled: root.disabled-elevation;
        }
        button3 := OutlinedToggleButton {
            text: "OutlinedToggleButton";
            enabled: root.controls-enabled;
            simulate-hover: root.hover-index == 3;
            simulate-press: root.press-index == 3;
            elevation-default: root.resting-elevation;
            elevation-pressed: root.pressed-elevation;
            elevation-hovered: root.hovered-elevation;
            elevation-focused: root.focused-elevation;
            elevation-disabled: root.disabled-elevation;
        }
        button4 := IconToggleButton {
            tooltip: "IconToggleButton";
            enabled: root.controls-enabled;
            simulate-hover: root.hover-index == 4;
            simulate-press: root.press-index == 4;
            elevation-default: root.resting-elevation;
            elevation-pressed: root.pressed-elevation;
            elevation-hovered: root.hovered-elevation;
            elevation-focused: root.focused-elevation;
            elevation-disabled: root.disabled-elevation;
        }
        button5 := FilledIconToggleButton {
            tooltip: "FilledIconToggleButton";
            enabled: root.controls-enabled;
            simulate-hover: root.hover-index == 5;
            simulate-press: root.press-index == 5;
            elevation-default: root.resting-elevation;
            elevation-pressed: root.pressed-elevation;
            elevation-hovered: root.hovered-elevation;
            elevation-focused: root.focused-elevation;
            elevation-disabled: root.disabled-elevation;
        }
        button6 := FilledTonalIconToggleButton {
            tooltip: "FilledTonalIconToggleButton";
            enabled: root.controls-enabled;
            simulate-hover: root.hover-index == 6;
            simulate-press: root.press-index == 6;
            elevation-default: root.resting-elevation;
            elevation-pressed: root.pressed-elevation;
            elevation-hovered: root.hovered-elevation;
            elevation-focused: root.focused-elevation;
            elevation-disabled: root.disabled-elevation;
        }
        button7 := OutlinedIconToggleButton {
            tooltip: "OutlinedIconToggleButton";
            enabled: root.controls-enabled;
            simulate-hover: root.hover-index == 7;
            simulate-press: root.press-index == 7;
            elevation-default: root.resting-elevation;
            elevation-pressed: root.pressed-elevation;
            elevation-hovered: root.hovered-elevation;
            elevation-focused: root.focused-elevation;
            elevation-disabled: root.disabled-elevation;
        }
    }
    outside-focus := FocusScope { width: 0px; height: 0px; }
}

export component ShapeCase inherits Window {
    width: 200px;
    height: 480px;
    out property <int> clicks;
    in-out property <bool> controls-enabled: true;
    in-out property <bool> custom-outline: true;
    out property <bool> any-pressed: first.pressed || tonal.pressed || elevated.pressed || outlined.pressed || icon.pressed || filled-icon.pressed || tonal-icon.pressed || outlined-icon.pressed;
    property <shape> no-outline;
    property <shape> diamond: root.custom-outline ? Shapes.path("M0.5 0L1 0.5L0.5 1L0 0.5Z") : root.no-outline;

    VerticalLayout {
        first := ToggleButton { enabled: root.controls-enabled; text: "Filled"; resting-shape: root.diamond; clicked => { root.clicks += 1; } }
        tonal := FilledTonalToggleButton { enabled: root.controls-enabled; text: "Tonal"; resting-shape: root.diamond; clicked => { root.clicks += 1; } }
        elevated := ElevatedToggleButton { enabled: root.controls-enabled; text: "Elevated"; resting-shape: root.diamond; clicked => { root.clicks += 1; } }
        outlined := OutlinedToggleButton { enabled: root.controls-enabled; text: "Outlined"; resting-shape: root.diamond; clicked => { root.clicks += 1; } }
        icon := IconToggleButton { enabled: root.controls-enabled; tooltip: "Icon"; resting-shape: root.diamond; clicked => { root.clicks += 1; } }
        filled-icon := FilledIconToggleButton { enabled: root.controls-enabled; tooltip: "Filled icon"; resting-shape: root.diamond; clicked => { root.clicks += 1; } }
        tonal-icon := FilledTonalIconToggleButton { enabled: root.controls-enabled; tooltip: "Tonal icon"; resting-shape: root.diamond; clicked => { root.clicks += 1; } }
        outlined-icon := OutlinedIconToggleButton { enabled: root.controls-enabled; tooltip: "Outlined icon"; resting-shape: root.diamond; clicked => { root.clicks += 1; } }
    }
}

export component StateLayerCase inherits Window {
    width: 100px;
    height: 40px;
    in-out property <bool> hover;
    in-out property <bool> focused;
    in-out property <bool> drag;
    in-out property <bool> press;
    in-out property <bool> ring;
    in-out property <bool> control-enabled: true;
    in-out property <bool> reduced-motion;
    init => { MaterialPalette.reduced-motion = root.reduced-motion; }
    changed reduced-motion => { MaterialPalette.reduced-motion = root.reduced-motion; }
    out property <float> layer-opacity: layer.state_layer_opacity;
    layer := StateLayer {
        width: 100%;
        height: 100%;
        enabled: root.control-enabled;
        has_hover: root.hover;
        has_focus: root.focused;
        dragged: root.drag;
        pressed: root.press;
        focus_ring: root.ring;
        display_background: false;
        background: black;
    }
}
