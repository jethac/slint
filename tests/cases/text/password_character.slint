export component TestCase inherits Window {
    in property <string> mask <=> text-input.password-character;
    out property text-width <=> text-input.min-width;
    out property <Point> cursor-position;

    forward-focus: text-input;

    text-input := TextInput {
        input-type: InputType.password;
        text: "iWiWi";
        cursor-position-changed(position) => {
            root.cursor-position = position;
        }
    }
}


/*
The masked width follows the mask glyph, not the held text: the same five
characters measure differently under a narrow (`j`) and a wide (`W`) mask.
```rust
let instance = TestCase::new().unwrap();

instance.set_mask("j".into());
let narrow_width = instance.get_text_width();

instance.set_mask("W".into());
let wide_width = instance.get_text_width();

assert!(wide_width > narrow_width, "{wide_width} should be greater than {narrow_width}");
```

Every masked character advances the same amount, so the cursor steps by the
mask glyph's advance — regardless of which character the text holds there.
```rust
use slint::platform::Key;
use slint::private_unstable_api::re_exports::ApproxEq;

let instance = TestCase::new().unwrap();
instance.set_mask("x".into());

assert_eq!(instance.get_cursor_position().x, 0., "Cursor should be at 0");
slint_testing::send_key_combo(&instance, [Key::RightArrow]);
let step: f32 = instance.get_cursor_position().x;
assert!(step > 0.);
for i in 2..5 {
    slint_testing::send_key_combo(&instance, [Key::RightArrow]);
    let cursor = instance.get_cursor_position().x;
    let expected = i as f32 * step;
    assert!(cursor.approx_eq_eps(&expected, &0.1), "After {i} steps cursor should be at {expected}, was {cursor}");
}
```

An empty `password-character` falls back to the built-in bullet.
```rust
let instance = TestCase::new().unwrap();

instance.set_mask("".into());
let fallback_width = instance.get_text_width();

instance.set_mask("\u{25cf}".into());
assert_eq!(instance.get_text_width(), fallback_width);
```
*/
