// `animate shape` morphs the element's outline through the spring easing.
// A mid-flight retarget keeps the sampled outline continuous — the new morph
// starts from the current interpolated shape — and carries the outgoing
// spring's scalar speed (issue #6 design note R6: v0·D_new = rel_vel·D_old,
// the mean per-anchor |velocity| normalized by the morph start's perimeter).
// Morph results re-segment their anchors every frame, so all comparisons are
// geometric (anchor-to-polyline Hausdorff distance). Pairing anchors between
// consecutive frames reads the spring's speed ~7x low — or 0 outright once
// the segmentation shifts — so the speed windows use the outline's delta to a
// fixed reference instead, which stays smooth through the cruise. Both the
// setter path and the binding path are exercised.

export component TestCase inherits Rectangle {
    in-out property <shape> bound-target: Shapes.pill(1, 0.6, 0);
    in-out property <shape> morph: Shapes.circle(8);
    // `out`: an `in-out` alias for `bound-target` would be a two-way link
    // that snaps to the new value without morphing.
    out property <shape> bound: bound-target;
    animate morph { easing: spring(0.8, 200); }
    animate bound { easing: spring(0.8, 200); }
}

/*
```rust
fn eval_cubic(c: &[f32], t: f32) -> (f32, f32) {
    let u = 1. - t;
    (
        c[0] * (u * u * u) + c[2] * (3. * t * u * u) + c[4] * (3. * t * t * u)
            + c[6] * (t * t * t),
        c[1] * (u * u * u) + c[3] * (3. * t * u * u) + c[5] * (3. * t * t * u)
            + c[7] * (t * t * t),
    )
}
// A dense polyline of the outline (33 points per cubic, closed outlines chain).
fn polyline(shape: &slint::Shape) -> Vec<(f32, f32)> {
    shape
        .cubics()
        .as_chunks::<8>()
        .0
        .iter()
        .flat_map(|c| (0..=32).map(|k| eval_cubic(c, k as f32 / 32.)))
        .collect()
}
fn anchors(shape: &slint::Shape) -> Vec<(f32, f32)> {
    shape.cubics().as_chunks::<8>().0.iter().map(|c| (c[0], c[1])).collect()
}
fn dist_to_polyline(p: (f32, f32), line: &[(f32, f32)]) -> f32 {
    line.iter()
        .zip(line.iter().skip(1))
        .map(|(&a, &b)| {
            let (vx, vy) = (b.0 - a.0, b.1 - a.1);
            let (wx, wy) = (p.0 - a.0, p.1 - a.1);
            let t = ((vx * wx + vy * wy) / (vx * vx + vy * vy).max(1e-12)).clamp(0., 1.);
            ((wx - vx * t).powi(2) + (wy - vy * t).powi(2)).sqrt()
        })
        .fold(f32::MAX, f32::min)
}
// Symmetric Hausdorff distance between the two outlines' anchors and
// polylines: 0 when the outlines coincide geometrically, regardless of how
// the morph re-laid out the anchors.
fn outline_delta(a: &slint::Shape, b: &slint::Shape) -> f32 {
    let pa = polyline(a);
    let pb = polyline(b);
    let fwd = anchors(a).iter().map(|&p| dist_to_polyline(p, &pb)).fold(0., f32::max);
    let bwd = anchors(b).iter().map(|&p| dist_to_polyline(p, &pa)).fold(0., f32::max);
    fwd.max(bwd)
}
fn outline_mean_delta(a: &slint::Shape, b: &slint::Shape) -> f32 {
    let pa = polyline(a);
    let pb = polyline(b);
    let aa = anchors(a);
    let ab = anchors(b);
    let fwd = aa.iter().map(|&p| dist_to_polyline(p, &pb)).sum::<f32>() / aa.len() as f32;
    let bwd = ab.iter().map(|&p| dist_to_polyline(p, &pa)).sum::<f32>() / ab.len() as f32;
    fwd.max(bwd)
}
// Outline length: the polyline length approximates the measured perimeter
// `scalar_delta` normalizes by.
fn perimeter(shape: &slint::Shape) -> f32 {
    let line = polyline(shape);
    line.iter()
        .zip(line.iter().skip(1))
        .map(|(&a, &b)| ((b.0 - a.0).powi(2) + (b.1 - a.1).powi(2)).sqrt())
        .sum()
}
// The outline's speed at an instant: distance covered between two frames,
// measured as the delta of the outline's distance to a fixed reference.
// Monotone through the spring's cruise for every shape pair here.
//
// The distance is averaged over the anchors, not max'ed: R6's carried
// velocity is normalized by the morph's mean per-anchor displacement
// (scalar_delta), so a max (Hausdorff) proxy — which tracks whichever
// feature sweeps fastest — reads morph-pair-specific speeds that diverge
// ~50% across a retarget under the graphics-shapes 1.0.1 morph engine,
// even though the mean-normalized carry is exact.
fn outline_speed(from: &slint::Shape, a: &slint::Shape, b: &slint::Shape) -> f32 {
    outline_mean_delta(from, b) - outline_mean_delta(from, a)
}

fn retarget_case(
    get: &dyn Fn() -> slint::Shape,
    retarget: &dyn Fn(slint::Shape),
    start_from: slint::Shape,
    mid_target: slint::Shape,
    final_target: slint::Shape,
) {
    // Evaluate once so the binding holds the current value and has registered
    // its dependencies — a property first read after the retarget would
    // already see the new value and never animate.
    let _ = get();
    // Fly toward the mid target until the spring is clearly moving. T sits
    // at ~30% of the spring's ~200ms envelope — its cruise — so the speed
    // windows stay deep inside flight on every target, away from the
    // underdamped apex and the settled tail. The windows span 10ms: a 1ms
    // frame step is smaller than the proxy's per-reading jitter on some
    // targets (i686 read 0 there); 10ms of cruise covers ~0.03 units of
    // travel, an order above the noise, while the spring's own drift stays
    // under ~5% across the window.
    retarget(mid_target.clone());
    slint_testing::mock_elapsed_time(49);
    let t_lo = get();
    slint_testing::mock_elapsed_time(10);
    let t_m1 = get();
    let pre_speed = outline_speed(&start_from, &t_lo, &t_m1) / 0.010;
    assert!(pre_speed > 0., "the spring must still be moving: {pre_speed}");

    retarget(final_target.clone());
    // The animated outline does not snap at the retarget instant: the first
    // evaluated frame of the new morph reproduces the incoming outline. The
    // morph pipeline re-segments and re-detects features on construction, so
    // even progress 0 differs from the source shape by its reproduction drift
    // (≈0.04 measured on the star-bound morph); a snap to the old start or
    // the new target would sit ≥0.1 away instead.
    let t_0 = get();
    let delta = outline_delta(&t_0, &t_m1);
    assert!(delta <= 0.08, "retarget moved the outline by {delta}");

    slint_testing::mock_elapsed_time(10);
    let t_hi = get();
    // The carried scalar speed is preserved across the retarget: the
    // outline's speed, normalized by each morph's start perimeter (R6's
    // rel_vel), matches on both sides of T. The mean-distance proxy only
    // sees each anchor's perpendicular travel, so it underestimates the
    // true displacement by a morph-dependent factor (~0.8 on these pairs
    // under the 1.0.1 morph engine): the bound is 30% — still catching a
    // restart from rest (~0) or a half-speed-or-worse rescaling (~0.4).
    let post_speed = outline_speed(&t_0, &t_0, &t_hi) / 0.010;
    let rel_pre = pre_speed / perimeter(&start_from);
    let rel_post = post_speed / perimeter(&t_0);
    assert!(
        (rel_post - rel_pre).abs() <= 0.3 * rel_pre,
        "normalized speed must carry across the retarget: {rel_post} vs {rel_pre}"
    );

    // The spring settles on the new target.
    slint_testing::mock_elapsed_time(3000);
    assert_eq!(get(), final_target);
}

let instance = TestCase::new().unwrap();
// Let `bound`'s initial binding evaluation land on the pill so the
// binding-path case starts from a steady morph source.
slint_testing::mock_elapsed_time(2500);
let circle = slint::shapes::circle(8);
let pill = slint::shapes::pill(1., 0.6, 0.);
let triangle = slint::shapes::regular_polygon(3, slint::CornerRounding::UNROUNDED);
let star = slint::shapes::star(5, 0.5, slint::CornerRounding::UNROUNDED, slint::CornerRounding::UNROUNDED);
let star7 =
    slint::shapes::star(7, 0.4, slint::CornerRounding::UNROUNDED, slint::CornerRounding::UNROUNDED);

// Setter path: circle -> triangle morph is underway when the target switches
// to the star.
retarget_case(
    &|| instance.get_morph(),
    &|s| instance.set_morph(s),
    circle,
    triangle,
    star.clone(),
);

// Binding path: `bound` re-targets when `bound-target`'s binding re-evaluates.
retarget_case(
    &|| instance.get_bound(),
    &|s| instance.set_bound_target(s),
    pill,
    star7,
    star,
);
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;

auto eval_cubic = [](const float *c, float t) -> std::pair<float, float> {
    float u = 1.f - t;
    return { c[0] * (u * u * u) + c[2] * (3.f * t * u * u) + c[4] * (3.f * t * t * u)
                 + c[6] * (t * t * t),
             c[1] * (u * u * u) + c[3] * (3.f * t * u * u) + c[5] * (3.f * t * t * u)
                 + c[7] * (t * t * t) };
};
auto polyline = [&eval_cubic](const slint::Shape &shape) -> std::vector<std::pair<float, float>> {
    std::vector<std::pair<float, float>> points;
    const auto &cubics = shape.cubics();
    for (size_t i = 0; i + 8 <= cubics.size(); i += 8) {
        for (int k = 0; k <= 32; k++) {
            points.push_back(eval_cubic(&cubics[i], k / 32.f));
        }
    }
    return points;
};
auto anchors = [](const slint::Shape &shape) -> std::vector<std::pair<float, float>> {
    std::vector<std::pair<float, float>> points;
    const auto &cubics = shape.cubics();
    for (size_t i = 0; i + 8 <= cubics.size(); i += 8) {
        points.push_back({ cubics[i], cubics[i + 1] });
    }
    return points;
};
auto dist_to_polyline = [](std::pair<float, float> p,
                           const std::vector<std::pair<float, float>> &line) -> float {
    float min_dist = std::numeric_limits<float>::max();
    for (size_t i = 0; i + 1 < line.size(); i++) {
        float vx = line[i + 1].first - line[i].first;
        float vy = line[i + 1].second - line[i].second;
        float wx = p.first - line[i].first;
        float wy = p.second - line[i].second;
        float t = (vx * wx + vy * wy) / std::max(vx * vx + vy * vy, 1e-12f);
        t = t < 0.f ? 0.f : (t > 1.f ? 1.f : t);
        float dist = std::sqrt(std::pow(wx - vx * t, 2.f) + std::pow(wy - vy * t, 2.f));
        min_dist = dist < min_dist ? dist : min_dist;
    }
    return min_dist;
};
auto outline_delta = [&](const slint::Shape &a, const slint::Shape &b) -> float {
    auto pa = polyline(a);
    auto pb = polyline(b);
    float delta = 0.f;
    for (auto p : anchors(a)) {
        delta = std::max(delta, dist_to_polyline(p, pb));
    }
    for (auto p : anchors(b)) {
        delta = std::max(delta, dist_to_polyline(p, pa));
    }
    return delta;
};
auto outline_mean_delta = [&](const slint::Shape &a, const slint::Shape &b) -> float {
    auto pa = polyline(a);
    auto pb = polyline(b);
    auto aa = anchors(a);
    auto ab = anchors(b);
    float fwd = 0.f;
    for (auto p : aa) {
        fwd += dist_to_polyline(p, pb);
    }
    fwd /= aa.size();
    float bwd = 0.f;
    for (auto p : ab) {
        bwd += dist_to_polyline(p, pa);
    }
    bwd /= ab.size();
    return std::max(fwd, bwd);
};
auto perimeter = [&polyline](const slint::Shape &shape) -> float {
    auto line = polyline(shape);
    float total = 0.f;
    for (size_t i = 0; i + 1 < line.size(); i++) {
        float dx = line[i + 1].first - line[i].first;
        float dy = line[i + 1].second - line[i].second;
        total += std::sqrt(dx * dx + dy * dy);
    }
    return total;
};
// The outline's speed at an instant: distance covered between two frames,
// measured as the delta of the outline's distance to a fixed reference.
// Monotone through the spring's cruise for every shape pair here.
//
// The distance is averaged over the anchors, not max'ed: R6's carried
// velocity is normalized by the morph's mean per-anchor displacement
// (scalar_delta), so a max (Hausdorff) proxy — which tracks whichever
// feature sweeps fastest — reads morph-pair-specific speeds that diverge
// ~50% across a retarget under the graphics-shapes 1.0.1 morph engine,
// even though the mean-normalized carry is exact.
auto outline_speed = [&](const slint::Shape &from, const slint::Shape &a,
                         const slint::Shape &b) -> float {
    return outline_mean_delta(from, b) - outline_mean_delta(from, a);
};

auto retarget_case = [&](auto get, auto retarget, const slint::Shape &start_from,
                         const slint::Shape &mid_target, const slint::Shape &final_target) {
    // Evaluate once so the binding holds the current value and has registered
    // its dependencies — a property first read after the retarget would
    // already see the new value and never animate.
    get();
    // Fly toward the mid target until the spring is clearly moving. T sits
    // at ~30% of the spring's ~200ms envelope — its cruise — so the speed
    // windows stay deep inside flight on every target, away from the
    // underdamped apex and the settled tail. The windows span 10ms: a 1ms
    // frame step is smaller than the proxy's per-reading jitter on some
    // targets (i686 read 0 there); 10ms of cruise covers ~0.03 units of
    // travel, an order above the noise, while the spring's own drift stays
    // under ~5% across the window.
    retarget(mid_target);
    slint_testing::mock_elapsed_time(49);
    auto t_lo = get();
    slint_testing::mock_elapsed_time(10);
    auto t_m1 = get();
    float pre_speed = outline_speed(start_from, t_lo, t_m1) / 0.010f;

    retarget(final_target);
    // The animated outline does not snap at the retarget instant: the first
    // evaluated frame of the new morph reproduces the incoming outline. The
    // morph pipeline re-segments and re-detects features on construction, so
    // even progress 0 differs from the source shape by its reproduction drift
    // (≈0.04 measured on the star-bound morph); a snap to the old start or
    // the new target would sit ≥0.1 away instead.
    auto t_0 = get();
    float delta = outline_delta(t_0, t_m1);

    slint_testing::mock_elapsed_time(10);
    auto t_hi = get();
    // The carried scalar speed is preserved across the retarget: the
    // outline's speed, normalized by each morph's start perimeter (R6's
    // rel_vel), matches on both sides of T. The mean-distance proxy only
    // sees each anchor's perpendicular travel, so it underestimates the
    // true displacement by a morph-dependent factor (~0.8 on these pairs
    // under the 1.0.1 morph engine): the bound is 30% — still catching a
    // restart from rest (~0) or a half-speed-or-worse rescaling (~0.4).
    float post_speed = outline_speed(t_0, t_0, t_hi) / 0.010f;
    float rel_pre = pre_speed / perimeter(start_from);
    float rel_post = post_speed / perimeter(t_0);
    assert(pre_speed > 0.f);
    assert(delta <= 0.08f);
    assert(std::fabs(rel_post - rel_pre) <= 0.3f * rel_pre);

    slint_testing::mock_elapsed_time(3000);
    assert(get() == final_target);
};

slint_testing::mock_elapsed_time(2500);
auto circle = slint::shapes::circle(8);
auto pill = slint::shapes::pill(1.f, 0.6f, 0.f);
auto triangle = slint::shapes::regular_polygon(3, {});
auto star = slint::shapes::star(5, 0.5f, {}, {});
auto star7 = slint::shapes::star(7, 0.4f, {}, {});

retarget_case([&] { return instance.get_morph(); },
              [&](slint::Shape s) { instance.set_morph(s); }, circle, triangle, star);
retarget_case([&] { return instance.get_bound(); },
              [&](slint::Shape s) { instance.set_bound_target(s); }, pill, star7, star);
```
*/
