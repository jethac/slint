// `release-velocity` reports the pointer's velocity at release in logical
// px/sec, written before `swiped` runs so callbacks can pick the target of a
// follow-up animation.

export component TestCase inherits Window {
    width: 300phx;
    height: 300phx;

    sgr := SwipeGestureHandler {
        handle-swipe-down: true;
        handle-swipe-left: true;

        swiped => {
            root.swiped_fired = true;
            root.velocity_at_swiped_x = self.release-velocity.x / 1px;
            root.velocity_at_swiped_y = self.release-velocity.y / 1px;
        }

        TouchArea { }
    }

    out property <bool> swiped_fired;
    out property <float> velocity_at_swiped_x;
    out property <float> velocity_at_swiped_y;
    out property <float> velocity_x: sgr.release-velocity.x / 1px;
    out property <float> velocity_y: sgr.release-velocity.y / 1px;
    out property <bool> test: true;
}

/*
```rust
use slint::platform::WindowEvent;
use slint_testing::{InternalEvent, LogicalPoint, TouchPhase};
let instance = TestCase::new().unwrap();
let window = instance.window();
window.dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 3, position: LogicalPoint::new(175.0, 175.0), phase: TouchPhase::Started }));
window.dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 3, position: LogicalPoint::new(176.0, 176.0), phase: TouchPhase::Moved }));
slint_testing::mock_elapsed_time(100);
window.dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 3, position: LogicalPoint::new(100.0, 250.0), phase: TouchPhase::Moved }));
slint_testing::mock_elapsed_time(1);
window.dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 3, position: LogicalPoint::new(100.0, 250.0), phase: TouchPhase::Ended }));
assert!(instance.get_swiped_fired(), "swiped should fire after a recognized swipe");
// velocity = last delta / dt: (-76, 74) px in 100ms → (-760, 740) px/s
assert!(instance.get_velocity_x() < -600. && instance.get_velocity_x() > -900., "velocity_x: {}", instance.get_velocity_x());
assert!(instance.get_velocity_y() > 600. && instance.get_velocity_y() < 900., "velocity_y: {}", instance.get_velocity_y());
assert_eq!(instance.get_velocity_x(), instance.get_velocity_at_swiped_x());
assert_eq!(instance.get_velocity_y(), instance.get_velocity_at_swiped_y());

// A release long after the last move reports a zero velocity.
let instance = TestCase::new().unwrap();
let window = instance.window();
window.dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 3, position: LogicalPoint::new(175.0, 175.0), phase: TouchPhase::Started }));
window.dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 3, position: LogicalPoint::new(176.0, 176.0), phase: TouchPhase::Moved }));
slint_testing::mock_elapsed_time(100);
window.dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 3, position: LogicalPoint::new(100.0, 250.0), phase: TouchPhase::Moved }));
slint_testing::mock_elapsed_time(500);
window.dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 3, position: LogicalPoint::new(100.0, 250.0), phase: TouchPhase::Ended }));
assert!(instance.get_swiped_fired());
assert_eq!(instance.get_velocity_x(), 0.);
assert_eq!(instance.get_velocity_y(), 0.);
```
*/
