// An element of a popup that is created in an `if` or `for` and takes the focus in its
// `init` keeps it: the popup's contents are instantiated as it is shown, and the focus
// they take must not be treated as the parent window's focus. On close, the focus goes
// back to what had it before the popup opened.

component GrabInput inherits TextInput {
    in property <bool> grab;
    init => {
        if (root.grab) {
            self.focus();
        }
    }
}

export component TestCase inherits Window {
    width: 500px;
    height: 500px;

    in property <[string]> fields: ["a", "b"];
    in property <bool> use-if;
    in property <bool> show-conditional: true;
    out property <string> outer-text;
    out property <string> first-text;
    out property <string> second-text;
    out property <string> conditional-text;
    out property <string> sibling-text;
    out property <string> popup-scope-keys;
    callback open-popup();
    callback close-popup();
    callback open-sibling-popup();
    callback close-sibling-popup();
    open-popup => {
        popup.show();
    }
    close-popup => {
        popup.close();
    }
    open-sibling-popup => {
        sibling-popup.show();
    }
    close-sibling-popup => {
        sibling-popup.close();
    }

    outer := TextInput {
        width: 100%;
        height: 30px;
        edited => {
            root.outer-text = self.text;
        }
    }

    init => {
        outer.focus();
    }

    popup := PopupWindow {
        x: 0px;
        y: 100px;
        width: 300px;
        height: 200px;
        close-policy: no-auto-close;
        FocusScope {
            key-pressed(event) => {
                root.popup-scope-keys += event.text;
                accept
            }
            VerticalLayout {
                if !root.use-if: VerticalLayout {
                    for name[index] in root.fields: GrabInput {
                        height: 30px;
                        grab: index == 0;
                        edited => {
                            if (index == 0) {
                                root.first-text = self.text;
                            } else {
                                root.second-text = self.text;
                            }
                        }
                    }
                }
                if root.use-if && root.show-conditional: GrabInput {
                    height: 30px;
                    grab: true;
                    edited => {
                        root.conditional-text = self.text;
                    }
                }
            }
        }
    }

    sibling-popup := PopupWindow {
        x: 10px;
        y: 120px;
        width: 300px;
        height: 100px;
        close-policy: no-auto-close;
        if true: GrabInput {
            height: 30px;
            grab: true;
            edited => {
                root.sibling-text = self.text;
            }
        }
    }
}

/*
```rust
let instance = TestCase::new().unwrap();
slint_testing::send_keyboard_string_sequence(&instance, "o");
assert_eq!(instance.get_outer_text(), "o");

// A `for`: the first field took the focus as the popup opened.
instance.invoke_open_popup();
slint_testing::send_keyboard_string_sequence(&instance, "x");
assert_eq!(instance.get_first_text(), "x");
assert_eq!(instance.get_second_text(), "");
assert_eq!(instance.get_outer_text(), "o");

// Closing gives the focus back to what had it before.
instance.invoke_close_popup();
slint_testing::send_keyboard_string_sequence(&instance, "p");
assert_eq!(instance.get_outer_text(), "op");

// Again, with the model replaced before the popup opens (new instances).
instance.set_fields(std::rc::Rc::new(slint::VecModel::from(vec![slint::SharedString::from("c"), "d".into()])).into());
instance.invoke_open_popup();
slint_testing::send_keyboard_string_sequence(&instance, "y");
assert_eq!(instance.get_first_text(), "y");
assert_eq!(instance.get_outer_text(), "op");
instance.invoke_close_popup();

// An `if` inside a FocusScope: removing the focused item still routes keys to the popup's FocusScope.
instance.set_use_if(true);
instance.invoke_open_popup();
slint_testing::send_keyboard_string_sequence(&instance, "z");
assert_eq!(instance.get_conditional_text(), "z");
assert_eq!(instance.get_outer_text(), "op");
instance.set_show_conditional(false);
slint_testing::send_keyboard_string_sequence(&instance, "k");
assert_eq!(instance.get_popup_scope_keys(), "k");
instance.invoke_close_popup();
slint_testing::send_keyboard_string_sequence(&instance, "q");
assert_eq!(instance.get_outer_text(), "opq");

// Opening a sibling popup replaces the open popup without clobbering the new popup's `init` focus,
// and closing the sibling still restores focus to `outer`.
instance.set_show_conditional(true);
instance.invoke_open_popup();
instance.invoke_open_sibling_popup();
slint_testing::send_keyboard_string_sequence(&instance, "s");
assert_eq!(instance.get_sibling_text(), "s");
assert_eq!(instance.get_outer_text(), "opq");
instance.invoke_close_sibling_popup();
slint_testing::send_keyboard_string_sequence(&instance, "r");
assert_eq!(instance.get_outer_text(), "opqr");

// Native (top-level) popup keeps the focus set during instantiation on its own window,
// and restores focus to `outer` on close.
instance.set_use_if(false);
slint_testing::access_testing_window(instance.window(), |w| w.use_native_popup(true));
instance.invoke_open_popup();
{
    let inner = slint_testing::WindowInner::from_pub(instance.window());
    let popups = inner.active_popups();
    assert_eq!(popups.len(), 1);
    let slint_testing::PopupWindowLocation::TopLevel(popup_adapter) = &popups[0].location else {
        panic!("expected TopLevel popup");
    };
    let text = slint::SharedString::from("w");
    popup_adapter.window().dispatch_event(slint::platform::WindowEvent::KeyPressed { text: text.clone() });
    popup_adapter.window().dispatch_event(slint::platform::WindowEvent::KeyReleased { text });
}
assert_eq!(instance.get_first_text(), "w");
assert_eq!(instance.get_outer_text(), "opqr");
instance.invoke_close_popup();
slint_testing::send_keyboard_string_sequence(&instance, "t");
assert_eq!(instance.get_outer_text(), "opqrt");
```
*/
