auto handle = TestCase::create();
const TestCase &instance = *handle;
instance.set_critical(100.0);
instance.set_underdamped(100.0);
instance.set_overdamped(100.0);
instance.set_launched(0.0);

slint_testing::mock_elapsed_time(250);
assert(std::abs(instance.get_critical() - 95.51) < 0.05);
assert(instance.get_critical() < 100.0);
assert(instance.get_overdamped() < instance.get_critical());
assert(std::abs(instance.get_launched() - 0.96) < 0.05);

slint_testing::mock_elapsed_time(250);
assert(std::abs(instance.get_critical() - 99.94) < 0.05);
assert(instance.get_underdamped() > 95.0);
assert(std::abs(instance.get_launched() - 0.01) < 0.05);

