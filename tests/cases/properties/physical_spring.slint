// Physical `spring(damping-ratio, stiffness)` animations follow the Compose
// spring math: critically damped settles without overshoot, underdamped
// overshoots and returns, and a retargeted spring carries its velocity.

export component TestCase inherits Rectangle {
    // ζ = 1, k = 380 (M3 default effects): approaches 100 monotonically.
    in-out property <float> critical: 0;
    animate critical { easing: spring(1.0, 380); }

    // ζ = 0.6, k = 800 (M3 expressive fast spatial): overshoots past 100.
    in-out property <float> underdamped: 0;
    animate underdamped { easing: spring(0.6, 800); }

    // ζ = 2, k = 1600: overdamped — slower than critical, never overshoots.
    in-out property <float> overdamped: 0;
    animate overdamped { easing: spring(2.0, 1600); }

    // initial-velocity launches the spring already moving; it overshoots
    // before settling even though it is critically damped.
    in-out property <float> launched: 0;
    animate launched {
        easing: spring(1.0, 380);
        initial-velocity: 500;
    }
}

/*
```rust
fn assert_approx(value: f32, expected: f32) {
    assert!((value - expected).abs() < 0.05, "Expected {value} to be close to {expected}");
}

let instance = TestCase::new().unwrap();
instance.set_critical(100.0);
instance.set_underdamped(100.0);
instance.set_overdamped(100.0);
instance.set_launched(0.0);

slint_testing::mock_elapsed_time(250);
// Critically damped, 250 ms in: 95.5% of the way (Compose spring math).
assert_approx(instance.get_critical(), 95.51);
assert!(instance.get_critical() < 100.0);
// Overdamped is slower than critically damped.
assert!(instance.get_overdamped() < instance.get_critical());
// initial-velocity 500 px/s overshoots the target: at 250 ms it sits ~0.96 above
// 0 on its way back down (peaked at ~5.47 around 125 ms).
assert_approx(instance.get_launched(), 0.96);

slint_testing::mock_elapsed_time(250);
assert_approx(instance.get_critical(), 99.94);
// ζ = 0.6 crossed the target (~109 at 150 ms) and is coming back.
assert!(instance.get_underdamped() > 95.0);
assert_approx(instance.get_launched(), 0.01);

slint_testing::mock_elapsed_time(500);
assert_approx(instance.get_critical(), 100.0);
assert_approx(instance.get_underdamped(), 100.0);
assert_approx(instance.get_overdamped(), 100.0);
assert_approx(instance.get_launched(), 0.0);
```

