instance.set_critical(100.0);
instance.set_underdamped(100.0);
instance.set_overdamped(100.0);
instance.set_launched(0.0);

slint_testing::mock_elapsed_time(25);
assert(std::abs(instance.get_critical() - 26.42) < 0.05);
assert(std::abs(instance.get_overdamped() - 17.77) < 0.05);
assert(instance.get_overdamped() < instance.get_critical());
assert(std::abs(instance.get_launched() - 4.60) < 0.05);

slint_testing::mock_elapsed_time(225);
assert(std::abs(instance.get_critical() - 99.95) < 0.05);
assert(std::abs(instance.get_underdamped() - 99.47) < 0.05);
assert(instance.get_underdamped() < 100.0);
