import { MaterialPalette } from "../styling/material_palette.slint";
import { ElevationTokens } from "../styling/generated/material_elevation_tokens.slint";
import { MaterialCornerRadii } from "./state_layer.slint";

export component Elevation {
    in property <brush> background;
    in property <length> border_radius;
    /// Per-corner radii; used instead of `border_radius` when
    /// `shaped_corners`. The caster rectangle carries them, so the shadow
    /// outline follows the morph too.
    in property <MaterialCornerRadii> corners;
    in property <bool> shaped_corners;
    in property <int> level;
    /// The animation spec for `shadow_height` changes — the default is the
    // `animateElevation` tween; the active motion scheme's springs can be
    // passed where upstream uses them (e.g. lists use `FastSpatial`).
    in property <easing> shadow_easing: cubic-bezier(0.4, 0, 0.2, 1);
    // `shape` is an element-level property: `Elevation { shape: X }` binds it
    // on this component's root element and `root.shape` forwards it to the
    // caster. When unset it stays empty and the caster uses `border_radius`.
    // `shape-fit` defaults to `normalized`: the MaterialShapes coordinate
    // space is the (0,0)-(1,1) square Compose's `RoundedPolygon.toShape()`
    // maps onto the element — `fill` would stretch the outline's own bounds.
    shape-fit: ShapeFit.normalized;

    // The M3 `level` slot mapped to its dp token (ElevationTokens.levelN).
    property <length> shadow_height:
        root.level <= 0 ? ElevationTokens.level0 :
        root.level == 1 ? ElevationTokens.level1 :
        root.level == 2 ? ElevationTokens.level2 :
        root.level == 3 ? ElevationTokens.level3 :
        root.level == 4 ? ElevationTokens.level4 :
        ElevationTokens.level5;

    // `animateElevation` tweens between *Elevation values (120ms/150ms
    // incoming/outgoing upstream — one spec covers both here).
    animate shadow_height {
        enabled: !MaterialPalette.reduced-motion;
        duration: 150ms;
        easing: root.shadow_easing;
    }

    // The `elevation`/`ambient-shadow-color`/`spot-shadow-color` bindings are
    // lowered to an `ElevationShadow` sibling that casts the Android ambient +
    // spot shadow for this rectangle's outline (its `shape`, or the border
    // radius when unset).
    caster := Rectangle {
        border_radius: root.border_radius;
        border-top-left-radius: root.shaped_corners ? root.corners.top_left : root.border_radius;
        border-top-right-radius: root.shaped_corners ? root.corners.top_right : root.border_radius;
        border-bottom-right-radius: root.shaped_corners ? root.corners.bottom_right : root.border_radius;
        border-bottom-left-radius: root.shaped_corners ? root.corners.bottom_left : root.border_radius;
        shape: root.shape;
        shape-fit: root.shape-fit;
        background: root.background;
        elevation: root.shadow_height;
        ambient-shadow-color: MaterialPalette.shadow;
        spot-shadow-color: MaterialPalette.shadow;

        @children
    }
}
