    out property <length> corner_bottom_right <=> base.corner_bottom_right;
    out property <length> corner_bottom_left <=> base.corner_bottom_left;
    out property <color> resolved_content_color <=> base.resolved_content_color;

    forward-focus: base;
    accessible-role: checkbox;
    accessible-enabled: root.enabled;
    accessible-label: root.text == "" ? root.tooltip : root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { base.activate(); }

    min_width: base.preferred_width;
    min_height: base.min_height;
    preferred_width: base.preferred_width;
    preferred_height: base.preferred_height;

    base := ChipBase {
        width: 100%;
        height: 100%;
        selectable: true;
        animate_slots: true;

        // FilterChipDefaults.elevatedFilterChipElevation: 1/1/1/3/8px
        elevation_default: 1;
        elevation_pressed: 1;
        elevation_focused: 1;
        elevation_hovered: 2;
        elevation_dragged: 4;
        elevation_disabled: 0;

        container_color: FilterChipTokens.elevated_unselected_container_color;
        selected_container_color: FilterChipTokens.elevated_selected_container_color;
        disabled_container_color: FilterChipTokens.elevated_disabled_container_color.with_alpha(FilterChipTokens.elevated_disabled_container_opacity);
        disabled_selected_container_color: FilterChipTokens.elevated_disabled_container_color.with_alpha(FilterChipTokens.elevated_disabled_container_opacity);

        label_color: FilterChipTokens.unselected_label_text_color;
        selected_label_color: FilterChipTokens.selected_label_text_color;
        disabled_label_color: FilterChipTokens.disabled_label_text_color.with_alpha(FilterChipTokens.disabled_label_text_opacity);
        leading_color: root.expressive ? ChipsTokens.unselected_leading_icon_color : FilterChipTokens.unselected_leading_icon_color;
        selected_leading_color: FilterChipTokens.selected_leading_icon_color;
        disabled_leading_color: FilterChipTokens.disabled_leading_icon_color.with_alpha(FilterChipTokens.disabled_leading_icon_opacity);
        trailing_color: FilterChipTokens.unselected_trailing_icon_color;
        selected_trailing_color: FilterChipTokens.selected_trailing_icon_color;
        disabled_trailing_color: FilterChipTokens.disabled_trailing_icon_color.with_alpha(FilterChipTokens.disabled_trailing_icon_opacity);

        state_color: root.checked ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
        container_shape: FilterChipTokens.container_shape;

        padding_start: 8px;
        padding_end: 8px;
        leading_spacing: root.expressive ? (base.has_leading ? 4px : 8px) : 8px;
        trailing_spacing: root.expressive ? (base.has_trailing ? 4px : 8px) : 8px;
    }
}

export component InputChip {
    in property <string> text <=> base.text;
    in property <image> leading_icon <=> base.leading_icon;
    in property <image> trailing_icon <=> base.trailing_icon;
    in property <image> avatar <=> base.avatar;
    in property <image> avatar_icon <=> base.avatar_icon;
    in property <bool> enabled <=> base.enabled;
    in property <string> tooltip;
    in property <MaterialCornerShape> container_shape <=> base.container_shape;
    in property <MaterialChipShapes> chip_shapes <=> base.chip_shapes;
    in property <bool> expressive <=> base.expressive;
    in property <bool> dragged <=> base.dragged;
    in property <bool> simulate_hover <=> base.simulate_hover;
    in property <bool> simulate_press <=> base.simulate_press;
    in property <color> avatar_background <=> base.avatar_background;
    in_out property <bool> checked <=> base.checked;
    in property <bool> checkable: true;

    callback clicked <=> base.clicked;
    callback trailing_icon_clicked <=> base.trailing_icon_clicked;

    out property <bool> has_focus <=> base.has_focus;
    out property <bool> pressed <=> base.pressed;
    out property <bool> has_hover <=> base.has_hover;
    out property <length> shadow_elevation <=> base.shadow_elevation;
    out property <length> corner_top_left <=> base.corner_top_left;
    out property <length> corner_top_right <=> base.corner_top_right;
    out property <length> corner_bottom_right <=> base.corner_bottom_right;
    out property <length> corner_bottom_left <=> base.corner_bottom_left;
    out property <color> resolved_content_color <=> base.resolved_content_color;

    forward-focus: base;
    accessible-role: checkbox;
    accessible-enabled: root.enabled;
    accessible-label: root.text == "" ? root.tooltip : root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { base.activate(); }

    min_width: base.preferred_width;
    min_height: base.min_height;
    preferred_width: base.preferred_width;
    preferred_height: base.preferred_height;

    base := ChipBase {
        width: 100%;
        height: 100%;
        selectable: root.checkable;
        animate_slots: true;

        // InputChipDefaults.inputChipElevation: flat, dragged 8px
        elevation_default: 0;
        elevation_pressed: 0;
        elevation_focused: 0;
        elevation_hovered: 0;
        elevation_dragged: 4;
        elevation_disabled: 0;

        container_color: transparent;
        selected_container_color: InputChipTokens.selected_container_color;
        disabled_container_color: transparent;
        disabled_selected_container_color: InputChipTokens.disabled_selected_container_color.with_alpha(InputChipTokens.disabled_selected_container_opacity);

        label_color: InputChipTokens.unselected_label_text_color;
        selected_label_color: InputChipTokens.selected_label_text_color;
        disabled_label_color: InputChipTokens.disabled_label_text_color.with_alpha(InputChipTokens.disabled_label_text_opacity);
        leading_color: InputChipTokens.unselected_leading_icon_color;
        selected_leading_color: InputChipTokens.selected_leading_icon_color;
        disabled_leading_color: InputChipTokens.disabled_leading_icon_color.with_alpha(InputChipTokens.disabled_leading_icon_opacity);
        trailing_color: InputChipTokens.unselected_trailing_icon_color;
        selected_trailing_color: InputChipTokens.selected_trailing_icon_color;
        disabled_trailing_color: InputChipTokens.disabled_trailing_icon_color.with_alpha(InputChipTokens.disabled_trailing_icon_opacity);

        state_color: root.checked ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;

        unselected_border_color: InputChipTokens.unselected_outline_color;
        unselected_border_width: InputChipTokens.unselected_outline_width;
        selected_border_color: transparent;
        selected_border_width: InputChipTokens.selected_outline_width;
        disabled_unselected_border_color: InputChipTokens.disabled_unselected_outline_color.with_alpha(InputChipTokens.disabled_unselected_outline_opacity);
        disabled_unselected_border_width: InputChipTokens.unselected_outline_width;
        disabled_selected_border_color: transparent;
        disabled_selected_border_width: InputChipTokens.selected_outline_width;

        container_shape: InputChipTokens.container_shape;

        // InputChipDefaults.contentPadding(avatar, leading, trailing):
        // start 4dp with avatar or without leading icon, 8dp otherwise;
        // end 8dp with trailing icon, 4dp without
        padding_start: base.has_avatar || !base.has_leading ? 4px : 8px;
        padding_end: base.has_trailing ? 8px : 4px;
        // `InputChipDefaults.horizontalArrangement(avatar, leading,
        // trailing)` on the `shapes:` overload: (avatar||leading)&&trailing
        // → (4,4), avatar/leading only → (4,8), trailing only → (8,4); the
        // `shape:` overload uses the default (8,8).
        leading_spacing: root.expressive ? (base.has_avatar || base.has_leading ? 4px : 8px) : 8px;
        trailing_spacing: root.expressive ? (base.has_trailing ? 4px : 8px) : 8px;
    }
}

