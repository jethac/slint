        disabled_trailing_color: SuggestionChipTokens.disabled_leading_icon_color.with_alpha(SuggestionChipTokens.disabled_leading_icon_opacity);

        unselected_border_color: SuggestionChipTokens.flat_outline_color;
        unselected_border_width: SuggestionChipTokens.flat_outline_width;
        disabled_unselected_border_color: SuggestionChipTokens.flat_disabled_outline_color.with_alpha(SuggestionChipTokens.flat_disabled_outline_opacity);

        container_shape: SuggestionChipTokens.container_shape;
    }
}

