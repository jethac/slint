import { DividerTokens } from "../styling/generated/material_component_tokens.slint";

/// `HorizontalDivider` in Divider.kt (androidx @ 23327507f7fc7d5b19d65fec4b090f60c970079b)
/// — `Modifier.fillMaxWidth().height(thickness)` drawing a `thickness`-wide
/// line centered in the band; a plain fill is pixel-identical.
export component HorizontalDivider {
    /// `thickness` — `DividerDefaults.Thickness` (`DividerTokens.Thickness`).
    /// `Dp.Hairline` (`0.dp` upstream) resolves to a single physical pixel
    /// regardless of density.
    in property <length> thickness: DividerTokens.thickness;
    /// `color` — `DividerDefaults.color` (`DividerTokens.Color`).
    in property <color> color: DividerTokens.color;

    pure function effective-thickness() -> length {
        root.thickness <= 0 ? 1phx : root.thickness
    }

    min_height: self.effective-thickness();
    preferred_height: self.min_height;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: root.effective-thickness();
        background: root.color;
    }
}

/// `VerticalDivider` in Divider.kt — `Modifier.fillMaxHeight().width(
/// thickness)` drawing a `thickness`-wide line centered in the band.
export component VerticalDivider {
    /// `thickness` — `DividerDefaults.Thickness` (`DividerTokens.Thickness`).
    /// `Dp.Hairline` (`0.dp` upstream) resolves to a single physical pixel
    /// regardless of density.
    in property <length> thickness: DividerTokens.thickness;
    /// `color` — `DividerDefaults.color` (`DividerTokens.Color`).
    in property <color> color: DividerTokens.color;

    pure function effective-thickness() -> length {
        root.thickness <= 0 ? 1phx : root.thickness
    }

    min_width: self.effective-thickness();
    preferred_width: self.min_width;

    Rectangle {
        x: (parent.width - self.width) / 2;
        width: root.effective-thickness();
        height: 100%;
        background: root.color;
    }
}

/// Deprecated alias — `Divider` in Divider.kt is `@Deprecated("Renamed to
/// HorizontalDivider")`; kept for compatibility with the same API.
export component Divider inherits HorizontalDivider {}
