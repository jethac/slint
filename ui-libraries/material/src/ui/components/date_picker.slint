import { Icons } from "../icons/icons.slint";
import { MaterialText } from "./material_text.slint";
import { StateLayer } from "./state_layer.slint";
import { ScrollView } from "./scroll_view.slint";
import { IconButton } from "./icon_button.slint";
import { TextButton } from "./text_button.slint";
import { HorizontalDivider } from "./divider.slint";
import { Modal } from "./modal.slint";
import { MaterialTypography } from "../styling/material_typography.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialAnimations } from "../styling/material_animations.slint";
import { DatePickerModalTokens } from "../styling/generated/material_component_tokens.slint";
import { MaterialCornerShape } from "../styling/generated/material_shape_tokens.slint";

// defines the interface to get the data for the DatePicker from native code.
export global DatePickerAdapter {
    // returns the number of days for the given month in the given year.
    pure callback month_day_count(month: int, year: int) -> int;

    // return the numbers of day to the first monday of the month.
    pure callback month_offset(month: int, year: int) -> int;

    // used to format a date that is defined by day month and year.
    pure callback format_date(format: string, day: int, month: int, year: int) -> string;

    // parses the given date string and returns a list of day, month and year.
    pure callback parse_date(date: string, format: string) -> [int];

    // returns true if the given date is valid.
    pure callback valid_date(date: string, format: string) -> bool;

    // returns the current date as list of day, month and year.
    pure callback date_now() -> [int];
}

export struct Date {
    year: int,
    month: int,
    day: int,
}

/// Gregorian calendar math matching the pinned upstream `CalendarModel`
/// (`internal/CalendarModelImpl.kt`): Sunday first day of week, en-US locale
/// formatting for the `yMMMM`/`yMMMd`/`yMMMMEEEEd` skeletons. Pure functions
/// so the calendar works when no host `DatePickerAdapter` is installed
/// (interpreter, tests, previews).
export global CalendarMath {
    // Linear day number (proleptic Gregorian days since the civil epoch),
    // valid for all positive years.
    pure public function days_from_civil(year: int, month: int, day: int) -> int {
        let y = year + (month <= 2 ? -1 : 0);
        let era = floor(y / 400);
        let yoe = y - era * 400;
        let doy = floor((153 * (month + (month > 2 ? -3 : 9)) + 2) / 5) + day - 1;
        let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy;
        era * 146097 + doe - 719468
    }

    pure public function day_index(date: Date) -> int {
        days_from_civil(date.year, date.month, date.day)
    }

    // 0 = Sunday (1970-01-01 was a Thursday).
    pure public function day_of_week(date: Date) -> int {
        mod(day_index(date) + 4, 7)
    }

    // Number of empty cells before the 1st of the month (Sunday-start rows).
    pure public function month_offset(month: int, year: int) -> int {
        day_of_week({ day: 1, month: month, year: year })
    }

    pure public function leap_year(year: int) -> bool {
        mod(year, 4) == 0 && (mod(year, 100) != 0 || mod(year, 400) == 0)
    }

    pure public function days_in_month(month: int, year: int) -> int {
        month == 2 ? (leap_year(year) ? 29 : 28) : [31, 0, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][month - 1]
    }

    // index 0 = January
    pure public function month_name(month: int) -> string {
        [
            @tr("January"),
            @tr("February"),
            @tr("March"),
            @tr("April"),
            @tr("May"),
            @tr("June"),
            @tr("July"),
            @tr("August"),
            @tr("September"),
            @tr("October"),
            @tr("November"),
            @tr("December"),
        ][month - 1]
    }

    pure public function month_name_abbr(month: int) -> string {
        [
            @tr("Jan"),
            @tr("Feb"),
            @tr("Mar"),
            @tr("Apr"),
            @tr("May"),
            @tr("Jun"),
            @tr("Jul"),
            @tr("Aug"),
            @tr("Sep"),
            @tr("Oct"),
            @tr("Nov"),
            @tr("Dec"),
        ][month - 1]
    }

    // index 0 = Sunday
    pure public function weekday_name(index: int) -> string {
        [
            @tr("Sunday"),
            @tr("Monday"),
            @tr("Tuesday"),
            @tr("Wednesday"),
            @tr("Thursday"),
            @tr("Friday"),
            @tr("Saturday"),
        ][index]
    }

    pure public function weekday_letter(index: int) -> string {
        [
            @tr("One-letter abbrev for Sunday" => "S"),
            @tr("One-letter abbrev for Monday" => "M"),
            @tr("One-letter abbrev for Tuesday" => "T"),
            @tr("One-letter abbrev for Wednesday" => "W"),
            @tr("One-letter abbrev for Thursday" => "T"),
            @tr("One-letter abbrev for Friday" => "F"),
            @tr("One-letter abbrev for Saturday" => "S"),
        ][index]
    }

    // `formatMonthYear` — skeleton `yMMMM` in en-US: "October 2026".
    pure public function format_month_year(month: int, year: int) -> string {
        month_name(month) + " " + year
    }

    // `formatDate` — skeleton `yMMMd` in en-US: "Oct 4, 2026".
    pure public function format_date(date: Date) -> string {
        month_name_abbr(date.month) + " " + date.day + ", " + date.year
    }

    // `yMMMMEEEEd` verbose date for content descriptions.
    pure public function format_date_verbose(date: Date) -> string {
        weekday_name(day_of_week(date)) + ", " + month_name(date.month) + " " + date.day + ", " + date.year
    }

    // `formatWithPattern(millis, patternWithoutDelimiters)` + delimiters —
    // the en-US `MM/DD/YYYY` digits the input field carries for a selection.
    pure public function format_date_digits(date: Date) -> string {
        (date.month < 10 ? "0" : "") + date.month + "/"
            + (date.day < 10 ? "0" : "") + date.day + "/" + date.year
    }

    pure public function valid_date(date: Date) -> bool {
        date.year >= 1900 && date.year <= 2100 && date.month >= 1 && date.month <= 12
            && date.day >= 1 && date.day <= days_in_month(date.month, date.year)
    }

    pure public function compare(a: Date, b: Date) -> int {
        day_index(a) - day_index(b)
    }

    pure public function next_month(month: int, year: int) -> Date {
        month >= 12 ? { day: 1, month: 1, year: year + 1 } : { day: 1, month: month + 1, year: year }
    }

    pure public function previous_month(month: int, year: int) -> Date {
        month <= 1 ? { day: 1, month: 12, year: year - 1 } : { day: 1, month: month - 1, year: year }
    }
}

export enum DatePickerDisplayMode { picker, input }

// Upstream `Day`: a `Surface` with `DateContainerShape` (CornerFull) whose
// `requiredSize(40)` content expands to the minimum interactive component
// size (`enforce-touch-target` = 48). In range mode the selection band behind
// the cells provides the in-range container.
component DayCell {
    in property <Date> date;
    in property <string> text;
    in property <bool> selected;
    in property <bool> today;
    in property <bool> in_range;
    in property <bool> enabled: true;
    in property <length> cell_size: 40px;
    // `DatePickerColors.selectedDayContainerColor`
    in property <brush> selected_color: DatePickerModalTokens.date_selected_container_color;

    callback clicked();

    width: root.cell_size;
    height: root.cell_size;
    forward_focus: focus_scope;

    accessible_role: button;
    accessible_checkable: true;
    accessible_checked: root.selected;
    accessible_enabled: root.enabled;
    accessible_label: CalendarMath.valid_date(root.date) ? CalendarMath.format_date_verbose(root.date) : root.text;
    accessible_action_default => { touch_area.clicked(); }

    touch_area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
    }

    focus_scope := FocusScope {
        width: 0px;
        enabled: root.enabled;

        key_pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                touch_area.clicked();
                return accept;
            }

            return reject;
        }
    }

    background_layer := Rectangle {
        width: 100%;
        height: 100%;
        border_radius: self.height / 2;
        border_width: root.today && !root.selected ? DatePickerModalTokens.date_today_container_outline_width : 0;
        border_color: DatePickerModalTokens.date_today_container_outline_color;
        background: root.selected ? root.selected_color : transparent;

        animate background { enabled: !MaterialPalette.reduced-motion; easing: MaterialAnimations.default-effects-spring; }
        animate border_width { enabled: !MaterialPalette.reduced-motion; easing: MaterialAnimations.default-effects-spring; }
    }

    text_label := MaterialText {
        vertical_alignment: center;
        horizontal_alignment: center;
        style: DatePickerModalTokens.date_label_text_font;
        // `dayContentColor` priority: selected > in-range > today > default
        color: root.selected ? DatePickerModalTokens.date_selected_label_text_color
            : root.in_range ? DatePickerModalTokens.selection_date_in_range_label_text_color
            : root.today ? DatePickerModalTokens.date_today_label_text_color
            : DatePickerModalTokens.date_unselected_label_text_color;
        opacity: root.enabled ? 1 : 0.38; // DisabledAlpha
        text: root.text;
        animate color { enabled: !MaterialPalette.reduced-motion && !root.in_range; easing: MaterialAnimations.default-effects-spring; }
    }

    state_layer := StateLayer {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        border_radius: background_layer.border_radius;
        pressed: touch_area.pressed;
        has_hover: touch_area.has_hover;
        has_focus: focus_scope.has_focus;
    }
}

// `WeekDays` cell — `sizeIn(min 40).size(MICS)` letter box.
component WeekdayCell {
    in property <string> text;
    in property <length> cell_size: 40px;

    width: root.cell_size;
    height: root.cell_size;

    MaterialText {
        vertical_alignment: center;
        horizontal_alignment: center;
        style: DatePickerModalTokens.weekdays_label_text_font;
        color: DatePickerModalTokens.weekdays_label_text_color;
        text: root.text;
    }
}

// Upstream `MonthsNavigation` row (`requiredHeight(56)`): the
// `YearPickerMenuButton` (CircleShape text button + 8dp icon spacing +
// ArrowDropDown rotated 180° when expanded) at the start, prev/next
// `IconButton`s at the end — hidden while the year picker is expanded.
component MonthsNavigation {
    in property <string> month_year_text;
    in property <bool> year_picker_visible;
    in property <bool> previous_available;
    in property <bool> next_available;
    in property <bool> enforce_touch_target: true;

    callback previous_month();
    callback next_month();
    callback toggle_year_picker();

    height: 56px; // MonthYearHeight

    year_toggle := Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        height: 40px;
        width: year_toggle_row.min_width;
        border_radius: self.height / 2;

        forward_focus: year_toggle_scope;
        accessible_role: button;
        accessible_checkable: true;
        accessible_checked: root.year_picker_visible;
        accessible_label: root.month_year_text;
        accessible_action_default => { year_toggle_area.clicked(); }

        year_toggle_scope := FocusScope {
            width: 0;

            key_pressed(event) => {
                if (event.text == " " || event.text == "\n") {
                    year_toggle_area.clicked();
                    return accept;
                }
                reject
            }
        }

        year_toggle_area := TouchArea {
            width: 100%;
            height: 100%;

            clicked => {
                root.toggle_year_picker();
            }
        }

        year_toggle_row := HorizontalLayout {
            alignment: center;
            padding-left: 12px;  // TextButtonHorizontalPadding
            padding-right: 12px;
            spacing: 8px;        // ButtonDefaults.IconSpacing

            MaterialText {
                style: MaterialTypography.label_large;
                color: MaterialPalette.on_surface_variant; // navigationContentColor
                text: root.month_year_text;
                vertical_alignment: center;
                width: self.preferred-width;
            }

            Image {
                source: Icons.arrow_drop_down;
                width: 24px;
                colorize: MaterialPalette.on_surface_variant;
                transform-rotation: root.year_picker_visible ? 180deg : 0;
                y: (parent.height - self.height) / 2;

                animate transform-rotation { enabled: !MaterialPalette.reduced-motion; duration: 250ms; }
            }
        }

        year_toggle_state := StateLayer {
            width: 100%;
            height: 100%;
            border_radius: year_toggle.border_radius;
            pressed: year_toggle_area.pressed;
            has_hover: year_toggle_area.has_hover;
            has_focus: year_toggle_scope.has_focus;
        }
    }

    if !root.year_picker_visible : HorizontalLayout {
        x: parent.width - self.min_width;
        width: self.min_width;
        alignment: center;
        spacing: 0;

        // `Icons.AutoMirrored.Filled.KeyboardArrowLeft` — the classic 24dp
        // material path (DatePicker.kt `SwitchToPreviousMonth`).
        prev_button := IconButton {
            icon: Icons.keyboard_arrow_left;
            accessible_label: @tr("Previous month");
            enabled: root.previous_available;
            enforce_touch_target: root.enforce_touch_target;

            clicked => {
                root.previous_month();
            }
        }

        // `Icons.AutoMirrored.Filled.KeyboardArrowRight` — `SwitchToNextMonth`.
        next_button := IconButton {
            icon: Icons.keyboard_arrow_right;
            accessible_label: @tr("Next month");
            enabled: root.next_available;
            enforce_touch_target: root.enforce_touch_target;

            clicked => {
                root.next_month();
            }
        }
    }
}

// Upstream `Month`: `requiredHeight(RecommendedSizeForAccessibility * 6)` =
// 288, six rows each a `fillMaxWidth` `SpaceEvenly` row of seven cells —
// `cell = max(40, mics)` for day and empty cells alike, with the slack
// distributed into 8 equal gaps per row.
component CalendarMonth {
    in property <int> month; // 1..12
    in property <int> year;
    in property <Date> selected;
    in property <Date> selected_end;
    in property <Date> today;
    in property <bool> range;
    in property <bool> enforce_touch_target: true;
    in property <Date> selectable_from: { year: 1900, month: 1, day: 1 };
    in property <Date> selectable_to: { year: 2100, month: 12, day: 31 };
    // `DatePickerColors.selectedDayContainerColor` /
    // `dayInSelectionRangeContainerColor`
    in property <brush> selected_color: DatePickerModalTokens.date_selected_container_color;
    in property <brush> range_band_color: DatePickerModalTokens.range_selection_active_indicator_container_color;

    callback date_clicked(date: Date);

    property <int> day_count: CalendarMath.days_in_month(root.month, root.year);
    property <int> first_offset: CalendarMath.month_offset(root.month, root.year);
    property <length> cell: root.enforce_touch_target ? 48px : DatePickerModalTokens.date_container_width;
    property <length> h_space: (root.width - 7 * root.cell) / 8;
    property <length> v_space: (288px - 6 * root.cell) / 7;

    // `SelectedRangeInfo.calculateRangeInfo` on linear day numbers
    property <int> month_first: CalendarMath.days_from_civil(root.year, root.month, 1);
    property <int> month_last: root.month_first + root.day_count - 1;
    property <int> sel_start: CalendarMath.valid_date(root.selected) ? CalendarMath.day_index(root.selected) : 0;
    property <int> sel_end: CalendarMath.valid_date(root.selected_end) ? CalendarMath.day_index(root.selected_end) : 0;
    property <bool> range_in_month: root.range && CalendarMath.valid_date(root.selected) && CalendarMath.valid_date(root.selected_end)
        && root.sel_start <= root.month_last && root.sel_end >= root.month_first;
    property <bool> first_is_start: root.range_in_month && root.sel_start >= root.month_first;
    property <bool> last_is_end: root.range_in_month && root.sel_end <= root.month_last;
    property <int> range_start_cell: root.first_offset + (root.first_is_start ? root.sel_start - root.month_first : 0);
    property <int> range_end_cell: root.first_offset + (root.last_is_end ? root.sel_end - root.month_first : root.day_count - 1);
    property <int> range_start_x: mod(root.range_start_cell, 7);
    property <int> range_start_y: floor(root.range_start_cell / 7);
    property <int> range_end_x: mod(root.range_end_cell, 7);
    property <int> range_end_y: floor(root.range_end_cell / 7);

    height: 288px;
    min_width: 7 * root.cell;

    // `drawRangeBackground`: band height = `DateStateLayerHeight` (40) drawn
    // over a fixed `RecommendedSizeForAccessibility` (48) item grid
    // regardless of the actual cell size — mirrored literally, including the
    // `firstIsSelectionStart`/`lastIsSelectionEnd` half-cell edges.
    if root.range_in_month : range_band := Rectangle {
        width: 100%;
        height: 100%;

        property <length> item: 48px;
        property <length> item_gap: (root.width - 7 * self.item) / 7;
        property <length> band_h: DatePickerModalTokens.date_state_layer_height;
        property <length> start_x: root.range_start_x * (self.item + self.item_gap)
            + (root.first_is_start ? self.item / 2 : 0) + self.item_gap / 2;
        property <length> end_x: root.range_end_x * (self.item + self.item_gap)
            + (root.last_is_end ? self.item / 2 : self.item) + self.item_gap / 2;
        property <length> start_y: root.range_start_y * self.item + (self.item - self.band_h) / 2;
        property <length> end_y: root.range_end_y * self.item + (self.item - self.band_h) / 2;

        Rectangle {
            x: parent.start_x;
            y: parent.start_y;
            width: (root.range_start_y == root.range_end_y ? parent.end_x : parent.width) - parent.start_x;
            height: parent.band_h;
            background: root.range_band_color;
        }

        for mid_row in max(0, root.range_end_y - root.range_start_y - 1) : Rectangle {
            x: 0;
            y: parent.start_y + (mid_row + 1) * parent.item;
            width: parent.width;
            height: parent.band_h;
            background: root.range_band_color;
        }

        if root.range_start_y != root.range_end_y : Rectangle {
            x: 0;
            y: parent.end_y;
            width: parent.end_x;
            height: parent.band_h;
            background: root.range_band_color;
        }
    }

    for index in 42 : day := DayCell {
        selected_color: root.selected_color;
        property <int> day_index: index - root.first_offset;
        property <bool> has_day: self.day_index >= 0 && self.day_index < root.day_count;
        property <Date> cell_date: { day: self.day_index + 1, month: root.month, year: root.year };
        property <int> cell_col: mod(index, 7);
        property <int> cell_row: floor(index / 7);
        property <int> cell_day_index: root.month_first + self.day_index;

        // `SpaceEvenly` rounds each child's position to whole device px
        // (`roundToInt` on the px value), so quantize in `phx` not `px`.
        x: Math.round((root.h_space + self.cell_col * (root.cell + root.h_space)) / 1phx) * 1phx;
        y: Math.round((root.v_space + self.cell_row * (root.cell + root.v_space)) / 1phx) * 1phx;
        cell_size: root.cell;
        visible: self.has_day;
        text: self.day_index + 1;
        date: self.cell_date;
        selected: self.cell_day_index == root.sel_start || (root.range && self.cell_day_index == root.sel_end);
        today: CalendarMath.valid_date(root.today) && root.today == self.cell_date;
        in_range: root.range_in_month && self.cell_day_index > root.sel_start && self.cell_day_index < root.sel_end;
        enabled: self.has_day
            && self.cell_day_index >= CalendarMath.day_index(root.selectable_from)
            && self.cell_day_index <= CalendarMath.day_index(root.selectable_to)
            && root.year >= 1900 && root.year <= 2100;

        clicked => {
            root.date_clicked(self.cell_date);
        }
    }
}

// The `WeekDays` row: `defaultMinSize(48)`, 7 `SpaceEvenly` letter cells.
component WeekdayRow {
    in property <length> cell: 40px;

    property <length> h_space: (root.width - 7 * root.cell) / 8;

    height: 48px; // RecommendedSizeForAccessibility

    for index in 7 : WeekdayCell {
        x: Math.round((root.h_space + index * (root.cell + root.h_space)) / 1phx) * 1phx;
        y: (parent.height - self.height) / 2;
        cell_size: root.cell;
        text: CalendarMath.weekday_letter(index);
    }
}

// Upstream `DatePickerHeader`: when a title is present the column is
// `defaultMinSize(minHeight)` — `HeaderContainerHeight` (120) for the picker,
// `RangeSelectionHeaderContainerHeight` (128) − `HeaderHeightOffset` (60) = 68
// for the range picker — title bottom-start over the headline row that
// carries the mode toggle at its end.
component DatePickerHeader {
    in property <string> title;
    in property <bool> show_mode_toggle: true;
    in property <bool> input_mode;
    in property <bool> range;
    in property <string> headline_text;
    in property <string> headline_start;
    in property <string> headline_end;
    in property <length> title_start_padding: 24px;
    in property <bool> enforce_touch_target: true;

    callback toggle_input_mode();

    property <string> start_text: root.headline_start != "" ? root.headline_start : @tr("Start date");
    property <string> end_text: root.headline_end != "" ? root.headline_end : @tr("End date");

    // With a title the column gets `defaultMinSize(minHeight)` —
    // `HeaderContainerHeight` (120) or the range picker's 68 — covering the
    // title, the headline row, and the divider that closes the column. The
    // row is `max(toggle, headline + bottom padding 12)` and can push the
    // column past the minimum when the headline wraps to a second line.
    // Compose text measurements land on whole px; the slint preferred
    // heights feed a heightIn-style bound, so ceil them the way the
    // measured layout does.
    height: max(root.title != "" ? (root.range ? 68px : 120px) : 0px,
        (root.title != "" ? Math.ceil(title_label.preferred_height / 1px) * 1px : 0px)
            + headline_row.height + 1px);
    visible: root.title != "" || root.show_mode_toggle;

    // `DatePickerTitlePadding` (start 24, end 12, top 16) /
    // `DateRangePickerTitlePadding` (start 64, end 12)
    title_label := MaterialText {
        x: root.title_start_padding;
        y: root.range ? 0 : 16px;
        style: DatePickerModalTokens.header_supporting_text_font;
        color: DatePickerModalTokens.header_supporting_text_color;
        text: root.title;
        height: self.preferred-height;
        width: self.preferred-width;
    }

    headline_row := Rectangle {
        x: 0;
        y: parent.height - self.height - 1px;
        width: parent.width;
        height: max(52px, Math.ceil(range_end.preferred_height / 1px) * 1px + 12px);

        // `DatePickerHeadlinePadding` (start 24, end 12, bottom 12) /
        // `DateRangePickerHeadlinePadding` (start 64, end 12, bottom 12).
        // Upstream's headline `Text` sits TopStart in its weighted box, so
        // the labels draw at the row top and only the bottom padding is real.
        headline_area := Rectangle {
            x: 0;
            width: parent.width - (root.show_mode_toggle ? 52px : 0);

            headline_label := MaterialText {
                x: root.title_start_padding;
                y: 0;
                style: DatePickerModalTokens.header_headline_font;
                color: DatePickerModalTokens.header_headline_color;
                text: !root.range ? root.headline_text : "";
                visible: !root.range;
            }

            // Range headline — upstream `RangePickerHeadline` is a
            // `Row(spacedBy 4.dp, CenterVertically)` of three Texts
            // (DateRangePicker.kt: `Text(formatterStartDate)`, `datesDelimiter`,
            // `Text(formatterEndDate)`). The Row measures children left to
            // right against the remaining width, so only the end date wraps
            // when the pair overflows the weighted headline box.
            range_start := MaterialText {
                x: root.title_start_padding;
                y: (headline_row.height - 12px - self.height) / 2;
                style: DatePickerModalTokens.range_selection_header_headline_font;
                color: DatePickerModalTokens.header_headline_color;
                text: root.range ? root.start_text : "";
                wrap: no-wrap;
                visible: root.range;
            }

            range_delim := MaterialText {
                x: range_start.x + range_start.preferred_width + 4px;
                y: (headline_row.height - 12px - self.height) / 2;
                style: DatePickerModalTokens.range_selection_header_headline_font;
                color: DatePickerModalTokens.header_headline_color;
                text: "-";
                wrap: no-wrap;
                visible: root.range;
            }

            range_end := MaterialText {
                x: range_delim.x + range_delim.preferred_width + 4px;
                y: (headline_row.height - 12px - self.height) / 2;
                width: headline_area.width - 12px - self.x;
                style: DatePickerModalTokens.range_selection_header_headline_font;
                color: DatePickerModalTokens.header_headline_color;
                text: root.range ? root.end_text : "";
                wrap: word-wrap;
                overflow: clip;
                visible: root.range;
            }
        }

        // `DisplayModeToggleButton` — `DatePickerModeTogglePadding` (end 12, bottom 12)
        if root.show_mode_toggle : mode_toggle := IconButton {
            x: parent.width - self.width - 12px;
            // The IconButton's `DatePickerModeTogglePadding` box (40 + end 12 /
            // bottom 12) is centered in the headline row like every other
            // child — the button sits at the top of that padded box.
            y: (parent.height - 12px - self.height) / 2;
            // `Icons.Filled.DateRange` switches back to the calendar;
            // `Icons.Filled.Edit` opens the input — the classic material
            // paths from DatePicker.kt's mode toggle.
            icon: root.input_mode ? Icons.date_range : Icons.edit_filled;
            enforce_touch_target: root.enforce_touch_target;
            accessible_label: root.input_mode ? @tr("Switch to calendar input") : @tr("Switch to text input");

            clicked => {
                root.toggle_input_mode();
            }
        }
    }

    // The `HorizontalDivider` that closes `DatePickerHeader`'s content
    // column — drawn whenever there is a title, headline, or mode toggle.
    HorizontalDivider {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
    }
}

// Upstream `YearPicker`: `LazyVerticalGrid` of 3 `SpaceEvenly` columns with
// `spacedBy(16)` rows, `requiredHeight(48 * 7 - 1)` = 335 over the container
// color. Each `Year` is `requiredSize(72 x 36)`, CornerFull.
component YearPicker inherits Rectangle {
    in property <int> year_min: 1900;
    in property <int> year_max: 2100;
    in property <int> displayed_year;
    in property <int> current_year;
    in property <bool> enforce_touch_target: true;

    callback year_clicked(year: int);

    property <int> year_count: root.year_max - root.year_min + 1;
    property <int> row_count: ceil(root.year_count / 3);
    // upstream initialFirstVisibleItemIndex: a few years before the
    // displayed year so previous years are easy to reach.
    property <int> first_item: max(0, root.displayed_year - root.year_min - 3); // YearsInRow
    property <length> item_space: (root.width - 3 * DatePickerModalTokens.selection_year_container_width) / 4;

    height: 335px; // 48 * MaxCalendarRows - dividerThickness
    clip: true;

    scroll := ScrollView {
        width: 100%;
        height: 100%;
        content_width: parent.width;
        content_height: root.row_count * (DatePickerModalTokens.selection_year_container_height + 16px) - 16px;
        content_y: floor(root.first_item / 3) * (DatePickerModalTokens.selection_year_container_height + 16px);

        for index in root.year_count : year_cell := Rectangle {
            property <int> year: root.year_min + index;
            property <bool> selected: self.year == root.displayed_year;
            property <bool> is_current: self.year == root.current_year;

            // The LazyVerticalGrid's `SpaceEvenly` also rounds slot starts
            // to whole device px like the month grid's `SpaceEvenly` rows.
            x: Math.round((root.item_space + mod(index, 3) * (self.width + root.item_space)) / 1phx) * 1phx;
            y: floor(index / 3) * (DatePickerModalTokens.selection_year_container_height + 16px);
            width: DatePickerModalTokens.selection_year_container_width;
            height: DatePickerModalTokens.selection_year_container_height;
            border_radius: self.height / 2;
            background: self.selected ? DatePickerModalTokens.selection_year_selected_container_color : transparent;
            border_width: self.is_current && !self.selected ? DatePickerModalTokens.date_today_container_outline_width : 0;
            border_color: DatePickerModalTokens.date_today_container_outline_color;

            forward_focus: year_scope;
            accessible_role: button;
            accessible_label: self.year;
            accessible_action_default => { year_area.clicked(); }

            year_scope := FocusScope {
                width: 0;

                key_pressed(event) => {
                    if (event.text == " " || event.text == "\n") {
                        year_area.clicked();
                        return accept;
                    }
                    reject
                }
            }

            year_area := TouchArea {
                width: 100%;
                height: 100%;

                clicked => {
                    root.year_clicked(parent.year);
                }
            }

            MaterialText {
                vertical_alignment: center;
                horizontal_alignment: center;
                style: DatePickerModalTokens.selection_year_label_text_font;
                color: parent.selected ? DatePickerModalTokens.selection_year_selected_label_text_color
                    : parent.is_current ? DatePickerModalTokens.date_today_label_text_color
                    : DatePickerModalTokens.selection_year_unselected_label_text_color;
                text: parent.year;
            }

            year_state := StateLayer {
                width: 100%;
                height: 100%;
                border_radius: year_cell.border_radius;
                pressed: year_area.pressed;
                has_hover: year_area.has_hover;
                has_focus: year_scope.has_focus;
            }
        }
    }
}

// The input mode's `DateInputTextField` — an `OutlinedTextField` whose
// measured height is ~80: the floated-label zone (~8) above the 56-high
// CornerExtraSmall border box plus the `supportingText` slot's empty
// reserve (~16) below it. Kept minimal for the picker; the standalone
// `OutlinedTextField` parity row belongs to the text-field family.
component DateInputField {
    in property <string> label_text: @tr("Date");
    in-out property <string> text: "";
    // `patternWithDelimiters` — shown while `text` is empty, like the
    // upstream `placeholder` composable (`inputPlaceholderColor`).
    in property <string> placeholder_text: @tr("MM/DD/YYYY");
    in property <bool> has_error;
    // `supportingText` shows the validation error when it is non-blank;
    // the slot reserves its height either way.
    in property <string> error_text: "";

    callback edited(text: string);
    callback accepted(text: string);

    height: 80px; // label zone 8 + field 56 + supporting reserve 16

    background := Rectangle {
        x: 0;
        y: 8px;
        width: 100%;
        height: 56px;
        border_radius: 4px; // corner_extra_small
        border_width: input.has_focus || root.has_error ? 2px : 1px;
        border_color: root.has_error ? MaterialPalette.error : input.has_focus ? MaterialPalette.primary : MaterialPalette.outline;
    }

    // Floated label cut out of the top border.
    Rectangle {
        x: 12px;
        y: 8px - (floated_label.preferred_height / 2);
        height: floated_label.preferred_height;
        width: floated_label.preferred_width + 8px;
        background: DatePickerModalTokens.container_color;

        floated_label := MaterialText {
            x: 4px;
            // The cutout reserves the label's run plus its trailing padding —
            // the bounds span the slot so the notch edge counts as
            // label-derived geometry, not field border.
            width: parent.width - 4px;
            style: MaterialTypography.body_small;
            color: root.has_error ? MaterialPalette.error : input.has_focus ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            text: root.label_text;
        }
    }

    if root.text == "" : placeholder_label := MaterialText {
        x: 16px;
        y: 8px;
        height: 56px;
        vertical_alignment: center;
        style: MaterialTypography.body_large;
        color: MaterialPalette.on_surface_variant;
        text: root.placeholder_text;
    }

    // `supportingText` zone — `SupportingTopPadding` (4) above the text.
    if root.error_text != "" : MaterialText {
        x: 16px;
        y: 64px + 4px;
        style: MaterialTypography.body_small;
        color: root.has_error ? MaterialPalette.error : MaterialPalette.on_surface_variant;
        text: root.error_text;
    }

    input := TextInput {
        x: 16px;
        y: 8px;
        width: parent.width - 32px;
        height: 56px;
        text <=> root.text;
        vertical_alignment: center;
        color: MaterialPalette.on_surface;
        font_size: MaterialTypography.body_large.font_size;
        font_family: MaterialTypography.body_large.font_family;
        font_weight: MaterialTypography.body_large.font_weight;
        letter_spacing: MaterialTypography.body_large.tracking;
        single_line: true;
        selection_foreground_color: MaterialPalette.on_primary_container;
        selection_background_color: MaterialPalette.primary_container;

        edited => {
            root.edited(self.text);
        }

        accepted => {
            root.accepted(self.text);
        }
    }
}

// The picker content column (`DatePickerHorizontalPadding` = 12 on both
// sides): `MonthsNavigation`, `WeekDays` + `Month`, or the `YearPicker`
// overlay — or the `DateInputContent` text field in input mode.
component DatePickerContent {
    in property <Date> selected;
    in property <Date> today;
    in property <int> month;
    in property <int> year;
    in property <brush> selected_color: DatePickerModalTokens.date_selected_container_color;
    in property <bool> year_picker_visible;
    in property <bool> previous_available;
    in property <bool> next_available;
    in property <bool> enforce_touch_target: true;
    in property <Date> selectable_from: { year: 1900, month: 1, day: 1 };
    in property <Date> selectable_to: { year: 2100, month: 12, day: 31 };
    in property <int> current_year;
    in property <int> year_min: 1900;
    in property <int> year_max: 2100;

    callback date_clicked(date: Date);
    // The chevrons slide the month pager; once the slide lands the timer
    // commits the new displayed month through `month_navigated`.
    callback month_navigated(month: int, year: int);
    callback toggle_year_picker();
    callback year_clicked(year: int);

    property <length> cell: root.enforce_touch_target ? 48px : 40px;

    // `HorizontalMonthsList` is a paged `LazyRow`: three adjacent months
    // stay composed around `page` 1 (at rest). A chevron click slides to
    // page 0/2, then `swap_timer` applies the new month and snaps the
    // strip back with the animation disabled.
    property <int> page: 1;
    property <bool> swapping: false;
    property <int> shown_month: root.month;
    property <int> shown_year: root.year;
    property <Date> prev_month: CalendarMath.previous_month(root.shown_month, root.shown_year);
    property <Date> next_month: CalendarMath.next_month(root.shown_month, root.shown_year);

    changed month => {
        root.shown_month = root.month;
        root.page = 1;
    }

    changed year => {
        root.shown_year = root.year;
        root.page = 1;
    }

    swap_timer := Timer {
        running: root.page != 1;
        interval: MaterialPalette.reduced-motion ? 1ms : 350ms;
        triggered => {
            root.swapping = true;
            if (root.page == 2) {
                root.shown_month = root.next_month.month;
                root.shown_year = root.next_month.year;
            } else {
                root.shown_month = root.prev_month.month;
                root.shown_year = root.prev_month.year;
            }
            root.page = 1;
            root.swapping = false;
            root.month_navigated(root.shown_month, root.shown_year);
        }
    }

    height: 56px + (root.year_picker_visible ? 335px : 48px + 288px);

    nav := MonthsNavigation {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        month_year_text: CalendarMath.format_month_year(root.month, root.year);
        year_picker_visible: root.year_picker_visible;
        previous_available: root.previous_available;
        next_available: root.next_available;
        enforce_touch_target: root.enforce_touch_target;

        previous_month => {
            if (root.page == 1 && root.previous_available) {
                root.page = 0;
            }
        }
        next_month => {
            if (root.page == 1 && root.next_available) {
                root.page = 2;
            }
        }
        toggle_year_picker => { root.toggle_year_picker(); }
    }

    if !root.year_picker_visible : grid_area := Rectangle {
        x: 12px;
        y: 56px;
        width: parent.width - 24px;
        height: 48px + 288px;

        WeekdayRow {
            x: 0;
            y: 0;
            width: parent.width;
            cell: root.cell;
        }

        pager := Rectangle {
            x: 0;
            y: 48px;
            width: parent.width;
            height: 288px;
            clip: true;

            pager_strip := Rectangle {
                x: -root.page * pager.width;
                width: 3 * parent.width;
                height: parent.height;

                animate x { enabled: !root.swapping && !MaterialPalette.reduced-motion; easing: MaterialAnimations.default-spatial-spring; }

                for slot_month[index] in [root.prev_month, { day: 1, month: root.shown_month, year: root.shown_year }, root.next_month] : CalendarMonth {
                    selected_color: root.selected_color;
                    x: index * parent.width / 3;
                    width: parent.width / 3;
                    month: slot_month.month;
                    year: slot_month.year;
                    selected: root.selected;
                    today: root.today;
                    enforce_touch_target: root.enforce_touch_target;
                    selectable_from: root.selectable_from;
                    selectable_to: root.selectable_to;

                    date_clicked(date) => {
                        root.date_clicked(date);
                    }
                }
            }
        }
    }

    if root.year_picker_visible : year_picker := YearPicker {
        x: 12px;
        y: 56px;
        width: parent.width - 24px;
        displayed_year: root.year;
        current_year: root.current_year;
        year_min: root.year_min;
        year_max: root.year_max;
        enforce_touch_target: root.enforce_touch_target;

        year_clicked(year) => {
            root.year_clicked(year);
        }
    }
}

/// The upstream `DatePicker` content widget (`DateEntryContainer`): a
/// `Column.sizeIn(minWidth = 360)` painted with `container_color`
/// (SurfaceContainerHigh) holding the header, divider, and picker/input
/// contents. Wrap it in `DatePickerDialog` for the modal form.
export component DatePicker {
    in property <string> title: @tr("Select date");
    in property <bool> show_title: true;
    in-out property <Date> selected_date;
    in-out property <Date> displayed_date: { day: 1, month: 12, year: 2025 };
    in property <Date> today;
    in-out property <DatePickerDisplayMode> display_mode: DatePickerDisplayMode.picker;
    in property <bool> show_mode_toggle: true;
    in property <bool> enforce_touch_target: true;
    in property <Date> selectable_from: { year: 1900, month: 1, day: 1 };
    in property <Date> selectable_to: { year: 2100, month: 12, day: 31 };
    in property <int> year_min: 1900;
    in property <int> year_max: 2100;
    // `DatePickerColors.selectedDayContainerColor`
    in property <brush> selected_day_container_color: DatePickerModalTokens.date_selected_container_color;

    callback date_selected(date: Date);

    property <bool> input_mode: root.display_mode == DatePickerDisplayMode.input;
    // `displayMode == DisplayMode.Picker` with the year grid open — the
    // `YearPickerMenuButton` toggles it; `in-out` so hosts can declare it.
    in-out property <bool> year_selection;
    property <[int]> today_items: DatePickerAdapter.date_now();
    property <Date> effective_today: root.today.year > 0 ? root.today
        : root.today_items.length >= 3 ? { day: root.today_items[0], month: root.today_items[1], year: root.today_items[2] }
        : { year: 0, month: 0, day: 0 };
    property <bool> previous_available: root.displayed_date.year > root.year_min || root.displayed_date.month > 1;
    property <bool> next_available: root.displayed_date.year < root.year_max || root.displayed_date.month < 12;
    property <bool> has_selection: CalendarMath.valid_date(root.selected_date);

    min_width: DatePickerModalTokens.container_width;
    min_height: header.height + content.height;
    background-rect := Rectangle {
        width: 100%;
        height: 100%;
        background: DatePickerModalTokens.container_color;
    }

    header := DatePickerHeader {
        x: 0;
        y: 0;
        width: parent.width;
        // `Strings.DatePickerTitle`/`DateInputTitle` are both "Select date"
        // in the pin — the title does not change with the display mode.
        title: root.show_title ? root.title : "";
        input_mode: root.input_mode;
        show_mode_toggle: root.show_mode_toggle;
        // Empty headline: `Strings.DatePickerHeadline` "Selected date" /
        // `Strings.DateInputHeadline` "Entered date".
        headline_text: root.has_selection ? CalendarMath.format_date(root.selected_date) : (root.input_mode ? @tr("Entered date") : @tr("Selected date"));
        enforce_touch_target: root.enforce_touch_target;

        toggle_input_mode => {
            root.display_mode = root.input_mode ? DatePickerDisplayMode.picker : DatePickerDisplayMode.input;
        }
    }

    content := Rectangle {
        x: 0;
        y: header.height;
        width: parent.width;
        // InputTextFieldPadding (top 10, bottom 16 when no error) + the
        // ~80dp field (label zone + border box + supporting reserve);
        // picker is navigation (56) + year grid (335) or the weekday
        // row (48) + day grid (288).
        height: root.input_mode ? 106px : (root.year_selection ? 391px : 392px);

        if !root.input_mode : picker_content := DatePickerContent {
            width: parent.width;
            selected: root.selected_date;
            today: root.effective_today;
            month: root.displayed_date.month;
            year: root.displayed_date.year;
            year_picker_visible: root.year_selection;
            previous_available: root.previous_available;
            next_available: root.next_available;
            enforce_touch_target: root.enforce_touch_target;
            selectable_from: root.selectable_from;
            selectable_to: root.selectable_to;
            current_year: root.effective_today.year;
            year_min: root.year_min;
            year_max: root.year_max;
            selected_color: root.selected_day_container_color;

            date_clicked(date) => {
                root.selected_date = date;
                root.date_selected(date);
            }

            month_navigated(month, year) => {
                root.displayed_date = { day: 1, month: month, year: year };
            }

            toggle_year_picker => {
                root.year_selection = !root.year_selection;
            }

            year_clicked(year) => {
                root.displayed_date = { day: 1, month: root.displayed_date.month, year: year };
                root.year_selection = false;
            }
        }

        // `DateInputContent` — `InputTextFieldPadding` start/end 24, top 10,
        // plus the non-error bottom padding of 16.
        if root.input_mode : input_area := Rectangle {
            width: parent.width;
            height: 10px + date_input.height + 16px;

            date_input := DateInputField {
                x: 24px;
                y: 10px;
                width: parent.width - 48px;
                text: root.has_selection ? CalendarMath.format_date_digits(root.selected_date) : "";
            }
        }
    }
}

/// The upstream `DateRangePicker` content widget: `DateEntryContainer` with
/// the 64dp-indented `TitleLarge` "start – end" headline, `WeekDays`, and the
/// vertical months list — each month headed by its subhead — with the
/// `SecondaryContainer` range band behind in-range days.
export component DateRangePicker {
    in property <string> title: @tr("Select dates");
    in property <bool> show_title: true;
    in-out property <Date> selected_start_date;
    in-out property <Date> selected_end_date;
    in property <Date> displayed_date: { day: 1, month: 12, year: 2025 };
    in property <Date> today;
    in property <int> months_to_show: 3;
    in property <bool> show_mode_toggle: true;
    in property <bool> enforce_touch_target: true;
    in-out property <DatePickerDisplayMode> display_mode: DatePickerDisplayMode.picker;
    in property <Date> selectable_from: { year: 1900, month: 1, day: 1 };
    in property <Date> selectable_to: { year: 2100, month: 12, day: 31 };
    // `DatePickerColors.selectedDayContainerColor` /
    // `dayInSelectionRangeContainerColor`
    in property <brush> selected_day_container_color: DatePickerModalTokens.date_selected_container_color;
    in property <brush> day_in_range_container_color: DatePickerModalTokens.range_selection_active_indicator_container_color;

    callback range_selected(start: Date, end: Date);

    property <bool> input_mode: root.display_mode == DatePickerDisplayMode.input;
    property <length> cell: root.enforce_touch_target ? 48px : 40px;
    property <[int]> today_items: DatePickerAdapter.date_now();
    property <Date> effective_today: root.today.year > 0 ? root.today
        : root.today_items.length >= 3 ? { day: root.today_items[0], month: root.today_items[1], year: root.today_items[2] }
        : { year: 0, month: 0, day: 0 };
    property <bool> has_start: CalendarMath.valid_date(root.selected_start_date);
    property <bool> has_end: CalendarMath.valid_date(root.selected_end_date);

    // The `LazyColumn` reports an unbounded preferred height: the picker's
    // natural size covers every `months_to_show` block, and `months_area`
    // clips at whatever the parent actually allots. The reported minimum
    // caps at the dialog's 520dp content bound (`ContainerHeight` 568 minus
    // the 48dp action row the dialog adds) — like the upstream list
    // claiming every leftover pixel inside `heightIn(max = 568)`.
    property <length> months_natural: 48px + root.months_to_show * (48px + 288px);

    min_width: DatePickerModalTokens.container_width;
    min_height: min(header.height + (root.input_mode ? 106px : root.months_natural),
        DatePickerModalTokens.container_height - 48px);

    background-rect := Rectangle {
        width: 100%;
        height: 100%;
        background: DatePickerModalTokens.container_color;
    }

    header := DatePickerHeader {
        x: 0;
        y: 0;
        width: parent.width;
        range: true;
        title_start_padding: 64px; // DateRangePickerTitlePadding/HeadlinePadding start
        title: root.show_title ? (root.input_mode ? @tr("Enter dates") : root.title) : "";
        input_mode: root.input_mode;
        show_mode_toggle: root.show_mode_toggle;
        headline_start: root.has_start ? CalendarMath.format_date(root.selected_start_date) : "";
        headline_end: root.has_end ? CalendarMath.format_date(root.selected_end_date) : "";
        enforce_touch_target: root.enforce_touch_target;

        toggle_input_mode => {
            root.display_mode = root.input_mode ? DatePickerDisplayMode.picker : DatePickerDisplayMode.input;
        }
    }

    months_area := Rectangle {
        x: 0;
        y: header.height;
        width: parent.width;
        clip: true;

        // `WeekDays` stays pinned over the scrolling `VerticalMonthsList`
        // — each month is a `RangeSelectionMonthSubhead` ("October 2026",
        // padding start 24 / top 20 / bottom 8) over its `Month` grid.
        // The `LazyColumn` fills whatever height the parent leaves it: the
        // dialog clamps at 568 and the list shows a clipped trailing month.
        property <length> month_block: 48px + 288px;
        height: root.input_mode ? 106px
            : min(root.months_natural, max(0px, parent.height - 69px));

        if !root.input_mode : weekdays := WeekdayRow {
            x: 12px;
            y: 0;
            width: parent.width - 24px;
            cell: root.cell;
        }

        if !root.input_mode : scroll := ScrollView {
            x: 12px;
            y: 48px;
            width: parent.width - 24px;
            height: parent.height - 48px;
            content_width: self.width;
            content_height: root.months_to_show * parent.month_block;

            for index in root.months_to_show : month_block := Rectangle {
                property <int> row_month: mod(root.displayed_date.month - 1 + index, 12) + 1;
                property <int> row_year: root.displayed_date.year + floor((root.displayed_date.month - 1 + index) / 12);

                x: 0;
                y: index * (28px + 288px + 20px);
                width: parent.width;
                height: 20px + 8px + 20px + 288px;

                MaterialText {
                    x: 24px;
                    y: 20px;
                    height: 20px;
                    style: DatePickerModalTokens.range_selection_month_subhead_font;
                    color: DatePickerModalTokens.range_selection_month_subhead_color;
                    text: CalendarMath.format_month_year(parent.row_month, parent.row_year);
                }

                CalendarMonth {
                    x: 0;
                    y: 48px;
                    width: parent.width;
                    range: true;
                    selected_color: root.selected_day_container_color;
                    range_band_color: root.day_in_range_container_color;
                    month: parent.row_month;
                    year: parent.row_year;
                    selected: root.selected_start_date;
                    selected_end: root.selected_end_date;
                    today: root.effective_today;
                    enforce_touch_target: root.enforce_touch_target;
                    selectable_from: root.selectable_from;
                    selectable_to: root.selectable_to;

                    date_clicked(date) => {
                        // upstream updateDateSelection
                        if (!root.has_start || root.has_end) {
                            root.selected_start_date = date;
                            root.selected_end_date = { year: 0, month: 0, day: 0 };
                            root.range_selected(date, { year: 0, month: 0, day: 0 });
                        } else if (CalendarMath.compare(date, root.selected_start_date) >= 0) {
                            root.selected_end_date = date;
                            root.range_selected(root.selected_start_date, date);
                        } else {
                            root.selected_start_date = date;
                            root.selected_end_date = { year: 0, month: 0, day: 0 };
                            root.range_selected(date, { year: 0, month: 0, day: 0 });
                        }
                    }
                }
            }
        }

        // `DateRangeInputContent` — `InputTextFieldPadding` row of two
        // `weight(0.5f)` fields at `TextFieldSpacing` (8dp), "Start date"
        // and "End date" labeled.
        if root.input_mode : input_area := Rectangle {
            width: parent.width;
            height: 10px + date_input_start.height + 16px;

            property <length> field_w: (parent.width - 48px - 8px) / 2;

            date_input_start := DateInputField {
                x: 24px;
                y: 10px;
                width: parent.field_w;
                label_text: @tr("Start date");
                text: root.has_start ? CalendarMath.format_date_digits(root.selected_start_date) : "";
            }

            date_input_end := DateInputField {
                x: 24px + parent.field_w + 8px;
                y: 10px;
                width: parent.field_w;
                label_text: @tr("End date");
                text: root.has_end ? CalendarMath.format_date_digits(root.selected_end_date) : "";
            }
        }
    }
}

/// The surface + action row of the upstream `DatePickerDialog`
/// (`requiredWidth 360`, `heightIn(max 568)`, CornerExtraLarge,
/// `containerColor`, Level0; end-aligned `FlowRow` of buttons with
/// `DialogButtonsPadding` bottom 8 / end 6 and 8dp spacing). Rendered
/// standalone it is the parity-testable form; `DatePickerDialog` wraps it
/// in a modal `PopupWindow`.
export component DatePickerDialogContent inherits Rectangle {
    in property <string> confirm_text: @tr("OK");
    in property <string> dismiss_text: @tr("Cancel");
    in property <bool> confirm_enabled: true;
    in property <bool> enforce_touch_target: true;
    // The `DatePickerDialog` `colors.containerColor`/`shape` params —
    // `DatePickerModalTokens.ContainerColor`/`ContainerShape` by default.
    in property <brush> container_color: DatePickerModalTokens.container_color;
    in property <MaterialCornerShape> container_shape: DatePickerModalTokens.container_shape;
    // `DialogButtonsMainAxisSpacing`
    in property <length> actions_spacing: 8px;

    callback confirm_clicked();
    callback dismiss_clicked();

    width: DatePickerModalTokens.container_width;
    // `heightIn(max)` wraps the integer-measured column; ceiling here keeps
    // the centered surface on the physical-pixel grid like Compose's
    // integer-placed bounds.
    height: min(Math.ceil(surface_column.min_height / 1px) * 1px, DatePickerModalTokens.container_height);
    border_radius: root.container_shape.top_left;
    clip: true;
    background: root.container_color;

    animate opacity { enabled: !MaterialPalette.reduced-motion; duration: MaterialAnimations.opacity_duration; easing: MaterialAnimations.opacity_easing; }

    surface_column := VerticalLayout {
        @children

        if root.confirm_text != "" || root.dismiss_text != "" : buttons := HorizontalLayout {
            alignment: end;
            padding_right: 6px;
            padding_bottom: 8px;
            spacing: root.actions_spacing;

            if root.dismiss_text != "" : dismiss_button := TextButton {
                text: root.dismiss_text;
                enforce_touch_target: root.enforce_touch_target;
                // `AlertDialogFlowRow` actions use the stable overload.
                expressive: false;

                clicked => {
                    root.dismiss_clicked();
                }
            }

            if root.confirm_text != "" : confirm_button := TextButton {
                text: root.confirm_text;
                enabled: root.confirm_enabled;
                enforce_touch_target: root.enforce_touch_target;
                expressive: false;

                clicked => {
                    root.confirm_clicked();
                }
            }
        }
    }
}

/// The upstream `DatePickerDialog`: `BasicAlertDialog` semantics with
/// `usePlatformDefaultWidth = false` around `DatePickerDialogContent`.
/// Pass a `DatePicker` or `DateRangePicker` as the child.
export component DatePickerDialog inherits PopupWindow {
    in property <string> confirm_text: @tr("OK");
    in property <string> dismiss_text: @tr("Cancel");
    in property <bool> confirm_enabled: true;
    in property <bool> enforce_touch_target: true;

    callback dismissed();
    callback confirm_clicked();
    callback dismiss_clicked();

    close_policy: no_auto_close;
    forward_focus: focus_scope;

    focus_scope := FocusScope {
        x: 0;
        width: 0;

        key_pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                root.dismissed();
                return accept;
            }

            if event.text == Key.Return && root.confirm_text != "" {
                root.confirm_clicked();
                return accept;
            }

            reject
        }
    }

    modal := Modal {
        width: 100%;
        height: 100%;

        dialog_content := DatePickerDialogContent {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: 0;
            confirm_text: root.confirm_text;
            dismiss_text: root.dismiss_text;
            confirm_enabled: root.confirm_enabled;
            enforce_touch_target: root.enforce_touch_target;

            confirm_clicked => {
                root.confirm_clicked();
            }

            dismiss_clicked => {
                root.close();
                root.dismissed();
            }

            @children
        }

        clicked => {
            root.close();
            root.dismissed();
        }
    }

    Timer {
        interval: 50ms;

        triggered => {
            dialog_content.opacity = 1;
            self.running = false;
        }
    }
}

/// Backward-compatible single-date popup over the reworked internals.
/// Prefer `DatePickerDialog` + `DatePicker` in new code.
export component DatePickerPopup inherits PopupWindow {
    in property <string> title;
    in property <Date> date: { day: today_items[0], month: today_items[1], year: today_items[2] };

    callback canceled();
    callback accepted(date: Date);

    property <[int]> today_items: DatePickerAdapter.date_now();
    property <Date> selected_date: root.date;
    property <Date> display_date: root.date;
    property <bool> selection_mode: true;

    close_policy: no_auto_close;
    forward_focus: focus_scope;

    focus_scope := FocusScope {
        x: 0;
        width: 0;

        key_pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                root.canceled();
                return accept;
            }

            reject
        }
    }

    modal := Modal {
        width: 100%;
        height: 100%;

        dialog_content := DatePickerDialogContent {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: 0;
            dismiss_text: @tr("Cancel");
            confirm_text: @tr("OK");

            confirm_clicked => {
                root.close();
                root.accepted(root.selected_date);
            }

            dismiss_clicked => {
                root.close();
                root.canceled();
            }

            picker := DatePicker {
                title: root.title != "" ? root.title : @tr("Select date");
                selected_date <=> root.selected_date;
                displayed_date <=> root.display_date;
                display_mode: root.selection_mode ? DatePickerDisplayMode.picker : DatePickerDisplayMode.input;
            }
        }

        clicked => {
            root.close();
            root.canceled();
        }
    }

    Timer {
        interval: 50ms;

        triggered => {
            dialog_content.opacity = 1;
            self.running = false;
        }
    }

    changed date => {
        root.display_date = root.date;
        root.selected_date = root.date;
    }

    public function get_current_date() -> Date {
        root.selected_date
    }
}