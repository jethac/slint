import { MaterialButtonBase } from "./button_base.slint";
import { MaterialButtonMetrics, MaterialButtonShape, MaterialButtonSize } from "./button_metrics.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { TextButtonTokens } from "../styling/generated/material_component_tokens.slint";

/// The lowest-emphasis button — the upstream `TextButton`. There is no text
/// toggle upstream, so `checkable` isn't offered here.
export component TextButton {
    in property <string> text;
    /// An optional leading icon.
    in property <image> icon;
    /// One of the five container heights (32/40/56/96/136).
    in property <MaterialButtonSize> size: MaterialButtonSize.small;
    /// `round` is the resting stadium shape; `square` the squarer variant.
    in property <MaterialButtonShape> button_shape: MaterialButtonShape.round;
    in property <bool> enabled: true;
    /// Swap the label color for dark surfaces (snackbars and the like).
    in property <bool> inverse;
    in property <string> tooltip;
    /// Reserve a 48x48 touch target around the visual (default on).
    in property <bool> enforce_touch_target: true;
    /// See `MaterialButtonBase.simulate_hover` / `simulate_press` —
    /// the parity harness's per-widget state hook.
    in property <bool> simulate_hover;
    in property <bool> simulate_press;
    /// `false` selects the stable `TextButton` overload (Button.kt):
    /// fixed `TextButtonContentPadding` 12x8 and a constant
    /// `ContainerShapeRound` — no pressed morph. Upstream dialogs, menus
    /// and pickers all use the stable overload; `true` (default) is the
    /// expressive `TextButton(shapes)` overload the button scenes exercise.
    in property <bool> expressive: true;

    callback clicked <=> base.clicked;

    out property <bool> has_focus <=> base.has_focus;
    out property <bool> pressed <=> base.pressed;
    out property <bool> has_hover <=> base.has_hover;
    /// The live corner radius — for the parity harness's motion trace.
    out property <length> container_radius <=> base.container_radius;

    accessible-label: root.text == "" ? root.tooltip : root.text;
    accessible-role: AccessibleRole.button;
    accessible-enabled: root.enabled;
    accessible-action-default => { base.clicked(); }

    min_width: base.min_width;
    min_height: base.min_height;
    preferred_width: base.preferred_width;
    preferred_height: base.preferred_height;

    base := MaterialButtonBase {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        tooltip: root.tooltip;
        enforce_touch_target: root.enforce_touch_target;
        simulate_hover: root.simulate_hover;
        simulate_press: root.simulate_press;

        container_height: MaterialButtonMetrics.container-height(root.size);
        resting_radius: MaterialButtonMetrics.resting-radius(root.size, root.button_shape, self.container_height);
        pressed_radius: root.expressive ? MaterialButtonMetrics.pressed-radius(root.size, false)
            : MaterialButtonMetrics.resting-radius(root.size, root.button_shape, self.container_height);
        checked_radius: MaterialButtonMetrics.checked-radius(root.size);
        min_button_width: 58px; // `ButtonDefaults.MinWidth`

        container_color: transparent;
        // `defaultTextButtonColors` hard-codes `ColorSchemeKeyTokens.Primary`
        // ("TODO replace with the token value once it's corrected" upstream).
        content_color: root.inverse ? MaterialPalette.inverse_primary : MaterialPalette.primary;
        disabled_container_color: transparent;
        disabled_content_color: TextButtonTokens.disabled_label_color.with_alpha(TextButtonTokens.disabled_label_opacity);
        elevation_default: 0;
        elevation_pressed: 0;
        elevation_hovered: 0;
        elevation_focused: 0;
        elevation_disabled: 0;

        text: root.text;
        icon: root.icon;
        // Expressive: `contentPaddingFor(h)` bucket padding. Stable:
        // `TextButtonContentPadding` = 12 horizontal x `ButtonVerticalPadding`
        // 8 vertical (Button.kt).
        padding_horizontal: root.expressive ? MaterialButtonMetrics.horizontal-padding(root.size) : 12px;
        padding_vertical: root.expressive ? MaterialButtonMetrics.vertical-padding(root.size) : 8px;
        icon_size: MaterialButtonMetrics.icon-size(root.size);
        icon_spacing: MaterialButtonMetrics.icon-spacing(root.size);
        label_style: MaterialButtonMetrics.label-style(root.size, false);
    }
}
