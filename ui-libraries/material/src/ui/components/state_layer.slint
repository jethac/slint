import { MaterialAnimations } from "../styling/material_animations.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialFocusIndicator, MaterialFocusRing } from "../styling/generated/material_state_tokens.slint";
import { ToolTip } from "./tooltip.slint";
import { MaterialWindowAdapter } from "./material_window.slint";

export component Ripple {
    in property <length> border_radius;
    in property <length> pressed_x;
    in property <length> pressed_y;
    in property <color> color;
    in property <bool> clip_ripple: true;

    // Unbounded ink for inline surfaces (e.g. icon buttons): the circle is
    // meant to paint past the element bounds.
    if !root.clip_ripple : Rectangle {
        x: root.pressed_x  - self.width / 2;
        y: root.pressed_y  - self.height / 2;
        height: self.width;
        border_radius: self.width / 2;
        opacity: MaterialPalette.state_layer_opacity_press;
        background: root.color;
        width: 0px;

        init => {
            self.width =  root.width * 2 * 1.4142;
        }

        animate width { duration: MaterialAnimations.ripple_duration; easing: MaterialAnimations.ripple_easing; }
    }

    // Bounded overlay: a circle expanding from the press point until it
    // covers the whole element, clipped to the component's outline — its
    // `shape` when set, the border-radius rectangle otherwise.
    if root.clip_ripple : Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        border_radius: root.border_radius;
        shape: root.shape;
        shape-fit: root.shape-fit;

        ink := Rectangle {
            x: root.pressed_x - self.width / 2;
            y: root.pressed_y - self.height / 2;
            height: self.width;
            border_radius: self.width / 2;
            opacity: MaterialPalette.state_layer_opacity_press;
            background: root.color;
            width: 0px;

            // The settled circle covers the element: diameter = twice the
            // distance from the press point to the farthest corner.
            property <float> dx: Math.max(root.pressed_x / 1px, (root.width - root.pressed_x) / 1px);
            property <float> dy: Math.max(root.pressed_y / 1px, (root.height - root.pressed_y) / 1px);

            init => {
                self.width = Math.sqrt(dx * dx + dy * dy) * 2px;
            }

            animate width { enabled: !MaterialPalette.reduced-motion; duration: MaterialAnimations.ripple_duration; easing: MaterialAnimations.ripple_easing; }
        }
    }
}

export component StateLayer {
    in property <color> background;
    in property <length> border_radius;
    in property <bool> display_background: true;
    in property <bool> enabled;
    in property <bool> pressed;
    in property <bool> has_focus;
    in property <bool> has_hover;
    /// When true, focus is communicated by a `FocusRing` the caller draws
    /// and the opacity layer is skipped — the `InsetRing` ripple theme
    /// upstream (`RippleThemeConfiguration.Focus.InsetRing`).
    in property <bool> focus_ring;

    property <float> state_layer_opacity;

    Rectangle {
        width: 100%;
        height: 100%;
        opacity: root.state_layer_opacity;
        background: root.background;
        border_radius: root.border_radius;
        shape: root.shape;
        shape-fit: root.shape-fit;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        border_radius: root.border_radius;
        shape: root.shape;
        shape-fit: root.shape-fit;

        @children
    }

    // First matching state wins: `pressed` is deliberately first so an active
    // press suppresses the focus/hover overlay — the Ripple already paints
    // the pressed overlay, so the state layer contributes nothing while
    // pressed (matching Compose, where the ripple *is* the pressed layer).
    states [
        pressed when root.enabled && root.pressed : {
            root.state_layer_opacity: 0;
        }
        disabled when !root.enabled && root.display_background : {
            root.state_layer_opacity: MaterialPalette.state_layer_opacity_focus;
        }
        focus when root.enabled && root.has_focus && !root.focus_ring : {
            root.state_layer_opacity: MaterialPalette.state_layer_opacity_focus;
        }
        hover when root.enabled && root.has_hover && !MaterialWindowAdapter.disable_hover : {
            root.state_layer_opacity: MaterialPalette.state_layer_opacity_hover;
        }
    ]

    animate state_layer_opacity { enabled: !MaterialPalette.reduced-motion; duration: MaterialAnimations.opacity_duration; easing: MaterialAnimations.opacity_easing; }
}

/// The M3 inset focus ring (`RippleThemeConfiguration.Focus.InsetRing`):
/// two strokes drawn just inside the component's outline — an outer
/// `secondary` stroke flush to the edge and a thicker `on_secondary` stroke
/// one `inner_stroke_inset` behind it. `border_radius` follows the
/// component's current shape, so the ring morphs with it mid-animation.
/// This is a decoration only — place it over the container, after the state
/// layer, and show it while the component has keyboard focus.
export component FocusRing {
    in property <length> border_radius;
    property <MaterialFocusRing> ring: MaterialFocusIndicator.ring;

    // Upstream `BorderLogic` insets each stroke from the element edge by its
    // own inset and draws the inner stroke first: the inner band covers
    // `inner_stroke_inset..+inner_stroke_width` and the outer
    // `outer_stroke_inset..+outer_stroke_width` on top of it.
    Rectangle {
        property <length> inset: root.ring.inner_stroke_inset;
        x: inset;
        y: inset;
        width: parent.width - 2 * inset;
        height: parent.height - 2 * inset;
        background: transparent;
        border_width: root.ring.inner_stroke_width;
        border_radius: max(0px, root.border_radius - inset);
        border_color: MaterialPalette.on_secondary;
    }

    Rectangle {
        property <length> inset: root.ring.outer_stroke_inset;
        x: inset;
        y: inset;
        width: parent.width - 2 * inset;
        height: parent.height - 2 * inset;
        background: transparent;
        border_width: root.ring.outer_stroke_width;
        border_radius: max(0px, root.border_radius - inset);
        border_color: MaterialPalette.secondary;
    }
}

export component FocusTouchArea inherits TouchArea {
    out property <bool> has_focus <=> focus_scope.has_focus;
    out property <bool> enter_pressed;
    in property <string> tooltip;
    in property <length> tooltip_offset;

    callback key_pressed(KeyEvent) -> EventResult;

    forward_focus: focus_scope;

    focus_scope := FocusScope {
        x: 0;
        width: 0px;
        enabled: root.enabled;

        key_pressed(event) => {
            if !root.enabled {
                return reject;
            }

            if (event.text == " " || event.text == "\n") && !root.enter_pressed {
                root.enter_pressed = true;
                root.clicked();
                return accept;
            }

            root.key_pressed(event)
        }

        key_released(event) => {
            if !root.enabled {
                return reject;
            }

            if (event.text == " " || event.text == "\n") && root.enter_pressed {
                root.enter_pressed = false;
                return accept;
            }

            reject
        }
    }

    @children


    if root.tooltip != "" && root.has_hover && !MaterialWindowAdapter.disable_hover && !root.pressed : ToolTip {
        y: root.tooltip_offset;
        text: root.tooltip;
    }
}

export component StateLayerArea inherits FocusTouchArea {
    in property <color> color;
    in property <length> border_radius;
    in property <bool> transparent_background;
    in property <bool> display_background: true;
    in property <bool> clip_ripple: true;
    /// See `StateLayer.focus_ring`.
    in property <bool> focus_ring;
    /// Uniform corner radius used for the hit test. Upstream clips the
    /// component to its shape, so presses and hovers in the corner dead
    /// zones outside the shape never reach it; `0` keeps the plain
    /// rectangle behavior for unshaped surfaces.
    in property <length> hit_radius: 0px;
    /// Whether the current press landed inside the hit shape. Reset on the
    /// next `down` event; keyboard activation is always inside.
    out property <bool> pointer_inside: true;
    /// Test hook: drive the hover/press state layers without pointer input —
    /// a single pointer cannot hold several widgets in a state at once,
    /// while upstream's per-widget `InteractionSource` can.
    in property <bool> simulate_hover;
    in property <bool> simulate_press;
    /// `pressed` limited to pointer-downs that started inside the shape.
    out property <bool> effective_pressed: (root.pressed && root.pointer_inside) || root.enter_pressed || root.simulate_press;
    /// `has_hover` limited to pointer positions inside the shape.
    out property <bool> effective_hover: (root.has_hover && root.point_inside(root.mouse_x, root.mouse_y)) || root.simulate_hover;

    property <bool> popup_open;

    /// Hit test against the uniform-radius rounded rect this component is
    /// clipped to: a point inside the bounds is dead only when it falls in a
    /// corner zone outside the corner circle.
    public pure function point_inside(x: length, y: length) -> bool {
        let r = Math.min(root.hit_radius, Math.min(root.width, root.height) / 2);
        if r <= 0px {
            return true;
        }
        if (x >= r && x <= root.width - r) || (y >= r && y <= root.height - r) {
            return true;
        }
        let cx = x < r ? r : root.width - r;
        let cy = y < r ? r : root.height - r;
        let dx = x - cx;
        let dy = y - cy;
        return dx * dx + dy * dy <= r * r;
    }

    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.pointer_inside = root.point_inside(root.pressed_x, root.pressed_y);
        }
    }

    if !root.enabled || (root.enabled && (root.has_focus || root.effective_pressed || root.effective_hover)) : StateLayer {
        width: 100%;
        height: 100%;
        background: root.transparent_background ? transparent : root.color;
        border_radius: root.border_radius;
        shape: root.shape;
        shape-fit: root.shape-fit;
        enabled: root.enabled;
        pressed: root.effective_pressed;
        has_focus: root.has_focus;
        has_hover: root.effective_hover;
        display_background: root.display_background;
        focus_ring: root.focus_ring;
    }

    // ripple
    if root.enabled && root.effective_pressed : Ripple {
        pressed_x: root.pressed_x;
        pressed_y: root.pressed_y;
        width: 100%;
        height: 100%;
        border_radius: root.border_radius;
        shape: root.shape;
        shape-fit: root.shape-fit;
        color: root.color;
        clip_ripple: root.clip_ripple;
    }

    @children
}
