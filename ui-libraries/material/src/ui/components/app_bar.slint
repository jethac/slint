import { IconButton } from "./icon_button.slint";
import { IconButtonItem } from "./bottom_app_bar.slint";
import { IconButtonWidth, MaterialButtonMetrics, MaterialButtonSize } from "./button_metrics.slint";
import { MaterialText, TextMetrics } from "./material_text.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialAnimations } from "../styling/material_animations.slint";
import { MaterialStyleMetrics } from "../styling/material_style_metrics.slint";
import { MaterialTypeStyle, MaterialTypography } from "../styling/material_typography.slint";
import {
    AppBarLargeFlexibleTokens,
    AppBarLargeTokens,
    AppBarMediumFlexibleTokens,
    AppBarMediumTokens,
    AppBarSmallTokens,
    AppBarTokens,
} from "../styling/generated/material_component_tokens.slint";

/// The `TopAppBarScrollBehavior` variants of the pinned `AppBar.kt`.
/// Slint has no nested-scroll chain, so the bar reads the scrolled content's
/// position through `scroll-position` and consumes the deltas itself:
/// - `pinned`: `contentOffset` only — the container recolors when content
///   slides underneath.
/// - `enter-always`: consumes in both directions, like Compose's
///   `onPreScroll` — the bar collapses and expands before the content moves.
///   Note the visual difference against Compose: the scrollable content
///   cannot wait for the bar, so it moves at the same time rather than
///   after the bar finishes.
/// - `exit-until-collapsed`: collapses while scrolling down and only
///   expands back when the content is scrolled all the way to the top.
export enum TopAppBarScrollBehavior { pinned, exit-until-collapsed, enter-always }

/// Constants and easing math of the pinned `AppBar.kt`
/// (`androidx.compose.material3`, androidx/androidx
/// 23327507f7fc7d5b19d65fec4b090f60c970079b).
global AppBarMetrics {
    /// `TopAppBarHorizontalPadding`.
    pure public function horizontal-padding() -> length {
        4px
    }
    /// `TopAppBarTitleInset` = 16dp - TopAppBarHorizontalPadding.
    pure public function title-inset() -> length {
        12px
    }
    /// `MediumTitleBottomPadding`.
    pure public function medium-title-bottom-padding() -> length {
        24px
    }
    /// `LargeTitleBottomPadding`.
    pure public function large-title-bottom-padding() -> length {
        28px
    }

    /// `TopTitleAlphaEasing` = `CubicBezierEasing(0.8, 0, 0.8, 0.15)`: the
    /// collapsed-row title fades back in only near the end of the collapse.
    public pure function top-title-alpha(fraction: float) -> float {
        MaterialAnimations.cubic-bezier-easing(0.8, 0, 0.8, 0.15, fraction)
    }

    /// `TopAppBarColors.containerColor()` lerps through
    /// `FastOutLinearInEasing` = `CubicBezierEasing(0.4, 0, 1, 1)`.
    public pure function color-transition-easing(fraction: float) -> float {
        MaterialAnimations.cubic-bezier-easing(0.4, 0, 1, 1, fraction)
    }

}

/// One `TopAppBarLayout` row — the pinned `TopAppBarMeasurePolicy`: the
/// navigation icon sits at the start of the row, the actions at the end, and
/// the title is aligned across the full row width, then clamped between the
/// two.
component AppBarRowLayout inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <MaterialTypeStyle> title-style;
    in property <MaterialTypeStyle> subtitle-style;
    in property <color> title-color: AppBarTokens.title-color;
    in property <color> subtitle-color: AppBarTokens.subtitle-color;
    in property <color> navigation-icon-color: AppBarTokens.leading-icon-color;
    in property <color> action-icon-color: AppBarTokens.trailing-icon-color;
    in property <IconButtonItem> leading-button;
    in property <[IconButtonItem]> trailing-buttons;
    in property <TextHorizontalAlignment> title-horizontal-alignment: left;
    in property <bool> title-vertical-bottom;
    in property <length> title-bottom-padding;
    in property <float> title-alpha: 1;
    in property <length> row-height;           // `height` in the MeasurePolicy
    in property <length> scrolled-offset: 0;   // `scrolledOffset`, <= 0
    in property <bool> touch-target: true;

    callback leading-button-clicked();
    callback trailing-button-clicked(index: int);

    property <bool> has-leading:
        root.leading-button.icon.width > 0 && root.leading-button.icon.height > 0;

    // The title placeable is a Column of the title and subtitle lines.
    out property <length> title-block-width:
        max(title-text.min-width, subtitle-text.min-width) +
        2 * AppBarMetrics.horizontal-padding();
    out property <length> title-block-height:
        (root.title != "" ? title-text.min-height : 0px) +
        (root.subtitle != "" ? subtitle-text.min-height : 0px);

    // maxLayoutHeight = max(height, titleHeight)
    out property <length> max-layout-height: max(root.row-height, root.title-block-height);
    // layoutHeight = maxLayoutHeight + heightOffset, coerceAtLeast(0)
    out property <length> layout-height: max(0px, root.max-layout-height + root.scrolled-offset);

    // start = max(TopAppBarTitleInset, navigationIcon.width) + startPadding
    property <length> title-start-space:
        max(AppBarMetrics.title-inset(), nav-box.width);
    property <length> title-end-space: actions-box.width;

    // `titleHorizontalAlignment.align(size, space)` over the full row width.
    property <length> aligned-title-x:
        root.title-horizontal-alignment == TextHorizontalAlignment.center ?
            (root.width - title-block.width) / 2 :
        root.title-horizontal-alignment == TextHorizontalAlignment.right ?
            root.width - title-block.width :
            0px;
    // Clamp between the navigation icon and the actions.
    out property <length> title-x:
        root.aligned-title-x < root.title-start-space ?
            root.title-start-space :
            root.aligned-title-x + title-block.width > root.width - root.title-end-space ?
                root.width - root.title-end-space - title-block.width :
                root.aligned-title-x;

    // `Arrangement.Bottom` counts `titleBottomPadding` down from the title
    // block's last baseline and shrinks it when the padded block would not
    // fit the layout height.
    property <length> last-baseline-from-bottom: root.subtitle != "" ?
        TextMetrics.baseline-to-bottom(root.subtitle-style) :
        TextMetrics.baseline-to-bottom(root.title-style);
    property <length> padding-from-bottom:
        root.title-bottom-padding - root.last-baseline-from-bottom;
    property <length> adjusted-bottom-padding:
        root.padding-from-bottom + root.title-block-height > root.max-layout-height ?
            root.padding-from-bottom -
                (root.padding-from-bottom + root.title-block-height - root.max-layout-height) :
            root.padding-from-bottom;
    out property <length> title-y:
        !root.title-vertical-bottom ? (root.layout-height - root.title-block-height) / 2 :
        root.title-bottom-padding == 0 ? root.layout-height - root.title-block-height :
        root.layout-height - root.title-block-height - max(0px, root.adjusted-bottom-padding);

    height: root.layout-height;
    clip: true;

    nav-box := Rectangle {
        x: 0;
        y: 0;
        width: root.has-leading ? AppBarMetrics.horizontal-padding() + leading.width : 0px;
        height: 100%;

        leading := IconButton {
            x: AppBarMetrics.horizontal-padding();
            y: (root.layout-height - self.height) / 2;
            visible: root.has-leading;
            icon: root.leading-button.icon;
            enabled: root.leading-button.enabled;
            tooltip: root.leading-button.tooltip;
            content-color: root.navigation-icon-color;
            enforce-touch-target: root.touch-target;

            clicked => { root.leading-button-clicked(); }
        }
    }

    title-block := Rectangle {
        x: root.title-x;
        y: root.title-y;
        width: min(root.title-block-width,
            max(0px, root.width - root.title-start-space - root.title-end-space));
        height: root.title-block-height;
        opacity: root.title-alpha;
        clip: true;

        title-text := MaterialText {
            x: AppBarMetrics.horizontal-padding();
            y: 0;
            width: parent.width - 2 * AppBarMetrics.horizontal-padding();
            text: root.title;
            style: root.title-style;
            color: root.title-color;
            horizontal-alignment: root.title-horizontal-alignment;
            // `elide` would report a collapsible min-width — the layout
            // measures the title's full advance, the clipped block bounds it.
            overflow: clip;
        }
        subtitle-text := MaterialText {
            x: AppBarMetrics.horizontal-padding();
            y: root.title != "" ? title-text.min-height : 0px;
            width: parent.width - 2 * AppBarMetrics.horizontal-padding();
            text: root.subtitle;
            style: root.subtitle-style;
            color: root.subtitle-color;
            horizontal-alignment: root.title-horizontal-alignment;
            visible: root.subtitle != "";
            overflow: clip;
        }
    }

    property <length> icon-slot-width: root.touch-target ? MaterialStyleMetrics.size-48 :
        MaterialButtonMetrics.icon-container-width(MaterialButtonSize.small, IconButtonWidth.uniform);

    actions-box := Rectangle {
        x: root.width - self.width;
        y: 0;
        width: root.trailing-buttons.length > 0 ?
            root.trailing-buttons.length * root.icon-slot-width +
            AppBarMetrics.horizontal-padding() : 0px;
        height: 100%;

        for item[index] in root.trailing-buttons : IconButton {
            x: index * root.icon-slot-width;
            y: (root.layout-height - self.height) / 2;
            width: root.icon-slot-width;
            icon: item.icon;
            enabled: item.enabled;
            tooltip: item.tooltip;
            content-color: root.action-icon-color;
            enforce-touch-target: root.touch-target;

            clicked => { root.trailing-button-clicked(index); }
        }
    }
}

/// The shared top-app-bar container: the surface, the scroll-offset state,
/// and the collapsed/expanded rows of the pinned `AppBar.kt`.
component TopAppBarBase {
    in property <string> title;
    in property <string> subtitle;
    in property <IconButtonItem> leading-button;
    in property <[IconButtonItem]> trailing-buttons;
    in property <TextHorizontalAlignment> title-horizontal-alignment: left;
    in property <MaterialTypeStyle> title-style;
    in property <MaterialTypeStyle> subtitle-style;
    in property <MaterialTypeStyle> small-title-style: AppBarSmallTokens.title-font;
    in property <MaterialTypeStyle> small-subtitle-style: AppBarSmallTokens.subtitle-font;
    in property <length> collapsed-height;
    in property <length> expanded-height;
    in property <length> title-bottom-padding;
    in property <bool> two-rows;
    in property <TopAppBarScrollBehavior> scroll-behavior: TopAppBarScrollBehavior.pinned;
    /// The scrolled amount of the content below the bar — bind
    /// `-flickable.content-y`.
    in property <length> scroll-position;
    in property <color> container-color: AppBarTokens.container-color;
    in property <color> scrolled-container-color: AppBarTokens.on-scroll-container-color;
    in property <color> navigation-icon-content-color: AppBarTokens.leading-icon-color;
    in property <color> title-content-color: AppBarTokens.title-color;
    in property <color> subtitle-content-color: AppBarTokens.subtitle-color;
    in property <color> action-icon-content-color: AppBarTokens.trailing-icon-color;
    /// `LocalMinimumInteractiveComponentSize` — off for parity scenes, like
    /// the Compose side setting it to 0.
    in property <bool> touch-target: true;

    callback leading-button-clicked();
    callback trailing-button-clicked(index: int);

    // `TopAppBarState`.
    in-out property <length> height-offset;
    in-out property <length> content-offset;
    /// The collapsible extent — the bottom row of a two-row bar, or the whole
    /// single-row bar; the collapsed row never shrinks.
    property <length> collapsible-extent:
        root.two-rows ? root.expanded-height - root.collapsed-height : root.expanded-height;
    /// A pinned bar keeps `initialHeightOffsetLimit = 0f`; only collapsible
    /// bars get the negative limit (`AppBar.kt` `TopAppBarState`).
    out property <length> height-offset-limit:
        root.scroll-behavior == TopAppBarScrollBehavior.pinned ? 0px : -root.collapsible-extent;
    out property <float> collapsed-fraction: root.height-offset-limit != 0px ?
        min(1, max(0, root.height-offset / root.height-offset-limit)) : 0;
    /// `TopAppBarState.overlappedFraction`: 1 when content moved but the bar's
    /// own offset didn't (the pinned-overlap case), the height-limit fraction
    /// for collapsible bars, else 0. `scroll-position` is the scrolled
    /// content's offset — `isScrollingContentAtStart()` inverts it.
    out property <float> overlapped-fraction:
        (root.scroll-position != 0px && root.content-offset == 0px) ? 1 :
        root.height-offset-limit != 0px ?
            1 - (root.height-offset-limit + abs(root.content-offset))
                .clamp(root.height-offset-limit, 0px) / root.height-offset-limit : 0;

    // The displayed offset: `height-offset` plus the settle animation.
    property <length> effective-offset: root.height-offset + bg.settle-offset;
    property <length> last-scroll-position;
    changed scroll-position => {
        let delta = root.scroll-position - root.last-scroll-position;
        root.last-scroll-position = root.scroll-position;
        root.content-offset = root.scroll-position;
        if root.scroll-behavior == TopAppBarScrollBehavior.pinned {
            return;
        }
        if root.scroll-behavior == TopAppBarScrollBehavior.enter-always {
            // onPreScroll consumes deltas in both directions.
            root.height-offset =
                (root.height-offset - delta).clamp(root.height-offset-limit, 0px);
        } else {
            // ExitUntilCollapsed: collapse while scrolling down; the expand
            // leg runs through overscroll once the content reaches the top —
            // Slint's Flickable clamps at its bounds, so reaching the top is
            // the observable equivalent.
            if delta > 0px {
                root.height-offset =
                    (root.height-offset - delta).clamp(root.height-offset-limit, 0px);
            }
            if root.scroll-position <= 0px {
                root.height-offset = 0;
            }
        }
        settle-timer.restart();
    }

    /// `settleAppBar`: after a scroll ends, snap to the nearer end through
    /// the active scheme's default-effects spring (the
    /// `TopAppBarDefaults.snapAnimationSpec` token). The fling-decay leg has
    /// no scroll-velocity source in Slint and is omitted.
    function settle() {
        if root.collapsed-fraction < 0.01 || root.collapsed-fraction == 1 {
            return;
        }
        let target = root.collapsed-fraction < 0.5 ? 0px : root.height-offset-limit;
        if target != root.height-offset {
            bg.settle-offset = root.height-offset - target;
            root.height-offset = target;
            bg.settle-offset = 0;
        }
    }
    settle-timer := Timer {
        interval: 120ms;
        triggered => {
            root.settle();
            self.running = false;
        }
    }

    // Two-row bars lerp the container color directly by collapsedFraction
    // (through `FastOutLinearInEasing`); a single-row bar animates between
    // the two colors with the default-effects spring once content overlaps.
    property <color> target-container-color: root.two-rows ?
        root.container-color.mix(root.scrolled-container-color,
            1 - AppBarMetrics.color-transition-easing(root.collapsed-fraction)) :
        (root.overlapped-fraction > 0.01 ? root.scrolled-container-color : root.container-color);

    min-height: root.two-rows ?
        root.collapsed-height +
            max(0px, root.expanded-height - root.collapsed-height + root.effective-offset) :
        max(0px, root.expanded-height + root.effective-offset);

    bg := Rectangle {
        property <length> settle-offset;
        animate settle-offset {
            enabled: !MaterialPalette.reduced-motion;
            easing: MaterialAnimations.default-effects-spring;
        }

        width: 100%;
        height: 100%;
        background: root.target-container-color;
        animate background {
            enabled: !MaterialPalette.reduced-motion && !root.two-rows;
            easing: MaterialAnimations.default-effects-spring;
        }
        clip: true;

        // `appBarDragModifier`: vertically dragging the bar adjusts the
        // offset; releasing snaps it.
        if root.scroll-behavior != TopAppBarScrollBehavior.pinned : drag-area := TouchArea {
            width: 100%;
            height: 100%;
            property <length> drag-start-offset;
            moved => {
                if self.pressed {
                    root.height-offset =
                        (self.drag-start-offset + (self.mouse-y - self.pressed-y))
                            .clamp(root.height-offset-limit, 0px);
                }
            }
            changed pressed => {
                if self.pressed {
                    self.drag-start-offset = root.height-offset;
                } else {
                    root.settle();
                }
            }
        }

        if root.two-rows : top-row := AppBarRowLayout {
            y: 0;
            width: 100%;
            title: root.title;
            subtitle: root.subtitle;
            title-style: root.small-title-style;
            subtitle-style: root.small-subtitle-style;
            title-horizontal-alignment: root.title-horizontal-alignment;
            title-alpha: AppBarMetrics.top-title-alpha(root.collapsed-fraction);
            row-height: root.collapsed-height;
            leading-button: root.leading-button;
            trailing-buttons: root.trailing-buttons;
            navigation-icon-color: root.navigation-icon-content-color;
            title-color: root.title-content-color;
            subtitle-color: root.subtitle-content-color;
            action-icon-color: root.action-icon-content-color;
            touch-target: root.touch-target;

            leading-button-clicked => { root.leading-button-clicked(); }
            trailing-button-clicked(index) => { root.trailing-button-clicked(index); }
        }

        if root.two-rows : bottom-row := AppBarRowLayout {
            y: root.collapsed-height;
            width: 100%;
            title: root.title;
            subtitle: root.subtitle;
            title-style: root.title-style;
            subtitle-style: root.subtitle-style;
            title-horizontal-alignment: root.title-horizontal-alignment;
            title-vertical-bottom: true;
            title-bottom-padding: root.title-bottom-padding;
            title-alpha: 1 - root.collapsed-fraction;
            row-height: root.expanded-height - root.collapsed-height;
            scrolled-offset: root.effective-offset;
        }

        if !root.two-rows : single-row := AppBarRowLayout {
            y: 0;
            width: 100%;
            title: root.title;
            subtitle: root.subtitle;
            title-style: root.title-style;
            subtitle-style: root.subtitle-style;
            title-horizontal-alignment: root.title-horizontal-alignment;
            row-height: root.expanded-height;
            scrolled-offset: root.effective-offset;
            leading-button: root.leading-button;
            trailing-buttons: root.trailing-buttons;
            navigation-icon-color: root.navigation-icon-content-color;
            title-color: root.title-content-color;
            subtitle-color: root.subtitle-content-color;
            action-icon-color: root.action-icon-content-color;
            touch-target: root.touch-target;

            leading-button-clicked => { root.leading-button-clicked(); }
            trailing-button-clicked(index) => { root.trailing-button-clicked(index); }
        }
    }
}

/// `TopAppBar` — a small app bar with slots for a title, a subtitle, a
/// navigation icon and actions.
export component TopAppBar {
    in property <string> title;
    in property <string> subtitle;
    in property <IconButtonItem> leading-button;
    in property <[IconButtonItem]> trailing-buttons;
    in property <TextHorizontalAlignment> title-horizontal-alignment: left;
    in property <length> expanded-height: AppBarSmallTokens.container-height;
    in property <TopAppBarScrollBehavior> scroll-behavior: TopAppBarScrollBehavior.pinned;
    in property <length> scroll-position;
    in property <color> container-color: AppBarTokens.container-color;
    in property <color> scrolled-container-color: AppBarTokens.on-scroll-container-color;
    in property <color> navigation-icon-content-color: AppBarTokens.leading-icon-color;
    in property <color> title-content-color: AppBarTokens.title-color;
    in property <color> subtitle-content-color: AppBarTokens.subtitle-color;
    in property <color> action-icon-content-color: AppBarTokens.trailing-icon-color;
    in property <bool> touch-target: true;

    callback leading-button-clicked();
    callback trailing-button-clicked(index: int);

    in-out property <length> height-offset <=> base.height-offset;
    in-out property <length> content-offset <=> base.content-offset;
    out property <length> height-offset-limit <=> base.height-offset-limit;
    out property <float> collapsed-fraction <=> base.collapsed-fraction;
    out property <float> overlapped-fraction <=> base.overlapped-fraction;

    min-height: base.min-height;

    base := TopAppBarBase {
        width: 100%;
        height: 100%;
        title: root.title;
        subtitle: root.subtitle;
        leading-button: root.leading-button;
        trailing-buttons: root.trailing-buttons;
        title-horizontal-alignment: root.title-horizontal-alignment;
        title-style: AppBarSmallTokens.title-font;
        subtitle-style: AppBarSmallTokens.subtitle-font;
        collapsed-height: AppBarSmallTokens.container-height;
        expanded-height: root.expanded-height;
        scroll-behavior: root.scroll-behavior;
        scroll-position: root.scroll-position;
        container-color: root.container-color;
        scrolled-container-color: root.scrolled-container-color;
        navigation-icon-content-color: root.navigation-icon-content-color;
        title-content-color: root.title-content-color;
        subtitle-content-color: root.subtitle-content-color;
        action-icon-content-color: root.action-icon-content-color;
        touch-target: root.touch-target;

        leading-button-clicked => { root.leading-button-clicked(); }
        trailing-button-clicked(index) => { root.trailing-button-clicked(index); }
    }
}

/// `CenterAlignedTopAppBar` — a `TopAppBar` with a centered title.
export component CenterAlignedTopAppBar inherits TopAppBar {
    title-horizontal-alignment: center;
}

/// `TwoRowsTopAppBar` — the public two-row base bar: a small title in the
/// collapsed row and the large title (and optional subtitle) below it.
export component TwoRowsTopAppBar {
    in property <string> title;
    in property <string> subtitle;
    in property <IconButtonItem> leading-button;
    in property <[IconButtonItem]> trailing-buttons;
    in property <TextHorizontalAlignment> title-horizontal-alignment: left;
    in property <MaterialTypeStyle> title-style: AppBarMediumFlexibleTokens.title-font;
    in property <MaterialTypeStyle> subtitle-style: AppBarMediumFlexibleTokens.subtitle-font;
    in property <MaterialTypeStyle> small-title-style: AppBarSmallTokens.title-font;
    in property <MaterialTypeStyle> small-subtitle-style: AppBarSmallTokens.subtitle-font;
    in property <length> collapsed-height: AppBarSmallTokens.container-height;
    in property <length> expanded-height;
    in property <length> title-bottom-padding;
    in property <TopAppBarScrollBehavior> scroll-behavior: TopAppBarScrollBehavior.pinned;
    in property <length> scroll-position;
    in property <color> container-color: AppBarTokens.container-color;
    in property <color> scrolled-container-color: AppBarTokens.on-scroll-container-color;
    in property <color> navigation-icon-content-color: AppBarTokens.leading-icon-color;
    in property <color> title-content-color: AppBarTokens.title-color;
    in property <color> subtitle-content-color: AppBarTokens.subtitle-color;
    in property <color> action-icon-content-color: AppBarTokens.trailing-icon-color;
    in property <bool> touch-target: true;

    callback leading-button-clicked();
    callback trailing-button-clicked(index: int);

    in-out property <length> height-offset <=> base.height-offset;
    in-out property <length> content-offset <=> base.content-offset;
    out property <length> height-offset-limit <=> base.height-offset-limit;
    out property <float> collapsed-fraction <=> base.collapsed-fraction;
    out property <float> overlapped-fraction <=> base.overlapped-fraction;

    min-height: base.min-height;

    base := TopAppBarBase {
        width: 100%;
        height: 100%;
        two-rows: true;
        title: root.title;
        subtitle: root.subtitle;
        leading-button: root.leading-button;
        trailing-buttons: root.trailing-buttons;
        title-horizontal-alignment: root.title-horizontal-alignment;
        title-style: root.title-style;
        subtitle-style: root.subtitle-style;
        small-title-style: root.small-title-style;
        small-subtitle-style: root.small-subtitle-style;
        collapsed-height: root.collapsed-height;
        expanded-height: root.expanded-height;
        title-bottom-padding: root.title-bottom-padding;
        scroll-behavior: root.scroll-behavior;
        scroll-position: root.scroll-position;
        container-color: root.container-color;
        scrolled-container-color: root.scrolled-container-color;
        navigation-icon-content-color: root.navigation-icon-content-color;
        title-content-color: root.title-content-color;
        subtitle-content-color: root.subtitle-content-color;
        action-icon-content-color: root.action-icon-content-color;
        touch-target: root.touch-target;

        leading-button-clicked => { root.leading-button-clicked(); }
        trailing-button-clicked(index) => { root.trailing-button-clicked(index); }
    }
}

/// `MediumTopAppBar`.
export component MediumTopAppBar {
    in property <string> title;
    in property <IconButtonItem> leading-button;
    in property <[IconButtonItem]> trailing-buttons;
    in property <TextHorizontalAlignment> title-horizontal-alignment: left;
    in property <length> collapsed-height: AppBarSmallTokens.container-height;
