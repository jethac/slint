import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialStyleMetrics } from "../styling/material_style_metrics.slint";
import { StateLayerArea, FocusRing, MaterialCornerRadii } from "./state_layer.slint";

/// `Surface` (Surface.kt at the pin in `scripts/token-generator`): the
/// container metaphor — a shape-clipped background whose `color` picks up
/// `surfaceTint` via `tonal_elevation`, an optional ambient+spot
/// `shadow_elevation`, and an optional `border` stroke. The three
/// interactive upstream overloads map to `clickable`, `selectable`
/// (`selected`) and `toggleable` (`checked` flips on activation).
export component Surface {
    /// `color` — upstream defaults to `ColorScheme.surface`.
    in property <color> color: MaterialPalette.surface;
    /// `contentColor` — upstream's `contentColorFor(color)` falling back to
    /// `LocalContentColor.current`; Slint has no composition locals, so the
    /// fallback is `on_surface`. Bind `content_color` on children that
    /// should follow it (its `out` value is the resolved default).
    in-out property <color> content_color:
        MaterialPalette.content-color-for(root.color) != transparent ?
            MaterialPalette.content-color-for(root.color) : MaterialPalette.on_surface;
    /// `border` (`BorderStroke`): stroke drawn on top of the background.
    in property <length> border_width;
    in property <color> border_color;
    /// `shape` as a uniform corner radius; upstream `RectangleShape` is the
    /// 0 default. Per-corner radii via `corners` + `shaped_corners`, and
    /// `shape`/`shape-fit` pass through for `MaterialShapes` morphs.
    in property <length> border_radius;
    in property <MaterialCornerRadii> corners;
    in property <bool> shaped_corners;
    /// `tonalElevation`: when `color` is `surface`, the background shifts
    /// toward `surface_tint` by `(4.5 * ln(elevation + 1) + 2) / 100`
    /// (`ColorScheme.surfaceColorAtElevation`).
    in property <length> tonal_elevation;
    /// `shadowElevation`: the ambient+spot shadow below the surface.
    in property <length> shadow_elevation;
    /// `LocalTonalElevationEnabled` — `false` keeps `color` verbatim.
    in property <bool> tonal_elevation_enabled: true;
    /// `LocalAbsoluteTonalElevation`: a nested Surface binds its parent's
    /// `absolute_tonal_elevation` here — the tint key is the sum.
    in property <length> parent_absolute_tonal_elevation;
    /// `LocalAbsoluteTonalElevation` value this surface provides.
    out property <length> absolute_tonal_elevation: root.parent_absolute_tonal_elevation + root.tonal_elevation;

    /// `enabled` on the interactive overloads.
    in property <bool> enabled: true;
    /// The `onClick` overload — click handling, ripple, focus ring.
    in property <bool> clickable;
    /// The `selectable` overload — `selected` is caller-owned state.
    in property <bool> selectable;
    in-out property <bool> selected;
    /// The `toggleable` overload — `checked` flips on activation.
    in property <bool> toggleable;
    in-out property <bool> checked;
    /// `onClick`/`onValueChange`; emitted after `checked` flips.
    callback clicked();

    property <bool> interactive: root.clickable || root.selectable || root.toggleable;

    /// The tinted background — `applyTonalElevation` upstream: the tint
    /// applies only while the color is `surface` and elevation is on.
    out property <color> resolved_color:
        root.color == MaterialPalette.surface && root.tonal_elevation_enabled && root.absolute_tonal_elevation > 0px ?
            MaterialPalette.surface_tint.mix(MaterialPalette.surface, (4.5 * Math.ln(root.absolute_tonal_elevation / 1px + 1) + 2) / 100) :
            root.color;

    // `minimumInteractiveComponentSize` — 48x48 on the interactive
    // overloads only.
    min-width: root.interactive ? MaterialStyleMetrics.size_48 : 0px;
    min-height: root.interactive ? MaterialStyleMetrics.size_48 : 0px;

    // `isContainer = true` semantics upstream; `groupbox` is the matching
    // Slint role. `accessible-role` must be constant, so the clickable
    // overload's Button role can't be expressed here — the action is
    // still reachable through `accessible-action-default`.
    accessible-role: AccessibleRole.groupbox;
    accessible-enabled: root.enabled;
    accessible-checkable: root.selectable || root.toggleable;
    accessible-checked: root.selectable ? root.selected : root.checked;
    accessible-action-default => { root.activate(); }

    forward_focus: state_layer;

    // Shadow + background + border. `elevation` on the Rectangle lowers to
    // the same `ElevationShadow` the `Elevation` component uses (ambient +
    // spot at MaterialPalette.shadow); upstream gates the layer on
    // `shadowElevation > 0`, `elevation: 0` casts nothing.
    background_rect := Rectangle {
        width: 100%;
        height: 100%;
        background: root.resolved_color;
        border_width: root.border_width;
        border_color: root.border_color;
        border_radius: root.border_radius;
        border-top-left-radius: root.shaped_corners ? root.corners.top_left : root.border_radius;
        border-top-right-radius: root.shaped_corners ? root.corners.top_right : root.border_radius;
        border-bottom-right-radius: root.shaped_corners ? root.corners.bottom_right : root.border_radius;
        border-bottom-left-radius: root.shaped_corners ? root.corners.bottom_left : root.border_radius;
        shape: root.shape;
        shape-fit: ShapeFit.normalized;
        elevation: root.shadow_elevation;
        ambient-shadow-color: MaterialPalette.shadow;
        spot-shadow-color: MaterialPalette.shadow;
    }

    // `pointerInput(Unit) {}` upstream — a plain surface still claims the
    // pointer over its bounds. Children render after this sink, so they
    // see events first.
    TouchArea {
        width: 100%;
        height: 100%;
    }

    // The interactive overloads' `.clickable`/`.selectable`/`.toggleable`
    // layer: state layer + ripple in `content_color`, clipped to the
    // shape. Always instantiated so `forward_focus` has a target; a
    // non-interactive or disabled area lets events fall to the sink.
    state_layer := StateLayerArea {
        width: 100%;
        height: 100%;
        color: root.content_color;
        transparent_background: true;
        display_background: false;
        focus_ring: true;
        enabled: root.interactive && root.enabled;
        border_radius: root.border_radius;
        corners: root.corners;
        shaped_corners: root.shaped_corners;
        hit_radius: root.border_radius;
        hit_corners: root.corners;
        shape: root.shape;

        clicked => {
            root.activate();
        }
    }

    if root.interactive && state_layer.has_focus : FocusRing {
        width: 100%;
        height: 100%;
        border_radius: root.border_radius;
        corners: root.corners;
        shaped_corners: root.shaped_corners;
    }

    // `.clip(shape)` upstream — children never paint outside the outline.
    content_rect := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        border_radius: root.border_radius;
        border-top-left-radius: root.shaped_corners ? root.corners.top_left : root.border_radius;
        border-top-right-radius: root.shaped_corners ? root.corners.top_right : root.border_radius;
        border-bottom-right-radius: root.shaped_corners ? root.corners.bottom_right : root.border_radius;
        border-bottom-left-radius: root.shaped_corners ? root.corners.bottom_left : root.border_radius;
        shape: root.shape;
        shape-fit: ShapeFit.normalized;

        @children
    }

    function activate() {
        if root.toggleable {
            root.checked = !root.checked;
        }
        root.clicked();
    }
}
