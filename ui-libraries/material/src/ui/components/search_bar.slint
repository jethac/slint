import { ListItem } from "../items/list_item.slint";
import { Avatar, ListTile } from "./list.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialStyleMetrics } from "../styling/material_style_metrics.slint";
import { MaterialTypography } from "../styling/material_typography.slint";
import { StateLayerArea } from "./state_layer.slint";
import { MaterialText } from "./material_text.slint";
import { Icon } from "./icon.slint";
import { IconButton } from "./icon_button.slint";
import { MaterialButtonMetrics, IconButtonWidth, MaterialButtonSize } from "./button_metrics.slint";
import { Icons } from "../icons/icons.slint";
import { HorizontalDivider } from "./divider.slint";
import { ListView } from "./list_view.slint";
import { IconButtonItem } from "./bottom_app_bar.slint";
import { MaterialAnimations } from "../styling/material_animations.slint";
import {
    SearchBarTokens,
    SearchViewTokens,
    AppBarTokens,
    AppBarSmallTokens,
} from "../styling/generated/material_component_tokens.slint";
import { ShapeTokens } from "../styling/generated/material_shape_tokens.slint";

component SearchTile inherits ListTile {
    in property <image> action_button_icon;

    callback action_button_clicked();

    if root.action_button_icon.width > 0 && root.action_button_icon.height > 0 : IconButton {
        icon: root.action_button_icon;

        clicked => {
            root.action_button_clicked();
        }
    }
}

component SearchIcon {
    in property <image> icon;
    in property <color> color;

    VerticalLayout {
        alignment: center;
        padding_left: MaterialStyleMetrics.padding_8;
        padding_right: self.padding_left;

        Icon {
            // `Icon` defaults to 24dp — the search-bar field keeps the text
            // field's icon size.
            width: MaterialStyleMetrics.icon_size_24;
            source: root.icon;
            colorize: root.color;
        }
    }
}

component SearchTextInput  {
    in_out property <string> text <=> text_input.text;
    in property <string> placeholder_text;
    property <length> computed_x;

    callback accepted(text: string);
    callback edited(text: string);
    callback key_pressed(event: KeyEvent) -> EventResult;
    callback key_released(event: KeyEvent) -> EventResult;

    forward_focus: text_input;
    horizontal_stretch: 1;

    accessible-role: AccessibleRole.text-input;
    accessible-value <=> text;
    accessible-placeholder-text: placeholder_text;
    accessible-action-set-value(v) => { text = v; edited(v); }

    Rectangle {
        clip: true;

        text_input := TextInput {
            x: min(0px, max(parent.width - self.width - self.text_cursor_width, root.computed_x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            font_size: MaterialTypography.body_large.font_size;
            font_weight: MaterialTypography.body_large.font_weight;
            vertical_alignment: center;
            single_line: true;
            input-type: search;
            color: SearchBarTokens.input_text_color;
            selection_background_color: MaterialPalette.secondary_container;
            selection_foreground_color: self.color;
             // Disable TextInput's built-in accessibility support as the component takes care of that.
            accessible-role: none;

            cursor_position_changed(cursor_position) => {
                if cursor_position.x + root.computed_x < 0 {
                    root.computed_x = - cursor_position.x;
                } else if cursor-position.x + root.computed_x > parent.width - self.text-cursor-width {
                    root.computed_x = parent.width - cursor_position.x - self.text-cursor-width;
                }
            }

            accepted => {
                root.accepted(self.text);
            }

            edited => {
                root.edited(self.text);
            }

            key_pressed(event) => {
                root.key_pressed(event)
            }

            key_released(event) => {
                root.key_released(event)
            }

            init => {
                if root.text.character_count > 0 {
                    self.set_selection_offsets(root.text.character_count, root.text.character_count);
                }
            }
        }
        if root.text == "" && root.placeholder_text != "" : MaterialText {
            width: 100%;
            height: 100%;
            text: root.placeholder_text;
            color: SearchBarTokens.supporting_text_color;
            vertical_alignment: center;
            style: SearchBarTokens.supporting_text_font;
        }
    }
}

/// Which expanded surface a `SearchBar` opens when `expanded` becomes true —
/// `docked`, `docked-with-gap`, `full-screen` and
/// `full-screen-contained` mirror the `ExpandedDockedSearchBar`,
/// `ExpandedDockedSearchBarWithGap`, `ExpandedFullScreenSearchBar` and
/// `ExpandedFullScreenContainedSearchBar` composables; `none` shows the
/// collapsed bar only.
export enum SearchBarExpansion { none, docked, docked-with-gap, full-screen, full-screen-contained }

/// The expanded search surface shared by `SearchBar` and the exported
/// `Expanded*SearchBar` overlay components. Anchored at the collapsed bar's
/// position like the pin's `state.collapsedBounds.topLeft`.
component SearchViewPopup inherits PopupWindow {
    in property <SearchBarExpansion> expansion: SearchBarExpansion.docked;
    /// `SearchBarDefaults.dockedDropdownGapSize` — 2.dp in the pin.
    in property <length> dropdown-gap-size: 2px;
    in property <string> placeholder_text;
    in property <string> empty_text;
    in_out property <string> text;
    in property <[ListItem]> items;
    in property <bool> contained;
    /// Outer size of the popup; callers size `full-screen*` variants to the
    /// window.
    in property <length> expanded-width;
    in property <length> expanded-height;

    callback accepted(text: string);
    callback edited(text: string);
    callback action_button_clicked(index: int);
    callback item-activated(index: int) -> bool;
    callback closed();

    property <length> item_height: MaterialStyleMetrics.size_72;
    property <bool> full-screen: root.expansion == SearchBarExpansion.full-screen ||
        root.expansion == SearchBarExpansion.full-screen-contained;
    property <bool> with-gap: root.expansion == SearchBarExpansion.docked-with-gap;
    // `docked_header_container_height` / `full_screen_header_container_height`
    out property <length> header-height: root.full-screen ?
        SearchViewTokens.full_screen_header_container_height :
        SearchViewTokens.docked_header_container_height;
    property <length> content-height: clamp(root.item_height * root.items.length,
        3 * root.item_height, 6 * root.item_height);

    // The gap variant leaves `dropdown-gap-size` between the collapsed bar
    // and the dropdown surface.
    y: root.with-gap ? root.dropdown-gap-size : 0px;
    width: root.expanded-width;
    height: root.expanded-height > 0 ? root.expanded-height : root.header-height + root.content-height;
    close_policy: close_on_click_outside;

    container := Rectangle {
        width: 100%;
        height: 100%;
        background: root.contained ? MaterialPalette.surface : SearchViewTokens.container_color;
        border_radius: root.full-screen && !root.contained ? 0px : ShapeTokens.corner_extra_large.top_left;
        clip: true;

        VerticalLayout {
            header-row := HorizontalLayout {
                height: root.header-height;
                padding: MaterialStyleMetrics.padding_4;
                spacing: MaterialStyleMetrics.spacing_4;

                IconButton {
                    icon: Icons.arrow_back;

                    clicked => {
                        root.close();
                    }
                }

                popup_input := SearchTextInput {
                    placeholder_text: root.placeholder_text;
                    text: root.text;

                    accepted => {
                        root.accepted(self.text);
                    }
                    edited => {
                        root.text = self.text;
                        root.edited(self.text);
                    }
                    changed text => {
                        root.text = text;
                    }
                }

                IconButton {
                    icon: Icons.close;

                    clicked => {
                        root.text = "";
                        root.close();
                    }
                }
            }

            HorizontalDivider { }

            if root.items.length == 0 : MaterialText {
                text: root.empty_text;
                color: SearchViewTokens.header_supporting_text_color;
                horizontal_alignment: center;
                style: SearchViewTokens.header_supporting_text_font;
            }

            if root.items.length == 0 : Rectangle {}

            if root.items.length > 0 : ListView {
                horizontal_stretch: 1;

                for item[index] in root.items : SearchTile {
                    text: item.text;
                    supporting_text: item.supporting_text;
                    avatar_icon: item.avatar_icon;
                    avatar_text: item.avatar_text;
                    avatar_background: item.avatar_background;
                    avatar_foreground: item.avatar_foreground;
                    action_button_icon: item.action_button_icon;

                    clicked => {
                        if (!root.item-activated(index)) {
                            root.text = self.text;
                        }
                        root.close();
                    }

                    action_button_clicked => {
                        root.action_button_clicked(index);
                    }
                }
            }
        }
    }
}

/// `SearchBar` — the collapsed search bar (`SearchBar` composable with a
/// `SearchBarState`), 56dp pill surface on `surface-container-high`. Set
/// `expanded` to open the popup selected by `expansion`.
export component SearchBar {
    in property <image> leading_icon;
    in property <image> trailing_icon;
    in property <image> avatar_icon;
    in property <color> avatar_background: #00000000;
    in property <string> placeholder_text;
    in property <string> empty_text;
    in property <SearchBarExpansion> expansion: SearchBarExpansion.docked;
    /// Size the `full-screen*` expansion; defaults to the bar's own size.
    in property <length> expanded-width;
    in property <length> expanded-height;
    in property <length> dropdown-gap-size: 2px;
    in_out property <string> text;
    /// `SearchBarState.isExpanded`.
    in_out property <bool> expanded;
    in_out property <int> current_index;
    in property <[ListItem]> items;

    callback accepted(text: string);
    callback edited(text: string);
    callback action_button_clicked(index: int);
    callback key_pressed(event: KeyEvent) -> EventResult;
    callback key_released(event: KeyEvent) -> EventResult;
    callback item-activated(index: int) -> bool;

    /// `SearchBarState.currentTransitionAnimationProgress` — driven by the
    /// active scheme's fast-spatial spring.
    out property <float> expanded_fraction: root.expanded ? 1 : 0;
    animate expanded_fraction {
        enabled: !MaterialPalette.reduced-motion;
        easing: MaterialAnimations.fast_spatial_spring;
    }

    property <color> color: SearchBarTokens.supporting_text_color;

    public function close-popup() {
        popup.close();
    }

    in property <color> container_color: SearchBarTokens.container_color;

    min_height: max(SearchBarTokens.container_height, layout.min_height);
    forward_focus: state_layer;

    Rectangle {
        background: root.container_color;
        border_radius: MaterialStyleMetrics.border_radius_28;

        state_layer := StateLayerArea {
            border_radius: parent.border_radius;
            color: root.color;

            layout := HorizontalLayout {
                padding: MaterialStyleMetrics.padding_4;
                spacing: MaterialStyleMetrics.spacing_4;

                if root.leading_icon.width > 0 && root.leading_icon.height > 0 : SearchIcon {
                    icon: root.leading_icon;
                    color: SearchBarTokens.leading_icon_color;
                }

                MaterialText {
                    text: root.text;
                    font_size: SearchBarTokens.input_text_font.font_size;
                    font_weight: SearchBarTokens.input_text_font.font_weight;
                    vertical_alignment: center;
                    color: SearchBarTokens.input_text_color;

                    states [
                        placeholder when root.text == "" : {
                            text: root.placeholder_text;
                            color: SearchBarTokens.supporting_text_color;
                        }
                    ]
                }

                if root.trailing_icon.width > 0 && root.trailing_icon.height > 0 : SearchIcon {
                    icon: root.trailing_icon;
                    color: SearchBarTokens.trailing_icon_color;
                }

                if (root.avatar_icon.width > 0 && root.avatar_icon.height > 0) || root.avatar_background != #00000000 : VerticalLayout {
                    alignment: center;

                    Avatar  {
                        image: root.avatar_icon;
                        background: root.avatar_background;
                    }
                }
            }

            changed has_focus => {
                if self.has_focus && root.expansion != SearchBarExpansion.none {
                    root.expanded = true;
                }
            }

            clicked => {
                if root.expansion != SearchBarExpansion.none {
                    root.expanded = true;
                }
            }
        }
    }

    changed expanded => {
        if root.expanded && root.expansion != SearchBarExpansion.none {
            popup.show();
        }
    }

    popup := SearchViewPopup {
        expansion: root.expansion;
        dropdown-gap-size: root.dropdown-gap-size;
        contained: root.expansion == SearchBarExpansion.full-screen-contained;
        expanded-width: root.expanded-width > 0 ? root.expanded-width : root.width;
        expanded-height: root.expanded-height;
        placeholder_text: root.placeholder_text;
        empty_text: root.empty_text;
        text <=> root.text;
        items: root.items;

        accepted(text) => { root.accepted(text); }
        edited(text) => { root.edited(text); }
        action_button_clicked(index) => { root.action_button_clicked(index); }
        item-activated(index) => { root.item_activated(index); }
        closed => { root.expanded = false; }
    }
}

/// `AppBarWithSearch` — a single-row top app bar whose title slot is a
/// `SearchBar`, with optional navigation icon and action buttons.
export component AppBarWithSearch inherits Rectangle {
    in property <image> leading_icon;
    in property <[IconButtonItem]> trailing-buttons;
    in property <string> placeholder_text;
    in property <string> empty_text;
    in property <SearchBarExpansion> expansion: SearchBarExpansion.docked;
    in property <length> expanded-width;
    in property <length> expanded-height;
    in property <color> container-color: AppBarTokens.container_color;
    /// `scrolledAppBarContainerColor` — `surface-container` while scrolled.
    in property <color> scrolled-container-color: AppBarTokens.on_scroll_container_color;
    in property <length> scroll-position;
    in property <bool> scroll-enabled: true;
    in_out property <string> text;
    in_out property <bool> expanded;
    in property <[ListItem]> items;

    callback leading_button_clicked();
    callback trailing_button_clicked(index: int);
    callback accepted(text: string);
    callback edited(text: string);
    callback action_button_clicked(index: int);
    callback item-activated(index: int) -> bool;

    out property <float> overlapped-fraction: root.scroll-position > 1px ? 1 : 0;
    property <color> target-container-color: root.overlapped-fraction > 0 ?
        root.scrolled-container-color : root.container-color;

    // `AppBarContentPadding` is zero — the bar is exactly the field height
    // plus `AppBarWithSearchVerticalPadding` (4dp) top and bottom.
    height: max(AppBarSmallTokens.container_height,
        search-bar.min_height + 2 * MaterialStyleMetrics.padding_4);
    background: root.target-container-color;
    animate background {
        enabled: !MaterialPalette.reduced-motion;
        easing: MaterialAnimations.default_effects_spring;
    }

    property <length> nav-width: root.leading_icon.width > 0 && root.leading_icon.height > 0 ?
        MaterialStyleMetrics.padding_4 + MaterialButtonMetrics.icon-container-width(MaterialButtonSize.small, IconButtonWidth.uniform) : 0px;
    property <length> actions-width: root.trailing-buttons.length * (
        MaterialButtonMetrics.icon-container-width(MaterialButtonSize.small, IconButtonWidth.uniform) +
        MaterialStyleMetrics.padding_4);

    // `Box(Modifier.padding(start = AppBarWithSearchHorizontalPadding))`.
    if root.leading_icon.width > 0 && root.leading_icon.height > 0 : nav-box := Rectangle {
        x: 0;
        y: 0;
        width: root.nav-width;
        height: 100%;

        IconButton {
            x: MaterialStyleMetrics.padding_4;
            y: (parent.height - self.height) / 2;
            icon: root.leading_icon;
            enforce-touch-target: false;
            content-color: AppBarTokens.leading_icon_color;

            clicked => { root.leading_button_clicked(); }
        }
    }

    // Each action in `Box(Modifier.padding(end = AppBarWithSearchHorizontalPadding))`.
    actions-box := Rectangle {
        x: parent.width - self.width;
        y: 0;
        width: root.actions-width;
        height: 100%;

        for item[index] in root.trailing-buttons : IconButton {
            x: index * (MaterialButtonMetrics.icon-container-width(MaterialButtonSize.small, IconButtonWidth.uniform) + MaterialStyleMetrics.padding_4);
            y: (parent.height - self.height) / 2;
            icon: item.icon;
            enabled: item.enabled;
            enforce-touch-target: false;
            content-color: AppBarTokens.trailing_icon_color;

            clicked => { root.trailing_button_clicked(index); }
        }
    }

    // `weight(1f)` box + `SearchBarAsTopBarPadding` (8dp) horizontal /
    // `AppBarWithSearchVerticalPadding` (4dp) vertical on the field.
    search-bar := SearchBar {
        x: root.nav-width + MaterialStyleMetrics.padding_8;
        y: (parent.height - self.height) / 2;
        width: parent.width - root.nav-width - root.actions-width - 2 * MaterialStyleMetrics.padding_8;
        placeholder_text: root.placeholder_text;
        empty_text: root.empty_text;
        expansion: root.expansion;
        expanded-width: root.expanded-width;
        expanded-height: root.expanded-height;
        text <=> root.text;
        expanded <=> root.expanded;
        items: root.items;

        accepted(text) => { root.accepted(text); }
        edited(text) => { root.edited(text); }
        action_button_clicked(index) => { root.action_button_clicked(index); }
        item_activated(index) => { root.item_activated(index); }
    }

}

/// `ExpandedDockedSearchBar` — standalone docked popup. Place it where the
/// collapsed `SearchBar` sits; it shows when `expanded` is set.
export component ExpandedDockedSearchBar {
    in_out property <bool> expanded;
    in_out property <string> text;
    in property <string> placeholder_text;
    in property <string> empty_text;
    in property <[ListItem]> items;
    in property <length> expanded-width;
    in property <length> expanded-height;

    callback accepted(text: string);
    callback edited(text: string);
    callback action_button_clicked(index: int);
    callback item-activated(index: int) -> bool;

    changed expanded => {
        if root.expanded { view.show(); } else { view.close(); }
    }
    init => {
        if root.expanded { view.show(); }
    }

    view := SearchViewPopup {
        expansion: SearchBarExpansion.docked;
        expanded-width: root.expanded-width > 0 ? root.expanded-width : root.width;
        expanded-height: root.expanded-height;
        placeholder_text: root.placeholder_text;
        empty_text: root.empty_text;
        text <=> root.text;
        items: root.items;

        accepted(text) => { root.accepted(text); }
        edited(text) => { root.edited(text); }
        action_button_clicked(index) => { root.action_button_clicked(index); }
        item-activated(index) => { root.item_activated(index); }
        closed => { root.expanded = false; }
    }
}

/// `ExpandedDockedSearchBarWithGap` — docked popup with a
/// `dropdown-gap-size` (2dp default) between the collapsed bar and the
/// dropdown surface.
export component ExpandedDockedSearchBarWithGap {
    in_out property <bool> expanded;
    in_out property <string> text;
    in property <string> placeholder_text;
    in property <string> empty_text;
    in property <[ListItem]> items;
    in property <length> expanded-width;
    in property <length> expanded-height;
    in property <length> dropdown-gap-size: 2px;

    callback accepted(text: string);
    callback edited(text: string);
    callback action_button_clicked(index: int);
    callback item-activated(index: int) -> bool;

    changed expanded => {
        if root.expanded { view.show(); } else { view.close(); }
    }
    init => {
        if root.expanded { view.show(); }
    }

    view := SearchViewPopup {
        expansion: SearchBarExpansion.docked-with-gap;
        dropdown-gap-size: root.dropdown-gap-size;
        expanded-width: root.expanded-width > 0 ? root.expanded-width : root.width;
        expanded-height: root.expanded-height;
        placeholder_text: root.placeholder_text;
        empty_text: root.empty_text;
        text <=> root.text;
        items: root.items;

        accepted(text) => { root.accepted(text); }
        edited(text) => { root.edited(text); }
        action_button_clicked(index) => { root.action_button_clicked(index); }
        item-activated(index) => { root.item_activated(index); }
        closed => { root.expanded = false; }
    }
}

/// `ExpandedFullScreenSearchBar` — full-screen search surface (72dp header,
/// square corners).
export component ExpandedFullScreenSearchBar {
    in_out property <bool> expanded;
    in_out property <string> text;
    in property <string> placeholder_text;
    in property <string> empty_text;
    in property <[ListItem]> items;
    in property <length> expanded-width;
    in property <length> expanded-height;

    callback accepted(text: string);
    callback edited(text: string);
    callback action_button_clicked(index: int);
    callback item-activated(index: int) -> bool;

    changed expanded => {
        if root.expanded { view.show(); } else { view.close(); }
    }
    init => {
        if root.expanded { view.show(); }
    }

    view := SearchViewPopup {
        expansion: SearchBarExpansion.full-screen;
        expanded-width: root.expanded-width;
        expanded-height: root.expanded-height;
        placeholder_text: root.placeholder_text;
        empty_text: root.empty_text;
        text <=> root.text;
        items: root.items;

        accepted(text) => { root.accepted(text); }
        edited(text) => { root.edited(text); }
        action_button_clicked(index) => { root.action_button_clicked(index); }
        item-activated(index) => { root.item_activated(index); }
        closed => { root.expanded = false; }
    }
}

/// `ExpandedFullScreenContainedSearchBar` — full-screen surface with the
/// contained colors (surface container) and rounded corners.
export component ExpandedFullScreenContainedSearchBar {
    in_out property <bool> expanded;
    in_out property <string> text;
    in property <string> placeholder_text;
    in property <string> empty_text;
    in property <[ListItem]> items;
    in property <length> expanded-width;
    in property <length> expanded-height;

    callback accepted(text: string);
    callback edited(text: string);
    callback action_button_clicked(index: int);
    callback item-activated(index: int) -> bool;

    changed expanded => {
        if root.expanded { view.show(); } else { view.close(); }
    }
    init => {
        if root.expanded { view.show(); }
    }

    view := SearchViewPopup {
        expansion: SearchBarExpansion.full-screen-contained;
        contained: true;
        expanded-width: root.expanded-width;
        expanded-height: root.expanded-height;
        placeholder_text: root.placeholder_text;
        empty_text: root.empty_text;
        text <=> root.text;
        items: root.items;

        accepted(text) => { root.accepted(text); }
        edited(text) => { root.edited(text); }
        action_button_clicked(index) => { root.action_button_clicked(index); }
        item-activated(index) => { root.item_activated(index); }
        closed => { root.expanded = false; }
    }
}
