import { ElevationTokens } from "../styling/generated/material_elevation_tokens.slint";
import { MaterialCornerRadii } from "./material_corner_radii.slint";
import { MaterialButtonBase } from "./button_base.slint";
import { MaterialButtonMetrics, MaterialButtonShape, MaterialButtonSize } from "./button_metrics.slint";
import { TonalButtonTokens } from "../styling/generated/material_component_tokens.slint";

/// A medium-emphasis button — upstream `FilledTonalButton`, or
/// `FilledTonalToggleButton` when `checkable`.
export component TonalButton {
    in property <string> text;
    /// An optional leading icon.
    in property <image> icon;
    /// One of the five container heights (32/40/56/96/136).
    in property <MaterialButtonSize> size: MaterialButtonSize.small;
    /// `round` is the resting stadium shape; `square` the squarer variant.
    in property <MaterialButtonShape> button_shape: MaterialButtonShape.round;
    /// Turn the button into a toggle: `checked` becomes the selected state.
    in property <bool> checkable;
    in-out property <bool> checked;
    /// Set false when the application owns checked state.
    in property <bool> toggle_on_click: true;
    in property <bool> enabled: true;
    in property <string> tooltip;
    /// Reserve a 48x48 touch target around the visual (default on).
    in property <bool> enforce_touch_target: true;
    /// See `MaterialButtonBase.simulate_hover` / `simulate_press` —
    /// the parity harness's per-widget state hook.
    in property <bool> simulate_hover;
    in property <bool> simulate_press;

    /// The enabled container color; bindings can depend on checked state.
    in property <color> container_color: (root.checkable ? TonalButtonTokens.unselected_container_color : TonalButtonTokens.container_color);

    /// The enabled content color; bindings can depend on checked state.
    in property <color> content_color: (root.checkable ? TonalButtonTokens.unselected_label_text_color : TonalButtonTokens.label_text_color);

    /// The disabled container color, including its alpha.
    in property <color> disabled_container_color: TonalButtonTokens.disabled_container_color.with_alpha(TonalButtonTokens.disabled_container_opacity);

    /// The disabled content color, including its alpha.
    in property <color> disabled_content_color: TonalButtonTokens.disabled_label_text_color.with_alpha(TonalButtonTokens.disabled_label_text_opacity);

    /// A normalized resting path; empty uses the corner geometry.
    in property <shape> resting_shape: root.shape;
    /// The pressed path; defaults to the resting path.
    in property <shape> pressed_shape: root.resting_shape;
    /// The checked path; defaults to the resting path.
    in property <shape> checked_shape: root.resting_shape;
    /// Use independent corner radii instead of uniform radii.
    in property <bool> shaped_corners;
    /// Resting corner radii in logical pixels.
    in property <MaterialCornerRadii> resting_corners: {
        top_left: root.resting_radius, top_right: root.resting_radius,
        bottom_right: root.resting_radius, bottom_left: root.resting_radius,
    };
    /// Pressed corner radii in logical pixels.
    in property <MaterialCornerRadii> pressed_corners: {
        top_left: root.pressed_radius, top_right: root.pressed_radius,
        bottom_right: root.pressed_radius, bottom_left: root.pressed_radius,
    };
    /// Checked corner radii in logical pixels.
    in property <MaterialCornerRadii> checked_corners: {
        top_left: root.checked_radius, top_right: root.checked_radius,
        bottom_right: root.checked_radius, bottom_left: root.checked_radius,
    };

    /// The resting corner radius.
    in property <length> resting_radius: MaterialButtonMetrics.resting-radius(root.size, root.button_shape, MaterialButtonMetrics.container-height(root.size));

    /// The corner radius while pressed.
    in property <length> pressed_radius: MaterialButtonMetrics.pressed-radius(root.size, root.checkable);

    /// The checked corner radius.
    in property <length> checked_radius: MaterialButtonMetrics.checked-radius(root.size);

    /// The resting shadow elevation.
    in property <length> elevation_default: ElevationTokens.level0;

    /// The shadow elevation while pressed.
    in property <length> elevation_pressed: ElevationTokens.level0;

    /// The shadow elevation while hovered.
    in property <length> elevation_hovered: ElevationTokens.level1;

    /// The shadow elevation while focused.
    in property <length> elevation_focused: ElevationTokens.level0;

    /// The disabled shadow elevation.
    in property <length> elevation_disabled: ElevationTokens.level0;

    /// The border color.
    in property <color> border_color: transparent;

    /// The disabled border color.
    in property <color> disabled_border_color: root.border_color;

    /// The border width.
    in property <length> border_width: 0px;

    /// The checked border width; zero matches the default toggle border.
    in property <length> checked_border_width: 0px;

    /// Overrides padding leading; negative values use the size default.
    in property <length> padding_leading: -1px;

    /// Overrides padding trailing; negative values use the size default.
    in property <length> padding_trailing: -1px;

    /// Overrides padding vertical; negative values use the size default.
    in property <length> padding_vertical: -1px;

    /// The checked container color.
    in property <color> checked_container_color: TonalButtonTokens.selected_container_color;

    /// The checked content color.
    in property <color> checked_content_color: TonalButtonTokens.selected_label_text_color;

    callback clicked <=> base.clicked;
    /// Requests the next checked state on enabled toggle activation.
    callback checked_changed <=> base.checked_changed;

    out property <bool> has_focus <=> base.has_focus;
    out property <bool> pressed <=> base.pressed;
    out property <bool> has_hover <=> base.has_hover;
    /// The live corner radius — for the parity harness's motion trace.
    out property <length> container_radius <=> base.container_radius;

    accessible-label: root.text == "" ? root.tooltip : root.text;
    accessible-role: AccessibleRole.button;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked <=> root.checked;
    accessible-action-default => { base.activate(); }

    min_width: base.min_width;
    min_height: base.min_height;
    preferred_width: base.preferred_width;
    preferred_height: base.preferred_height;

    base := MaterialButtonBase {
        width: 100%;
        height: 100%;
        checkable: root.checkable;
        checked <=> root.checked;
        toggle_on_click: root.toggle_on_click;
        enabled: root.enabled;
        tooltip: root.tooltip;
        enforce_touch_target: root.enforce_touch_target;
        simulate_hover: root.simulate_hover;
        simulate_press: root.simulate_press;

        container_height: MaterialButtonMetrics.container-height(root.size);
        resting_radius: root.resting_radius;
        pressed_radius: root.pressed_radius;
        checked_radius: root.checked_radius;
        resting_shape: root.resting_shape;
        pressed_shape: root.pressed_shape;
        checked_shape: root.checked_shape;
        shaped_corners: root.shaped_corners;
        resting_corners: root.resting_corners;
        pressed_corners: root.pressed_corners;
        checked_corners: root.checked_corners;
        min_button_width: root.checkable ? 0px : 58px; // `ButtonDefaults.MinWidth`
        fast_spatial: root.checkable;

        container_color: root.checked ? root.checked_container_color : root.container_color;
        content_color: root.checked ? root.checked_content_color : root.content_color;
        disabled_container_color: root.disabled_container_color;
        disabled_content_color: root.disabled_content_color;
        border_color: root.border_color;
        disabled_border_color: root.disabled_border_color;
        border_width: root.border_width;
        checked_border_width: root.checked_border_width;
        elevation_default_dp: root.elevation_default;
        elevation_pressed_dp: root.elevation_pressed;
        elevation_hovered_dp: root.elevation_hovered;
        elevation_focused_dp: root.elevation_focused;
        elevation_disabled_dp: root.elevation_disabled;

        text: root.text;
        icon: root.icon;
        checked_icon: root.icon;
        padding_leading: root.padding_leading;
        padding_trailing: root.padding_trailing;
        padding_horizontal: MaterialButtonMetrics.horizontal-padding(root.size);
        padding_vertical: root.padding_vertical >= 0px ? root.padding_vertical : MaterialButtonMetrics.vertical-padding(root.size);
        @children

        icon_size: MaterialButtonMetrics.icon-size(root.size);
        icon_spacing: MaterialButtonMetrics.icon-spacing(root.size);
        label_style: MaterialButtonMetrics.label-style(root.size, root.checkable);
    }
}
