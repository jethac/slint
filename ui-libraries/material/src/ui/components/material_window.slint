import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialTheme } from "../styling/material_theme.slint";

export global MaterialWindowAdapter {
    in property <bool> disable_hover;
}

export component MaterialWindow inherits Window {
    in property <bool> disable_hover;

    background: MaterialPalette.background;
    default-font-family: MaterialTheme.plain_family;
    // Compose applies no variation settings to the type scale (TypeScaleTokens.kt
    // pins no `opsz`), so Material text renders at the optical-size default even
    // under a variable font: engine `auto` would tie `opsz` to the pixel size.
    default-font-optical-sizing: none;

    changed disable_hover => {
        MaterialWindowAdapter.disable_hover = root.disable_hover;
    }
}
