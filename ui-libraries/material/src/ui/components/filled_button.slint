import { Elevation } from "./elevation.slint";
import { BaseButton } from "./base_button.slint";
import { MaterialTypography } from "../styling/material_typography.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialAnimations } from "../styling/material_animations.slint";
import { BaselineButtonTokens } from "../styling/generated/material_component_tokens.slint";

export component FilledButton {
    in property <image> icon <=> base.icon;
    in property <string> text <=> base.text;
    in property <string> tooltip <=> base.tooltip;
    in property <bool> enabled <=> base.enabled;

    callback clicked <=> base.clicked;

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text == "" ? root.tooltip : root.text;
    accessible-action-default => { base.clicked(); }

    elevation := Elevation {
        // M3 Expressive button shape morph: pill (`container_shape_round`) at
        // rest, `pressed_container_shape` while pressed — the morph Compose
        // performs via `ButtonDefaults.shapes()` on the
        // `MotionSchemeKeyTokens.DefaultEffects` spring.
        border_radius: base.pressed || base.enter_pressed
            ? BaselineButtonTokens.pressed_container_shape.top_left
            : root.height / 2;
        background: MaterialPalette.primary;
        width: 100%;
        height: 100%;

        animate border_radius {
            duration: MaterialAnimations.default_effects_duration;
            // spring() takes a literal: bounce = 1 - damping ratio of the
            // default effects spec — 1 - 1 = 0 in both schemes (see
            // MaterialAnimations.default_effects_bounce).
            easing: spring(0);
        }
    }

    base := BaseButton {
        border_radius: elevation.border_radius;
        color: MaterialPalette.on_primary;
    }

    states [
        disabled when !root.enabled : {
            elevation.background: transparent;
            base.color: MaterialPalette.on_surface;
        }
        hover when base.has_hover && !base.pressed && !base.enter_pressed : {
            elevation.level: 1;
        }
    ]
}
