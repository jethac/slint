import { Elevation } from "./elevation.slint";
import { Icon } from "./icon.slint";
import { MaterialText } from "./material_text.slint";
import { FocusRing, MaterialCornerRadii, StateLayerArea } from "./state_layer.slint";
import { MaterialAnimations } from "../styling/material_animations.slint";
import { MaterialPalette } from "../styling/material_palette.slint";
import { MaterialTypeStyle, MaterialTypography } from "../styling/material_typography.slint";
import { StateTokens } from "../styling/generated/material_state_tokens.slint";

/// The shared interaction+decoration shell behind every button style:
/// the 48dp touch-target slot with the visual container centered in it
/// (upstream `minimumInteractiveComponentSize`), the shape-morph on
/// press/selection, the state layer + bounded ripple clipped to the live
/// corner radius, the inset focus ring, shape-clipped hit testing, and the
/// animated elevation.
///
/// A style component supplies the already-resolved values (container
/// extents, resting/pressed/checked radii, colors for the enabled and
/// disabled states, border, elevation table, and the content metrics); this
/// component owns the state machine.
export component MaterialButtonBase {
    // Resolved geometry.
    in property <length> container_height;
    /// `<= 0` stretches the container across the component (text buttons);
    /// a positive value centers a fixed-width container (icon buttons).
    in property <length> container_width: 0px;
    in property <length> resting_radius;
    in property <length> pressed_radius;
    in property <length> checked_radius;
    /// Per-corner shapes (the split button's asymmetric
    /// `leadingButtonShape`/`trailingButtonShape`): the three `*_corners`
    /// sets replace the matching `*_radius` values and each corner animates
    /// independently with the same spec — `rememberAnimatedShape` lerps the
    /// four `CornerSize`s the same way.
    in property <bool> shaped_corners;
    in property <MaterialCornerRadii> resting_corners;
    in property <MaterialCornerRadii> pressed_corners;
    in property <MaterialCornerRadii> checked_corners;
    /// `ButtonDefaults.MinWidth` — 58px for plain buttons, 0 for toggles.
    in property <length> min_button_width;
    /// Reserve at least 48x48 of layout space around the container —
    /// upstream `Modifier.minimumInteractiveComponentSize`. Turned off by
    /// the parity harness, which composes the same scenes with
    /// `LocalMinimumInteractiveComponentSize provides 0.dp`.
    in property <bool> enforce_touch_target: true;

    // Resolved style.
    in property <color> container_color;
    in property <color> content_color;
    /// Disabled container/content colors with their alpha already applied.
    in property <color> disabled_container_color;
    in property <color> disabled_content_color;
    in property <color> border_color;
    /// Disabled-state border color; defaults to `border_color`.
    in property <color> disabled_border_color;
    /// The unchecked border width; the border disappears while checked,
    /// matching `OutlinedToggleButtonDefaults.border`.
    in property <length> border_width;
    // The `*ButtonElevation` table as M3 elevation levels.
    in property <int> elevation_default: 0;
    in property <int> elevation_pressed: 0;
    in property <int> elevation_hovered: 0;
    in property <int> elevation_focused: 0;
    in property <int> elevation_disabled: 0;
    /// `ToggleButton` morphs with the fast spatial spec while `Button` and
    /// the icon buttons use the default effects spec (`shapeByInteraction`
    /// in the pinned sources).
    in property <bool> fast_spatial;

    // Content.
    in property <string> text;
    in property <image> icon;
    /// Icon drawn while checked (icon buttons only; upstream keeps the same
    /// icon, so this defaults to `icon` in the callers).
    in property <image> checked_icon;
    in property <length> padding_horizontal;
    /// Asymmetric horizontal padding overrides — a negative value falls
    /// back to `padding_horizontal` (upstream `PaddingValues(start, end)`
    /// where the two ends differ, e.g. `ButtonWithIconContentPadding`).
    in property <length> padding_leading: -1px;
    in property <length> padding_trailing: -1px;
    in property <length> padding_vertical;
    /// Extra leading/trailing content padding — the split button's
    /// asymmetric `leadingButtonContentPaddingFor`/`trailingButtonContentPaddingFor`.
    in property <length> padding_start: 0px;
    in property <length> padding_end: 0px;
    /// `Modifier.horizontalCenterOptically`: shift the content by
    /// `0.11 * (avgStart - avgEnd)` of the live corner radii, coerced into
    /// `[-startPad, +endPad]` — applied by the trailing split button only.
    in property <bool> optical_center;
    /// The checked `TrailingButton`'s `drawWithContent` overlay: the content
    /// color at `StateTokens.PressedStateLayerOpacity` across the live shape.
    in property <bool> checked_overlay;
    /// Rotate the icon around its center — the trailing chevron's 0↔180°
    /// flip from the upstream samples (`animateFloatAsState` default spec:
    /// `spring(dampingRatio = 1, stiffness = 1500)`).
    in property <angle> icon_rotation: 0deg;
    in property <length> icon_size;
    in property <length> icon_spacing;
    in property <MaterialTypeStyle> label_style: MaterialTypography.label_large;
    /// Centered-icon layout (icon buttons) instead of the padded text row.
    in property <bool> icon_button;
    /// See `StateLayerArea.clip_ripple` — false draws unbounded ink.
    in property <bool> clip_ripple: true;

    // State.
    in property <bool> enabled: true;
    in property <bool> checkable;
    in-out property <bool> checked;
    in property <string> tooltip;
    /// See `StateLayerArea.simulate_hover` / `simulate_press`.
    in property <bool> simulate_hover;
    in property <bool> simulate_press;

    callback clicked;
    out property <bool> has_focus <=> area.has_focus;
    out property <bool> pressed <=> area.effective_pressed;
    out property <bool> has_hover <=> area.effective_hover;
    /// The live, animating corner radius — traced by the parity harness.
    out property <length> container_radius <=> container.border_radius;
    /// The live per-corner radii mid-morph — parity motion traces read them
    /// directly in `shaped_corners` mode.
    /// The icon's live rotation — the animated value the parity harness
    /// traces (0↔180° chevron flip on a split button's trailing).
    out property <angle> live_icon_rotation <=> root.animated_icon_rotation;

    out property <length> corner_tl: root.target_tl;
    out property <length> corner_tr: root.target_tr;
    out property <length> corner_br: root.target_br;
    out property <length> corner_bl: root.target_bl;

    property <length> touch: root.enforce_touch_target ? 48px : 0px;
    property <length> box_width: root.container_width > 0px ? root.container_width : root.width;
    property <length> box_height: root.container_height;

    min_width: max(root.min_button_width, root.touch,
        root.icon_button ? root.container_width : area.min_width);
    min_height: max(root.touch, root.container_height);
    preferred_width: root.min_width;
    preferred_height: root.min_height;

    // `shapeByInteraction`: pressed wins, then checked, then the resting
    // shape — `pressedShape` is drawn even while checked.
    property <length> target_radius:
        area.effective_pressed ? root.pressed_radius :
        (root.checkable && root.checked ? root.checked_radius : root.resting_radius);
    animate target_radius {
        easing: root.fast_spatial ? MaterialAnimations.fast-spatial-spring : MaterialAnimations.default-effects-spring;
        enabled: !MaterialPalette.reduced-motion;
    }

    // The per-corner half of `shapeByInteraction` — one animatable per
    // corner, mirroring `AnimatedShapeState`'s corner lerp. In uniform mode
    // they follow `target_radius`.
    property <MaterialCornerRadii> target_corners:
        area.effective_pressed ? root.pressed_corners :
        (root.checkable && root.checked ? root.checked_corners : root.resting_corners);
    property <length> target_tl: root.shaped_corners ? root.target_corners.top_left : root.target_radius;
    property <length> target_tr: root.shaped_corners ? root.target_corners.top_right : root.target_radius;
    property <length> target_br: root.shaped_corners ? root.target_corners.bottom_right : root.target_radius;
    property <length> target_bl: root.shaped_corners ? root.target_corners.bottom_left : root.target_radius;
    animate target_tl {
        easing: root.fast_spatial ? MaterialAnimations.fast-spatial-spring : MaterialAnimations.default-effects-spring;
        enabled: !MaterialPalette.reduced-motion;
    }
    animate target_tr {
        easing: root.fast_spatial ? MaterialAnimations.fast-spatial-spring : MaterialAnimations.default-effects-spring;
        enabled: !MaterialPalette.reduced-motion;
    }
    animate target_br {
        easing: root.fast_spatial ? MaterialAnimations.fast-spatial-spring : MaterialAnimations.default-effects-spring;
        enabled: !MaterialPalette.reduced-motion;
    }
    animate target_bl {
        easing: root.fast_spatial ? MaterialAnimations.fast-spatial-spring : MaterialAnimations.default-effects-spring;
        enabled: !MaterialPalette.reduced-motion;
    }

    /// The `horizontalCenterOptically` correction: `0.11 * (avgStart -
    /// avgEnd)` coerced into `[-startPad, +endPad]` and rounded, where start
    /// is the leading side. Computed from the live radii so the content
    /// rides the morph mid-spring.
    property <length> optical_offset:
        !root.optical_center ? 0px : Math.round(
            Math.max(-(root.padding_horizontal + root.padding_start) / 1px,
            Math.min((root.padding_horizontal + root.padding_end) / 1px,
                0.11 * ((root.target_tl + root.target_bl) / 2 - (root.target_tr + root.target_br) / 2) / 1px))) * 1px;

    /// The icon flip's animated rotation — `animateFloatAsState` in the
    /// samples (default spec `spring(dampingRatio = 1, stiffness = 1500)`).
    property <angle> animated_icon_rotation: root.icon_rotation;
    animate animated_icon_rotation {
        easing: spring(1, 1500);
        enabled: !MaterialPalette.reduced-motion;
    }

    property <color> current_container_color: root.enabled ? root.container_color : root.disabled_container_color;
    property <color> current_content_color: root.enabled ? root.content_color : root.disabled_content_color;

    // `animateBorderStrokeAsState`: the width follows the fast spatial spec,
    // the color the fast effects spec.
    property <length> current_border_width: root.checkable && root.checked ? 0px : root.border_width;
    property <color> current_border_color: root.enabled ? root.border_color : root.disabled_border_color;
    animate current_border_width {
        easing: MaterialAnimations.fast-spatial-spring;
        enabled: !MaterialPalette.reduced-motion;
    }
    animate current_border_color {
        easing: MaterialAnimations.fast-effects-spring;
        enabled: !MaterialPalette.reduced-motion;
    }

    // Last interaction wins for elevation, like `animateElevation`.
    property <int> current_level: !root.enabled ? root.elevation_disabled :
        area.effective_pressed ? root.elevation_pressed :
        area.effective_hover ? root.elevation_hovered :
        area.has_focus ? root.elevation_focused :
        root.elevation_default;

    container := Elevation {
        x: (root.width - root.box_width) / 2;
        y: (root.height - root.box_height) / 2;
        width: root.box_width;
        height: root.box_height;
        border_radius: root.target_radius;
        corners: { top_left: root.target_tl, top_right: root.target_tr, bottom_right: root.target_br, bottom_left: root.target_bl };
        shaped_corners: root.shaped_corners;
        background: root.current_container_color;
        level: root.current_level;
    }

    area := StateLayerArea {
        x: container.x;
        y: container.y;
        width: container.width;
        height: container.height;
        enabled: root.enabled;
        color: root.current_content_color;
        border_radius: root.target_radius;
        corners: { top_left: root.target_tl, top_right: root.target_tr, bottom_right: root.target_br, bottom_left: root.target_bl };
        shaped_corners: root.shaped_corners;
        hit_radius: root.resting_radius;
        hit_corners: root.resting_corners;
        tooltip: root.tooltip;
        display_background: false;
        focus_ring: true;
        clip_ripple: root.clip_ripple;
        simulate_hover: root.simulate_hover;
        simulate_press: root.simulate_press;

        clicked() => {
            // A click counts only when the press landed inside the clipped
            // shape — or came from the keyboard, which is always inside.
            if !area.pointer_inside && !area.enter_pressed {
                return;
            }
            if root.checkable {
                root.checked = !root.checked;
            }
            root.clicked();
        }

        layout := HorizontalLayout {
            // `padding_leading`/`padding_trailing` replace the whole side
            // when set (button-group item slots); otherwise the base
            // `padding_horizontal` plus the split button's `padding_start`/
            // `padding_end` extras and the optical-centering offset apply.
            padding_left: root.icon_button ? 0px : (root.padding_leading >= 0px ? root.padding_leading
                : root.padding_horizontal + root.padding_start + root.optical_offset);
            // Compose's content is `Icon + Spacer(iconSpacing) + Text` — the
            // spacer is emitted whenever an icon is present, so it still
            // counts when the label is empty.
            padding_right: root.icon_button ? 0px : (root.padding_trailing >= 0px ? root.padding_trailing
                : root.padding_horizontal + root.padding_end - root.optical_offset
                    + (root.icon.width > 0 && root.text == "" ? root.icon_spacing : 0px));
            padding_top: root.icon_button ? 0px : root.padding_vertical;
            padding_bottom: root.icon_button ? 0px : root.padding_vertical;
            spacing: root.icon_spacing;
            alignment: center;
            // Compose's content row is `verticalAlignment = CenterVertically`:
            // children keep their own heights and are centered, not stretched.
            cross_axis_alignment: center;

            if root.icon.width > 0 && root.icon.height > 0 : Icon {
                source: root.checked ? root.checked_icon : root.icon;
                colorize: root.current_content_color;
                width: root.icon_size;
                transform-rotation: root.animated_icon_rotation;
            }

            if !root.icon_button && root.text != "" : MaterialText {
                text: root.text;
                style: root.label_style;
                color: root.current_content_color;
                // A button always sizes to its full label — `MaterialText`'s
                // default `elide` would report a collapsible min-width.
                overflow: clip;
                // Compose's `Text` stays `lineHeight`-tall inside the padded
                // content row; the layout would otherwise stretch the element
                // to the full row height.
                max_height: root.label_style.line_height;
                vertical_alignment: center;
            }
        }
    }

    // `Surface`'s `Modifier.border` draws the ring inside the shape — the
    // same inside-stroke `Rectangle.border_width` paints — over the state
    // layer and content.
    if root.current_border_width > 0px : border_layer := Rectangle {
        x: container.x;
        y: container.y;
        width: container.width;
        height: container.height;
        background: transparent;
        border_width: root.current_border_width;
        border_color: root.current_border_color;
        border_radius: root.target_radius;
        border-top-left-radius: root.target_tl;
        border-top-right-radius: root.target_tr;
        border-bottom-right-radius: root.target_br;
        border-bottom-left-radius: root.target_bl;
    }

    // The checked `TrailingButton`'s `drawWithContent` overlay: drawn after
    // everything the `Surface` paints — content and border — at
    // `StateTokens.PressedStateLayerOpacity` in the content color.
    if root.checked_overlay && root.checkable && root.checked : Rectangle {
        x: container.x;
        y: container.y;
        width: container.width;
        height: container.height;
        background: root.current_content_color.with_alpha(StateTokens.pressed_state_layer_opacity);
        border-top-left-radius: root.target_tl;
        border-top-right-radius: root.target_tr;
        border-bottom-right-radius: root.target_br;
        border-bottom-left-radius: root.target_bl;
    }

    // The inset ring follows the live shape — including mid-morph.
    if area.has_focus && root.enabled : FocusRing {
        x: container.x;
        y: container.y;
        width: container.width;
        height: container.height;
        border_radius: root.target_radius;
        corners: { top_left: root.target_tl, top_right: root.target_tr, bottom_right: root.target_br, bottom_left: root.target_bl };
        shaped_corners: root.shaped_corners;
    }
}
