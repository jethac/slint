export struct NavigationItem {
    icon: image,
    selected_icon: image,
    text: string,
    show_badge: bool,
    badge: string,
    /// `enabled` on each `NavigationRailItem`/`NavigationBarItem` — a
    /// disabled item renders in the inactive color at 38% opacity and takes
    /// no input.
    enabled: bool = true
}

export struct NavigationGroup {
    title: string,
    items: [NavigationItem]
}
