export struct NavigationItem {
    icon: image,
    selected_icon: image,
    text: string,
    show_badge: bool,
    badge: string,
    /// `Tab.enabled` — the item takes no focus, clicks or state layers.
    /// Only the tab bars honor it so far.
    disabled: bool,
    /// Lay the item out like upstream's `LeadingIconTab`: icon and label
    /// side by side instead of the stacked `Tab` arrangement. Only the tab
    /// bars honor it.
    leading_icon: bool,
    /// `enabled` on each `ShortNavigationBarItem`/`NavigationBarItem` — a
    /// disabled item renders in the inactive color at 38% opacity and takes
    /// no input.
    enabled: bool = true
}

export struct NavigationGroup {
    title: string,
    items: [NavigationItem]
}
