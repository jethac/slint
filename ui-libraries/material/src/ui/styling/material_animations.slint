import { MotionTokens } from "generated/material_motion_tokens.slint";

export global MaterialAnimations {
    out property <easing> emphasized_easing: MotionTokens.easing_emphasized_decelerate_cubic_bezier;
    out property <duration> emphasized_duration: MotionTokens.duration_long2;
    out property <duration> emphasized_decelerate_duration: MotionTokens.duration_medium4;
    out property <duration> emphasized_accelerate_duration: MotionTokens.duration_short4;
    out property <easing> standard_easing: MotionTokens.easing_standard_cubic_bezier;
    out property <duration> standard_decelerate_duration: MotionTokens.duration_medium1;
    out property <duration> standard_accelerate_duration: MotionTokens.duration_short4;
    out property <duration> standard_fast_duration: MotionTokens.duration_short3;
    // Ripple/opacity timings are not tokens in material3 — kept local.
    out property <easing> ripple_easing: ease_out;
    out property <duration> ripple_duration: 2s;
    out property <easing> opacity_easing: ease;
    out property <duration> opacity_duration: 250ms;
}
