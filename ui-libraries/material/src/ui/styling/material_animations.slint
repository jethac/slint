import { MaterialMotion, MaterialMotionSchemeSpec, MaterialSpringSpec, MotionTokens } from "generated/material_motion_tokens.slint";

/// The M3 motion scheme: `standard` mirrors `MotionScheme.standard()` and
/// `expressive` mirrors `MotionScheme.expressive()` in the pinned androidx
/// sources. Assign to `MaterialAnimations.motion-scheme` to switch schemes
/// at runtime; all spring tokens re-evaluate through the same binding.
export enum MaterialMotionScheme { standard, expressive }

export global MaterialAnimations {
    in-out property <MaterialMotionScheme> motion-scheme: MaterialMotionScheme.expressive;
    property <bool> expressive: motion-scheme == MaterialMotionScheme.expressive;
    property <MaterialMotionSchemeSpec> scheme:
        motion-scheme == MaterialMotionScheme.standard ? MaterialMotion.standard : MaterialMotion.expressive;

    function spring-of(spec: MaterialSpringSpec) -> easing {
        spring(spec.damping-ratio, spec.stiffness)
    }

    // The six springs of the active scheme, as runtime `easing` values.
    out property <easing> default-spatial-spring: spring-of(scheme.default_spatial);
    out property <easing> fast-spatial-spring: spring-of(scheme.fast_spatial);
    out property <easing> slow-spatial-spring: spring-of(scheme.slow_spatial);
    out property <easing> default-effects-spring: spring-of(scheme.default_effects);
    out property <easing> fast-effects-spring: spring-of(scheme.fast_effects);
    out property <easing> slow-effects-spring: spring-of(scheme.slow_effects);

    // Emphasized and standard easings switch between the emphasized and
    // legacy token sets with the motion scheme.
    out property <easing> emphasized_easing: root.expressive ? MotionTokens.easing_emphasized_decelerate_cubic_bezier : MotionTokens.easing_legacy_decelerate_cubic_bezier;
    out property <duration> emphasized_duration: MotionTokens.duration_long2;
    out property <duration> emphasized_decelerate_duration: MotionTokens.duration_medium4;
    out property <duration> emphasized_accelerate_duration: MotionTokens.duration_short4;
    out property <easing> standard_easing: root.expressive ? MotionTokens.easing_standard_cubic_bezier : MotionTokens.easing_legacy_cubic_bezier;
    out property <duration> standard_decelerate_duration: MotionTokens.duration_medium1;
    out property <duration> standard_accelerate_duration: MotionTokens.duration_short4;
    out property <duration> standard_fast_duration: MotionTokens.duration_short3;
    // Ripple/opacity timings are not tokens in material3 — kept local.
    out property <easing> ripple_easing: ease_out;
    out property <duration> ripple_duration: 2s;
    out property <easing> opacity_easing: ease;
    out property <duration> opacity_duration: 250ms;

    /// Evaluates a cubic-bezier `y(x)` for control points (x1, y1, x2, y2):
    /// Newton–Raphson inversion of the x component (six iterations, unrolled
    /// because the language has no loops in pure functions), then the y
    /// component — the same curve `CubicBezierEasing` applies.
    public pure function cubic-bezier-easing(x1: float, y1: float, x2: float, y2: float, x: float) -> float {
        bezier-y(y1, y2, bezier-t-step(x1, x2, x, bezier-t-step(x1, x2, x, bezier-t-step(x1, x2, x,
            bezier-t-step(x1, x2, x, bezier-t-step(x1, x2, x, bezier-t-step(x1, x2, x, x)))))))
    }

    // Bernstein form of the x and y curves.
    pure function bezier-x(x1: float, x2: float, t: float) -> float {
        3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t
    }
    pure function bezier-x-deriv(x1: float, x2: float, t: float) -> float {
        3 * (1 - t) * (1 - t) * x1 + 6 * (1 - t) * t * (x2 - x1) + 3 * t * t * (1 - x2)
    }
    pure function bezier-y(y1: float, y2: float, t: float) -> float {
        3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t
    }
    pure function bezier-t-step(x1: float, x2: float, x: float, t: float) -> float {
        let error = bezier-x(x1, x2, t) - x;
        let slope = bezier-x-deriv(x1, x2, t);
        if slope.abs() < 0.0001 || error.abs() < 0.0001 {
            return t;
        }
        (t - error / slope).clamp(0, 1)
    }
}
