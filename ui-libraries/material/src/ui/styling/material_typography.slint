import { MaterialTypeStyle, TypefaceTokens, TypographyTokens } from "generated/material_typography_tokens.slint";

export { MaterialTypeStyle }

export global MaterialTypography {
    // Font weights (TypefaceTokens.kt).
    out property <int> regular: TypefaceTokens.weight_regular;
    out property <int> medium: TypefaceTokens.weight_medium;
    out property <int> bold: TypefaceTokens.weight_bold;

    // Type scale (TypographyTokens.kt) — every role including *Emphasized.
    out property <MaterialTypeStyle> display_large: TypographyTokens.display_large;
    out property <MaterialTypeStyle> display_medium: TypographyTokens.display_medium;
    out property <MaterialTypeStyle> display_small: TypographyTokens.display_small;
    out property <MaterialTypeStyle> headline_large: TypographyTokens.headline_large;
    out property <MaterialTypeStyle> headline_medium: TypographyTokens.headline_medium;
    out property <MaterialTypeStyle> headline_small: TypographyTokens.headline_small;
    out property <MaterialTypeStyle> title_large: TypographyTokens.title_large;
    out property <MaterialTypeStyle> title_medium: TypographyTokens.title_medium;
    out property <MaterialTypeStyle> title_small: TypographyTokens.title_small;
    out property <MaterialTypeStyle> label_large: TypographyTokens.label_large;
    out property <MaterialTypeStyle> label_medium: TypographyTokens.label_medium;
    out property <MaterialTypeStyle> label_small: TypographyTokens.label_small;
    out property <MaterialTypeStyle> body_large: TypographyTokens.body_large;
    out property <MaterialTypeStyle> body_medium: TypographyTokens.body_medium;
    out property <MaterialTypeStyle> body_small: TypographyTokens.body_small;
    out property <MaterialTypeStyle> display_large_emphasized: TypographyTokens.display_large_emphasized;
    out property <MaterialTypeStyle> display_medium_emphasized: TypographyTokens.display_medium_emphasized;
    out property <MaterialTypeStyle> display_small_emphasized: TypographyTokens.display_small_emphasized;
    out property <MaterialTypeStyle> headline_large_emphasized: TypographyTokens.headline_large_emphasized;
    out property <MaterialTypeStyle> headline_medium_emphasized: TypographyTokens.headline_medium_emphasized;
    out property <MaterialTypeStyle> headline_small_emphasized: TypographyTokens.headline_small_emphasized;
    out property <MaterialTypeStyle> title_large_emphasized: TypographyTokens.title_large_emphasized;
    out property <MaterialTypeStyle> title_medium_emphasized: TypographyTokens.title_medium_emphasized;
    out property <MaterialTypeStyle> title_small_emphasized: TypographyTokens.title_small_emphasized;
    out property <MaterialTypeStyle> label_large_emphasized: TypographyTokens.label_large_emphasized;
    out property <MaterialTypeStyle> label_medium_emphasized: TypographyTokens.label_medium_emphasized;
    out property <MaterialTypeStyle> label_small_emphasized: TypographyTokens.label_small_emphasized;
    out property <MaterialTypeStyle> body_large_emphasized: TypographyTokens.body_large_emphasized;
    out property <MaterialTypeStyle> body_medium_emphasized: TypographyTokens.body_medium_emphasized;
    out property <MaterialTypeStyle> body_small_emphasized: TypographyTokens.body_small_emphasized;
}
