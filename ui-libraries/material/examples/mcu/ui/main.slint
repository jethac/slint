// Components are imported from the library's component files rather than the
// `material.slint` umbrella: that file registers the full ~4.2 MB Google Sans
// Flex, and MCU flash can't hold it. This example registers a subset of the
// same font (~1.6 MB, Basic Latin glyphs only, all six axes kept) under the
// original family name, so the theme's bound `default-font-family` still
// resolves to it. See `fonts/README.md`.
import "../fonts/GoogleSansFlex-subset.ttf";
import { MaterialTypography } from "../../../src/ui/styling/material_typography.slint";
import { MaterialWindow } from "../../../src/ui/components/material_window.slint";
import { MaterialText } from "../../../src/ui/components/material_text.slint";
import { ElevatedButton } from "../../../src/ui/components/elevated_button.slint";

// Exercises the MCU-relevant font paths in the Material library: the theme's
// bound `default-font-family`, style-bound weight/size on MaterialText, and an
// animated `font-weight` — all non-constant bindings take the vector path.
export component MainWindow inherits MaterialWindow {
    preferred-width: 320px;
    preferred-height: 240px;

    in property <int> emphasis;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        MaterialText {
            style: MaterialTypography.headline_medium;
            text: "Material on MCU";
        }

        MaterialText {
            style: MaterialTypography.body_medium;
            text: "Type scale text";
        }

        Text {
            text: "animated weight";
            font-weight: emphasis;
            animate font-weight { duration: 300ms; }
        }

        ElevatedButton {
            text: "Button";
        }
    }
}
