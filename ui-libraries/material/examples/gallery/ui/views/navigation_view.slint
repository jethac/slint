import {
    MaterialStyleMetrics,
    MaterialPalette,
    ListTile,
    SegmentedListItem,
    ListView,
    NavigationBar,
    BottomAppBar,
    NavigationDrawer,
    TextButton,
    ModalNavigationDrawer,
    NavigationRail,
    Horizontal,
    NavigationItem,
    TabBar,
    SecondaryTabBar,
    SearchBar,
    AppBarWithSearch,
    FlexibleBottomAppBar,
    BottomAppBarArrangement,
    MaterialText,
    Vertical,
    ListItem,
    TopAppBar,
    CenterAlignedTopAppBar,
    MediumTopAppBar,
    MediumFlexibleTopAppBar,
    LargeTopAppBar,
    LargeFlexibleTopAppBar,
    CheckBoxTile,
    CheckState,
    ActionChip,
    FilterChip,
    InputChip,
    TimePickerPopup,
    Switch,
    Slider,
    TextField,
    RadioButtonTile,
    PopupMenu,
    DropDownMenu,
    MenuItem,
    MenuGroup,
    MenuItemKind,
    MenuVariant,
    DatePickerPopup
} from "../../../../src/material.slint";

import { Group } from "../components/group.slint";
import { ComponentCard } from "../components/component_card.slint";
import { MainWindowAdapter } from "../main_window_adapter.slint";
import { FilledIcons, OutlinedIcons } from "../icons.slint";

export global NavigationViewAdapter {
    in_out property <[ListItem]> search_items;
    in property <[bool]> radio_buttons: [ true, false, false ];

    callback search(text: string);
    callback filter_icons(text: string);
    callback radio_button_clicked(index: int);
}

export component NavigationView {
    layout := VerticalLayout {
        alignment: start;
        spacing: MaterialStyleMetrics.spacing_8;
        horizontal-stretch: 1;

        Group {
            title: "Navigation";

            ComponentCard {
                title: "Search";

                Vertical {
                    spacing: MaterialStyleMetrics.spacing_16;
                    alignment: start;

                    SearchBar {
                        leading_icon: OutlinedIcons.search;
                        placeholder_text: "Search color";
                        empty_text: "No search history.";
                        items: NavigationViewAdapter.search_items;

                        edited(text) => {
                            NavigationViewAdapter.search(text);
                        }
                    }

                    AppBarWithSearch {
                        leading-icon: FilledIcons.menu;
                        placeholder-text: "Search color";
                        empty_text: "No search history.";
                        items: NavigationViewAdapter.search_items;

                        edited(text) => {
                            NavigationViewAdapter.search(text);
                        }
                    }

                    MaterialText {
                        text: "Select a color";
                        horizontal_alignment: center;
                    }
                }
            }

            ComponentCard {
                title: "Bottom app bar";

                BottomAppBar {
                    icon_buttons: [
                        {
                            icon: OutlinedIcons.more_vert,
                            enabled: true,

                        },
                        {
                            icon: OutlinedIcons.search,
                            enabled: true,
                            tooltip: "Search"
                        },
                        {
                            icon: OutlinedIcons.favorite,
                            enabled: true,
                            tooltip: "Favorite"
                        },
                    ];
                    fab_icon:  OutlinedIcons.add;
                }
            }

            ComponentCard {
                title: "Flexible bottom app bar";

                FlexibleBottomAppBar {
                    width: 100%;
                    arrangement: BottomAppBarArrangement.space-between;
                    items: [
                        { icon: OutlinedIcons.search, label: "Search" },
                        { icon: OutlinedIcons.favorite, label: "Favorite" },
                        { icon: OutlinedIcons.add, label: "Add" },
                        { icon: OutlinedIcons.more_vert, label: "More" },
                    ];
                }
            }

            ComponentCard {
                title: "Navigation bar";

                NavigationBar {
                    items: [
                          {
                             icon: OutlinedIcons.explore,
                             selected_icon: FilledIcons.explore,
                             text: "Explore",
                          },
                          {
                             icon: OutlinedIcons.pets,
                             selected_icon: FilledIcons.pets,
                             text: "Pets",
                          },
                          {
                             icon: OutlinedIcons.account_box,
                             selected_icon: FilledIcons.account_box,
                             text: "Account",
                          },
                    ];
                }
            }

            ComponentCard {
                title: "Navigation drawer";

                VerticalLayout {
                    NavigationDrawer {
                        groups: [
                            {
                                title: "Mail",
                                items: [
                                    {
                                        icon: OutlinedIcons.inbox,
                                        selected_icon: FilledIcons.inbox,
                                        text: "Inbox",
                                    },
                                    {
                                        icon: OutlinedIcons.outbox,
                                        selected_icon: FilledIcons.outbox,
                                        text: "Outbox",
                                    },
                                    {
                                        icon: OutlinedIcons.favorite,
                                        selected_icon: FilledIcons.favorite,
                                        text: "Favorites",
                                    },
                                    {
                                        icon: OutlinedIcons.delete,
                                        selected_icon: FilledIcons.delete,
                                        text: "Trash",
                                    }
                                ]
                            },
                            {
                                title: "Labels",
                                items: [
                                    {
                                        icon: OutlinedIcons.bookmark,
                                        selected_icon: FilledIcons.bookmark,
                                        text: "Family",
                                    },
                                    {
                                        icon: OutlinedIcons.bookmark,
                                        selected_icon: FilledIcons.bookmark,
                                        text: "School",
                                    },
                                    {
                                        icon: OutlinedIcons.bookmark,
                                        selected_icon: FilledIcons.bookmark,
                                        text: "Work",
                                    },
                                ]
                            }
                        ];
                    }

                    HorizontalLayout {
                        alignment: center;

                        TextButton {
                            text: "Show modal navigation drawer";

                            clicked => {
                                modal_navigation_drawer.show();
                            }
                        }
                    }
                }
            }

            ComponentCard {
                title: "Navigation rail";

                Horizontal {
                    alignment: center;

                    NavigationRail {
                        height: 500px;
                        fab_icon: FilledIcons.edit;
                        alignment: center;

                        items: [
                            {
                                icon: OutlinedIcons.inbox,
                                selected_icon: FilledIcons.inbox,
                                text: "Inbox",
                            },
                            {
                                icon: OutlinedIcons.outbox,
                                selected_icon: FilledIcons.outbox,
                                text: "Outbox",
                            },
                            {
                                icon: OutlinedIcons.favorite,
                                selected_icon: FilledIcons.favorite,
                                text: "Favorites",
                            },
                            {
                                icon: OutlinedIcons.delete,
                                selected_icon: FilledIcons.delete,
                                text: "Trash",
                            }
                        ];
                    }
                }
            }

            ComponentCard {
                title: "Tabs";

                Horizontal {
                    TabBar {
                        items: [
                         {
                             text: "Video",
                             icon: OutlinedIcons.video_chat,
                         },
                         {
                             text: "Photos",
                             icon: OutlinedIcons.image,
                         },
                            {
                                text: "Audio",
                                icon: OutlinedIcons.music_note,
                            },
                        ];
                    }
                }
            }

            ComponentCard {
                title: "Top app bars";

                Vertical {
                    CenterAlignedTopAppBar {
                        leading-button: { icon: FilledIcons.menu };
                        trailing-buttons: [
                            { icon: FilledIcons.account_circle },
                        ];
                        title: "Product";
                    }

                    TopAppBar {
                        leading-button: { icon: FilledIcons.menu };
                        title: "Small";
                        trailing-buttons: [
                            { icon: FilledIcons.calendar_month },
                            { icon: FilledIcons.more_vert },
                        ];
                    }

                    MediumTopAppBar {
                        leading-button: { icon: FilledIcons.menu };
                        title: "Medium";
                        trailing-buttons: [
                            { icon: FilledIcons.calendar_month },
                            { icon: FilledIcons.more_vert },
                        ];
                    }

                    MediumFlexibleTopAppBar {
                        leading-button: { icon: FilledIcons.menu };
                        title: "Medium flexible";
                        subtitle: "With subtitle";
                        trailing-buttons: [
                            { icon: FilledIcons.calendar_month },
                            { icon: FilledIcons.more_vert },
                        ];
                    }

                    LargeTopAppBar {
                        leading-button: { icon: FilledIcons.menu };
                        title: "Large";
                        trailing-buttons: [
                            { icon: FilledIcons.calendar_month },
                            { icon: FilledIcons.more_vert },
                        ];
                    }

                    LargeFlexibleTopAppBar {
                        leading-button: { icon: FilledIcons.menu };
                        title: "Large flexible";
                        subtitle: "With subtitle";
                        trailing-buttons: [
                            { icon: FilledIcons.calendar_month },
                            { icon: FilledIcons.more_vert },
                        ];
                    }
                }
            }
        }

        Group {
            title: "Selection";

            ComponentCard {
                title: "Checkboxes";

                Vertical {
                    CheckBoxTile {
                        text: "Option 1";
                        tristate: true;
                    }

                    CheckBoxTile {
                        text: "Option 2";
                    }

                    CheckBoxTile {
                        text: "Option 3";
                        tristate: true;
                        has-error: true;
                    }

                    CheckBoxTile {
                        text: "Option 4";
                        enabled: false;
                        check_state: CheckState.checked;
                    }
                }
            }

            ComponentCard {
                title: "RadioButtons";

                Vertical {
                    RadioButtonTile {
                        text: "Option 1";
                        checked: NavigationViewAdapter.radio_buttons[0];

                        radio_button_clicked => {
                            NavigationViewAdapter.radio_button_clicked(0);
                        }
                    }

                    RadioButtonTile {
                        text: "Option 2";
                        checked: NavigationViewAdapter.radio_buttons[1];

                        radio_button_clicked => {
                            NavigationViewAdapter.radio_button_clicked(1);
                        }
                    }

                    RadioButtonTile {
                        text: "Option 3";
                        checked: NavigationViewAdapter.radio_buttons[2];

                        radio_button_clicked => {
                            NavigationViewAdapter.radio_button_clicked(2);
                        }
                    }

                    RadioButtonTile {
                        text: "Option 4";
                        enabled: false;
                    }
                }
            }

            ComponentCard {
                title: "Chips";

                Vertical {
                    Horizontal {
                        ActionChip {
                            text: "Assist";
                            icon: OutlinedIcons.calendar_month;
                        }

                        fc := FilterChip {
                            checked: true;
                            text: "Filter";
                        }

                        InputChip {
                            text: "Input";
                            trailing_icon: OutlinedIcons.delete;
                        }

                        ActionChip {
                            text: "Suggestion";
                        }
                    }

                    Horizontal {
                        ActionChip {
                            text: "Assist";
                            icon: OutlinedIcons.calendar_month;
                            enabled: false;
                        }

                        FilterChip {
                            checked: fc.checked;
                            text: "Filter";
                            enabled: false;
                        }

                        InputChip {
                            text: "Input";
                            enabled: false;
                        }

                        ActionChip {
                            text: "Suggestion";
                            enabled: false;
                        }
                    }
                }
            }

            ComponentCard {
                title: "Menus";

                Horizontal {
                    alignment: space_around;
                    spacing: 12px;

                    Rectangle {
                        width: menu_button.preferred-width;
                        height: menu_button.preferred-height;

                        menu_button := TextButton {
                            width: 100%;
                            height: 100%;
                            text: "Menu";

                            clicked => {
                                menu.show();
                            }
                        }

                        menu := PopupMenu {
                            width: 100%;
                            height: 100%;
                            items: [
                                { icon: OutlinedIcons.account_box, text: "Inbox" },
                                { icon: OutlinedIcons.outbox, text: "Outbox", trailing_text: "Ctrl C" },
                                { icon: OutlinedIcons.favorite, text: "Favorites" },
                                { icon: OutlinedIcons.delete, text: "Trash", disabled: true },
                            ];
                        }
                    }

                    Rectangle {
                        width: select_menu_button.preferred-width;
                        height: select_menu_button.preferred-height;

                        select_menu_button := TextButton {
                            width: 100%;
                            height: 100%;
                            text: "Selectable";

                            clicked => {
                                select_menu.show();
                            }
                        }

                        select_menu := PopupMenu {
                            width: 100%;
                            height: 100%;
                            item-kind: MenuItemKind.selectable;
                            items: [
                                { icon: OutlinedIcons.account_box, text: "Inbox", selected: true, selected_icon: OutlinedIcons.check },
                                { icon: OutlinedIcons.outbox, text: "Outbox" },
                                { icon: OutlinedIcons.favorite, text: "Favorites" },
                            ];
                        }
                    }

                    Rectangle {
                        width: vibrant_menu_button.preferred-width;
                        height: vibrant_menu_button.preferred-height;

                        vibrant_menu_button := TextButton {
                            width: 100%;
                            height: 100%;
                            text: "Vibrant";

                            clicked => {
                                vibrant_menu.show();
                            }
                        }

                        vibrant_menu := PopupMenu {
                            width: 100%;
                            height: 100%;
                            variant: MenuVariant.vibrant;
                            item-kind: MenuItemKind.checkable;
                            items: [
                                { text: "Checked", checked: true, selected_icon: OutlinedIcons.check },
                                { icon: OutlinedIcons.favorite, text: "Unchecked", selected_icon: OutlinedIcons.check },
                            ];
                        }
                    }
                }
            }

            ComponentCard {
                title: "Menu groups";

                Horizontal {
                    alignment: center;

                    Rectangle {
                        width: groups_menu_button.preferred-width;
                        height: groups_menu_button.preferred-height;

                        groups_menu_button := TextButton {
                            width: 100%;
                            height: 100%;
                            text: "Show groups";

                            clicked => {
                                groups_menu.show();
                            }
                        }

                        groups_menu := PopupMenu {
                            width: 100%;
                            height: 100%;
                            groups: [
                                { label: "File", items: [{ icon: OutlinedIcons.bookmark, text: "New" }, { text: "Open" }] },
                                { label: "Edit", items: [{ text: "Copy" }, { text: "Paste" }] },
                            ];
                        }
                    }
                }
            }

            ComponentCard {
                title: "Time picker";

                Horizontal {
                    alignment: center;

                    TextButton {
                        icon: OutlinedIcons.schedule;
                        text: "Show time picker";

                        clicked => {
                            time_picker.show();
                        }
                    }
                }
            }

            ComponentCard {
                title: "Date picker";

                Horizontal {
                    alignment: center;

                    TextButton {
                        icon: OutlinedIcons.calendar_month;
                        text: "Show date picker";

                        clicked => {
                            date_picker.show();
                        }
                    }
                }
            }

            ComponentCard {
                title: "DropDown menu";

                Horizontal {
                    DropDownMenu {
                        label: "Icon";
                        leading_icon: OutlinedIcons.search;
                        items:
                        [
                            { icon: OutlinedIcons.bookmark, text: "Bookmark" },
                            { icon: OutlinedIcons.explore, text: "Explore" },
                            { icon: OutlinedIcons.chat_bubble, text: "Chat" },
                            { icon: OutlinedIcons.favorite, text: "Favorite" },
                        ];
                    }
                }
            }

            ComponentCard {
                title: "Switches";

                Vertical {
                    Horizontal {
                        alignment: space_around;

                        Switch {}

                        Switch {
                            off_icon: FilledIcons.close;
                            on_icon: FilledIcons.check;
                        }
                    }

                    Horizontal {
                        alignment: space_around;

                        Switch {
                            enabled: false;
                        }

                        Switch {
                            enabled: false;
                            on_icon: FilledIcons.check;
                            off_icon: FilledIcons.close;
                        }
                    }
                }
            }

            ComponentCard {
                title: "Sliders";

                Vertical {
                    spacing: MaterialStyleMetrics.size_24;
                    Horizontal {
                        Slider {
                            value: 50;
                        }
                    }

                    Horizontal {
                        Slider {
                            stop_count: 5;
                        }
                    }
                }
            }
        }

        Group {
            title: "Lists";

            ComponentCard {
                title: "Lists";

                Vertical {

                    ListTile {
                        text: "Inbox";
                        supporting_text: "12 new messages";
                        avatar_icon: FilledIcons.inbox;
                        avatar_background: MaterialPalette.primary_container;
                        avatar_foreground: MaterialPalette.on_primary_container;
                        interactive: true;
                        clicked => { self.selected = !self.selected; }
                    }

                    ListTile {
                        text: "Bookmarks";
                        supporting_text: "Messages you marked";
                        avatar_icon: FilledIcons.bookmark;
                        avatar_background: MaterialPalette.secondary_container;
                        avatar_foreground: MaterialPalette.on_secondary_container;
                        selectable: true;
                        trailing_icon: FilledIcons.bookmark;
                    }

                    ListTile {
                        text: "Outbox";
                        avatar_icon: OutlinedIcons.outbox;
                    }

                    ListTile {
                        text: "Trash";
                        supporting_text: "Disabled";
                        avatar_icon: OutlinedIcons.delete;
                        enabled: false;
                    }
                }
            }

            ComponentCard {
                title: "Segmented lists";

                Vertical {

                    SegmentedListItem {
                        text: "Today";
                        supporting_text: "Selected";
                        index: 0;
                        count: 3;
                        selectable: true;
                        selected: true;
                    }

                    SegmentedListItem {
                        text: "This week";
                        index: 1;
                        count: 3;
                        selectable: true;
                    }

                    SegmentedListItem {
                        text: "This month";
                        index: 2;
                        count: 3;
                        interactive: true;
                    }
                }
            }
        }

        Group {
            title: "Text inputs";

            ComponentCard {
                title: "Text fields";

                Vertical {
                    Horizontal {
                        top_tf := TextField {
                            leading_icon: FilledIcons.search;
                            trailing_icon: FilledIcons.close;
                            label: "Filled";
                            placeholder_text: "hint text";
                            supporting_text: "supporting text";

                            leading_icon_clicked => {
                                self.focus();
                            }

                            trailing_icon_clicked => {
                                self.text = "";
                            }
                        }
                    }

                    Horizontal {
                        TextField {
                            text <=> top_tf.text;
                            leading_icon: FilledIcons.search;
                            trailing_icon: FilledIcons.close;
                            label: "Filled";
                            placeholder_text: "hint text";
                            supporting_text: "error text";
                            has_error: true;

                            leading_icon_clicked => {
                                self.focus();
                            }

                            trailing_icon_clicked => {
                                self.text = "";
                            }
                        }

                        TextField {
                            text <=> top_tf.text;
                            leading_icon: FilledIcons.search;
                            trailing_icon: FilledIcons.close;
                            label: "Filled";
                            placeholder_text: "hint text";
                            supporting_text: "supporting text";
                            enabled: false;
                        }
                    }
                }
            }
        }
    }

    modal_navigation_drawer := ModalNavigationDrawer {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: MainWindowAdapter.width;
        height: MainWindowAdapter.height;
        position_right: true;
        groups: [
            {
                title: "Mail",
                items: [
                    {
                        icon: OutlinedIcons.inbox,
                        selected_icon: FilledIcons.inbox,
                        text: "Inbox",
                    },
                    {
                        icon: OutlinedIcons.outbox,
                        selected_icon: FilledIcons.outbox,
                        text: "Outbox",
                    },
                    {
                        icon: OutlinedIcons.favorite,
                        selected_icon: FilledIcons.favorite,
                        text: "Favorites",
                    },
                    {
                        icon: OutlinedIcons.delete,
                        selected_icon: FilledIcons.delete,
                        text: "Trash",
                    }
                ]
            },
            {
                title: "Labels",
                items: [
                    {
                        icon: OutlinedIcons.bookmark,
                        selected_icon: FilledIcons.bookmark,
                        text: "Family",
                    },
                    {
                        icon: OutlinedIcons.bookmark,
                        selected_icon: FilledIcons.bookmark,
                        text: "School",
                    },
                    {
                        icon: OutlinedIcons.bookmark,
                        selected_icon: FilledIcons.bookmark,
                        text: "Work",
                    },
                ]
            }
        ];
    }

    time_picker := TimePickerPopup {
        // this is used to place the popup on 0,0 of the window and also to fill the window
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: MainWindowAdapter.width;
        height: MainWindowAdapter.height;
        title: @tr("Select time");

        ok => {
            time_picker.close();
        }
    }

    date_picker := DatePickerPopup {
        // this is used to place the popup on 0,0 of the window and also to fill the window
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: MainWindowAdapter.width;
        height: MainWindowAdapter.height;
        title: @tr("Select date");
    }
}
