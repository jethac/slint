import { Palette } from "std-widgets.slint";
import {
    Dialog,
    DropDownMenu,
    MenuItem,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTheme,
    MaterialTypography,
    ScrollView,
    ConnectedButtonGroup,
    Slider,
    Switch,
    TextButton,
} from "../../../../src/material.slint";

// Live controls for `MaterialTheme`: every change regenerates the scheme and
// updates the whole gallery.
export component SchemeDialog inherits Dialog {
    title: "Dynamic scheme";
    default_action_text: "Done";

    property <[image]> seed_images: [
        @image-url("../../images/seed_sunset.png"),
        @image-url("../../images/seed_ocean.png"),
        @image-url("../../images/seed_forest.png"),
    ];

    property <[color]> seed_colors: [
        #6750a4,
        #2379f4,
        #b33b15,
        #63a002,
        #00696f,
        #8d4379,
    ];

    property <[MenuItem]> variants: [
        { text: "Monochrome", enabled: true },
        { text: "Neutral", enabled: true },
        { text: "Tonal Spot", enabled: true },
        { text: "Vibrant", enabled: true },
        { text: "Expressive", enabled: true },
        { text: "Fidelity", enabled: true },
        { text: "Content", enabled: true },
        { text: "Rainbow", enabled: true },
        { text: "Fruit Salad", enabled: true },
        { text: "CMF", enabled: true },
    ];

    pure function scheme_variant(index: int) -> MaterialSchemeVariant {
        index == 0 ? MaterialSchemeVariant.monochrome
            : index == 1 ? MaterialSchemeVariant.neutral
            : index == 2 ? MaterialSchemeVariant.tonal-spot
            : index == 3 ? MaterialSchemeVariant.vibrant
            : index == 4 ? MaterialSchemeVariant.expressive
            : index == 5 ? MaterialSchemeVariant.fidelity
            : index == 6 ? MaterialSchemeVariant.content
            : index == 7 ? MaterialSchemeVariant.rainbow
            : index == 8 ? MaterialSchemeVariant.fruit-salad
            : MaterialSchemeVariant.cmf
    }

    pure function variant_index(variant: MaterialSchemeVariant) -> int {
        variant == MaterialSchemeVariant.monochrome ? 0
            : variant == MaterialSchemeVariant.neutral ? 1
            : variant == MaterialSchemeVariant.tonal-spot ? 2
            : variant == MaterialSchemeVariant.vibrant ? 3
            : variant == MaterialSchemeVariant.expressive ? 4
            : variant == MaterialSchemeVariant.fidelity ? 5
            : variant == MaterialSchemeVariant.content ? 6
            : variant == MaterialSchemeVariant.rainbow ? 7
            : variant == MaterialSchemeVariant.fruit-salad ? 8
            : 9
    }

    pure function spec_version(index: int) -> MaterialSpecVersion {
        index == 0 ? MaterialSpecVersion.spec2021
            : index == 1 ? MaterialSpecVersion.spec2025
            : MaterialSpecVersion.spec2026
    }

    pure function spec_index(version: MaterialSpecVersion) -> int {
        version == MaterialSpecVersion.spec2021 ? 0
            : version == MaterialSpecVersion.spec2025 ? 1
            : 2
    }

    function select_seed(seed: color) {
        MaterialPalette.dynamic = true;
        MaterialTheme.use-platform-color = false;
        MaterialTheme.seed-color = seed;
    }

    default_action_clicked => {
        root.close();
    }

    ScrollView {
        width: min(380px, root.width - 2 * MaterialStyleMetrics.padding_24);
        height: min(460px, root.height - 160px);

        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;

            HorizontalLayout {
                MaterialText {
                    text: "Use platform colors";
                    style: MaterialTypography.title_medium;
                    color: MaterialPalette.on_surface;
                    vertical_alignment: center;
                }

                Rectangle {}

                platform_switch := Switch {
                    checked <=> MaterialTheme.use-platform-color;
                }
            }

            MaterialText {
                text: "Seed color";
                style: MaterialTypography.title_medium;
                color: MaterialPalette.on_surface;
                opacity: MaterialTheme.use-platform-color ? 0.38 : 1;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                opacity: MaterialTheme.use-platform-color ? 0.38 : 1;

                for seed in root.seed_colors: Rectangle {
                    width: MaterialStyleMetrics.size_40;
                    height: MaterialStyleMetrics.size_40;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    background: seed;
                    border_width: MaterialTheme.seed-color == seed ? 3px : 0;
                    border_color: MaterialPalette.outline;

                    seed_swatch := TouchArea {
                        clicked => {
                            root.select_seed(seed);
                        }
                    }
                }
            }

            MaterialText {
                text: "Seed from image";
                style: MaterialTypography.title_medium;
                color: MaterialPalette.on_surface;
                opacity: MaterialTheme.use-platform-color ? 0.38 : 1;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                opacity: MaterialTheme.use-platform-color ? 0.38 : 1;

                for seed_image in root.seed_images: Rectangle {
                    width: MaterialStyleMetrics.size_64;
                    height: MaterialStyleMetrics.size_64;
                    border_radius: MaterialStyleMetrics.border_radius_8;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: seed_image;
                        image-fit: cover;
                    }

                    image_seed := TouchArea {
                        clicked => {
                            root.select_seed(MaterialColors.seed-from-image(seed_image));
                        }
                    }
                }
            }

            MaterialText {
                text: "Variant";
                style: MaterialTypography.title_medium;
                color: MaterialPalette.on_surface;
            }

            variant_menu := DropDownMenu {
                items: root.variants;
                current_index: root.variant_index(MaterialTheme.variant);

                selected(index) => {
                    MaterialPalette.dynamic = true;
                    MaterialTheme.variant = root.scheme_variant(index);
                }
            }

            MaterialText {
                text: "Spec version";
                style: MaterialTypography.title_medium;
                color: MaterialPalette.on_surface;
            }

            spec_buttons := ConnectedButtonGroup {
                selected_index: root.spec_index(MaterialTheme.spec-version);
                items: [
                    { text: "2021" },
                    { text: "2025" },
                    { text: "2026" },
                ];

                selected_index_changed(index) => {
                    MaterialPalette.dynamic = true;
                    MaterialTheme.spec-version = root.spec_version(index);
                }
            }

            MaterialText {
                text: "Device";
                style: MaterialTypography.title_medium;
                color: MaterialPalette.on_surface;
            }

            platform_buttons := ConnectedButtonGroup {
                selected_index: MaterialTheme.platform == MaterialSchemePlatform.phone ? 0 : 1;
                items: [
                    { text: "Phone" },
                    { text: "Watch" },
                ];

                selected_index_changed(index) => {
                    MaterialPalette.dynamic = true;
                    MaterialTheme.platform = index == 0 ? MaterialSchemePlatform.phone : MaterialSchemePlatform.watch;
                }
            }

            HorizontalLayout {
                MaterialText {
                    text: "Contrast: \{Math.round(MaterialTheme.contrast-level * 100) / 100}";
                    style: MaterialTypography.title_medium;
                    color: MaterialPalette.on_surface;
                    vertical_alignment: center;
                }

                Rectangle {}

                TextButton {
                    text: "System";

                    clicked => {
                        MaterialTheme.contrast-level = MaterialColors.platform-contrast-level();
                    }
                }
            }

            contrast_slider := Slider {
                minimum: -1;
                maximum: 1;
                value <=> MaterialTheme.contrast-level;

                value_changed(value) => {
                    MaterialPalette.dynamic = true;
                }
            }

            HorizontalLayout {
                MaterialText {
                    text: "Dark theme";
                    style: MaterialTypography.title_medium;
                    color: MaterialPalette.on_surface;
                    vertical_alignment: center;
                }

                Rectangle {}

                dark_switch := Switch {
                    checked: Palette.color-scheme == ColorScheme.dark;

                    checked_state_changed(checked) => {
                        Palette.color-scheme = checked ? ColorScheme.dark : ColorScheme.light;
                    }
                }
            }
        }
    }
}
