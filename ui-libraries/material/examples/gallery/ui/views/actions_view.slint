import {
    ElevatedCard,
    FilledCard,
    OutlinedCard,
    MaterialText,
    MaterialPalette,
    MaterialTypography,
    ElevatedButton,
    FilledButton,
    TonalButton,
    OutlineButton,
    TextButton,
    FloatingActionButton,
    FABStyle,
    IconButton,
    Vertical,
    Horizontal,
    Grid,
    FilledIconButton,
    TonalIconButton,
    OutlineIconButton,
    SegmentedButton,
    FilledSplitButton,
    TonalSplitButton,
    ElevatedSplitButton,
    OutlineSplitButton,
    ScrollView,
    NavigationBar,
    CircularProgressIndicator,
    LinearProgressIndicator,
    SnackBar,
    ModalBottomSheet,
    MaterialText,
    MaterialStyleMetrics,
    MaterialButtonSize,
    MaterialButtonShape,
    IconButtonWidth,
    HorizontalDivider,
    VerticalDivider,
    Badge,
    Dialog,
    FullscreenDialog,
    MaterialAnimations,
    MaterialMotionScheme,
    MaterialTheme,
    Slider,
    Switch
} from "../../../../src/material.slint";

import { Group } from "../components/group.slint";
import { ComponentCard } from "../components/component_card.slint";
import { TextIconButton } from "../components/text_icon_button.slint";
import { MainWindowAdapter } from "../main_window_adapter.slint";
import { FilledIcons, OutlinedIcons } from "../icons.slint";

export component ActionsView {
    property <[MaterialButtonSize]> button_sizes: [
        MaterialButtonSize.extra_small,
        MaterialButtonSize.small,
        MaterialButtonSize.medium,
        MaterialButtonSize.large,
        MaterialButtonSize.extra_large,
    ];
    property <[MaterialButtonShape]> button_shapes: [MaterialButtonShape.round, MaterialButtonShape.square];
    property <[string]> shape_labels: ["round", "square"];
    property <[IconButtonWidth]> icon_widths: [IconButtonWidth.narrow, IconButtonWidth.uniform, IconButtonWidth.wide];
    property <[string]> width_labels: ["narrow", "uniform", "wide"];

    layout := VerticalLayout {
        alignment: start;
        spacing: MaterialStyleMetrics.spacing_8;
        horizontal-stretch: 1;

        Group {
            title: "Actions";

            ComponentCard {
                title: "Common buttons";

                VerticalLayout {
                    spacing: MaterialStyleMetrics.spacing_4;

                    // Rows: shape x size; columns: the five styles.
                    for shape[shape_i] in root.button_shapes: HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: shape_labels[shape_i];
                            width: 48px;
                            vertical_alignment: center;
                        }

                        for size[size_i] in root.button_sizes: Grid {
                            spacing-horizontal: MaterialStyleMetrics.spacing_4;

                            FilledButton {
                                text: "Filled";
                                size: size;
                                button_shape: shape;
                                row: 0;
                                col: size_i;
                            }

                            TonalButton {
                                text: "Tonal";
                                size: size;
                                button_shape: shape;
                                row: 0;
                                col: size_i + 1;
                            }

                            ElevatedButton {
                                text: "Elevated";
                                size: size;
                                button_shape: shape;
                                row: 0;
                                col: size_i + 2;
                            }

                            OutlineButton {
                                text: "Outlined";
                                size: size;
                                button_shape: shape;
                                row: 0;
                                col: size_i + 3;
                            }

                            TextButton {
                                text: "Text";
                                size: size;
                                button_shape: shape;
                                row: 0;
                                col: size_i + 4;
                            }
                        }
                    }

                    // With a leading icon.
                    HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: "icon";
                            width: 48px;
                            vertical_alignment: center;
                        }

                        for size[size_i] in root.button_sizes: Grid {
                            FilledButton {
                                icon: FilledIcons.add;
                                text: "Filled";
                                size: size;
                                row: 0;
                                col: size_i;
                            }

                            TonalButton {
                                icon: FilledIcons.add;
                                text: "Tonal";
                                size: size;
                                row: 0;
                                col: size_i + 1;
                            }

                            ElevatedButton {
                                icon: FilledIcons.add;
                                text: "Elevated";
                                size: size;
                                row: 0;
                                col: size_i + 2;
                            }

                            OutlineButton {
                                icon: FilledIcons.add;
                                text: "Outlined";
                                size: size;
                                row: 0;
                                col: size_i + 3;
                            }

                            TextButton {
                                icon: FilledIcons.add;
                                text: "Text";
                                size: size;
                                row: 0;
                                col: size_i + 4;
                            }
                        }
                    }

                    // Toggle buttons (the four styles that support selection).
                    HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: "toggle";
                            width: 48px;
                            vertical_alignment: center;
                        }

                        for size[size_i] in root.button_sizes: Grid {
                            FilledButton {
                                text: "Filled";
                                size: size;
                                checkable: true;
                                checked: Math.mod(size_i, 2) == 1;
                                row: 0;
                                col: size_i;
                            }

                            TonalButton {
                                text: "Tonal";
                                size: size;
                                checkable: true;
                                checked: Math.mod(size_i, 2) == 0;
                                row: 0;
                                col: size_i + 1;
                            }

                            ElevatedButton {
                                text: "Elevated";
                                size: size;
                                checkable: true;
                                row: 0;
                                col: size_i + 2;
                            }

                            OutlineButton {
                                text: "Outlined";
                                size: size;
                                checkable: true;
                                checked: Math.mod(size_i, 2) == 1;
                                row: 0;
                                col: size_i + 3;
                            }
                        }
                    }

                    // Disabled.
                    HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: "off";
                            width: 48px;
                            vertical_alignment: center;
                        }

                        for size[size_i] in root.button_sizes: Grid {
                            FilledButton {
                                text: "Filled";
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i;
                            }

                            TonalButton {
                                text: "Tonal";
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i + 1;
                            }

                            ElevatedButton {
                                text: "Elevated";
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i + 2;
                            }

                            OutlineButton {
                                text: "Outlined";
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i + 3;
                            }

                            TextButton {
                                text: "Text";
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i + 4;
                            }
                        }
                    }
                }
            }


            ComponentCard {
                title: "Floating Action Buttons";

                Horizontal {
                    alignment: center;

                    VerticalLayout {
                        alignment: center;

                        FloatingActionButton {
                            icon: FilledIcons.add;
                            tooltip: "Small";
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        FloatingActionButton {
                            icon: FilledIcons.add;
                            style: FABStyle.standard;
                            text: "Create";
                            tooltip: "Extended";
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        FloatingActionButton {
                            icon: FilledIcons.add;
                            style: FABStyle.standard;
                            tooltip: "Standard";
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        FloatingActionButton {
                            icon: FilledIcons.add;
                            style: FABStyle.large;
                            tooltip: "Large";
                        }
                    }
                }
            }

            ComponentCard {
                title: "Icon buttons";

                VerticalLayout {
                    spacing: MaterialStyleMetrics.spacing_4;

                    // Rows: width option x size; columns: the four styles.
                    for width[w_i] in root.icon_widths: HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: width_labels[w_i];
                            width: 48px;
                            vertical_alignment: center;
                        }

                        for size[size_i] in root.button_sizes: Grid {
                            spacing-horizontal: MaterialStyleMetrics.spacing_4;

                            IconButton {
                                icon: OutlinedIcons.settings;
                                tooltip: "standard";
                                size: size;
                                width_option: width;
                                row: 0;
                                col: size_i;
                            }

                            FilledIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                width_option: width;
                                row: 0;
                                col: size_i + 1;
                            }

                            TonalIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                width_option: width;
                                row: 0;
                                col: size_i + 2;
                            }

                            OutlineIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                width_option: width;
                                row: 0;
                                col: size_i + 3;
                            }
                        }
                    }

                    // Square and toggles (uniform width).
                    HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: "square";
                            width: 48px;
                            vertical_alignment: center;
                        }

                        for size[size_i] in root.button_sizes: Grid {
                            IconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                button_shape: MaterialButtonShape.square;
                                row: 0;
                                col: size_i;
                            }

                            FilledIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                button_shape: MaterialButtonShape.square;
                                row: 0;
                                col: size_i + 1;
                            }

                            TonalIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                button_shape: MaterialButtonShape.square;
                                row: 0;
                                col: size_i + 2;
                            }

                            OutlineIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                button_shape: MaterialButtonShape.square;
                                row: 0;
                                col: size_i + 3;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: "toggle";
                            width: 48px;
                            vertical_alignment: center;
                        }

                        for size[size_i] in root.button_sizes: Grid {
                            IconButton {
                                icon: OutlinedIcons.settings;
                                checked_icon: FilledIcons.settings;
                                checkable: true;
                                checked: Math.mod(size_i, 2) == 1;
                                size: size;
                                row: 0;
                                col: size_i;
                            }

                            FilledIconButton {
                                icon: OutlinedIcons.settings;
                                checked_icon: FilledIcons.settings;
                                checkable: true;
                                checked: Math.mod(size_i, 2) == 0;
                                size: size;
                                row: 0;
                                col: size_i + 1;
                            }

                            TonalIconButton {
                                icon: OutlinedIcons.settings;
                                checked_icon: FilledIcons.settings;
                                checkable: true;
                                checked: Math.mod(size_i, 2) == 1;
                                size: size;
                                row: 0;
                                col: size_i + 2;
                            }

                            OutlineIconButton {
                                icon: OutlinedIcons.settings;
                                checked_icon: FilledIcons.settings;
                                checkable: true;
                                checked: Math.mod(size_i, 2) == 0;
                                size: size;
                                row: 0;
                                col: size_i + 3;
                            }
                        }
                    }

                    // Disabled.
                    HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: "off";
                            width: 48px;
                            vertical_alignment: center;
                        }

                        for size[size_i] in root.button_sizes: Grid {
                            IconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i;
                            }

                            FilledIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i + 1;
                            }

                            TonalIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i + 2;
                            }

                            OutlineIconButton {
                                icon: OutlinedIcons.settings;
                                size: size;
                                enabled: false;
                                row: 0;
                                col: size_i + 3;
                            }
                        }
                    }
                }
            }

            ComponentCard {
                title: "Segmented buttons";

                Vertical {
                    HorizontalLayout {
                        alignment: center;

                        SegmentedButton {
                            items: [
                                {  icon: OutlinedIcons.today, text: "Day" },
                                {  icon: OutlinedIcons.view_week, text: "Week" },
                                {  icon: OutlinedIcons.calendar_month, text: "Month" },
                            ];
                        }
                    }

                    HorizontalLayout {
                        alignment: center;

                        SegmentedButton {
                            current_index: 4;

                            items: [
                                { text: "XS" },
                                { text: "S" },
                                { text: "M" },
                                { text: "L" },
                                { text: "XL" },
                            ];
                        }
                    }
                }
            }

            ComponentCard {
                title: "Split buttons";

                Vertical {
                    // Rows: styles x the five sizes; the trailing menu button
                    // toggles a popup menu.
                    HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        FilledSplitButton {
                            text: "Filled";
                            size: MaterialButtonSize.medium;
                        }

                        TonalSplitButton {
                            text: "Tonal";
                            size: MaterialButtonSize.medium;
                        }

                        ElevatedSplitButton {
                            text: "Elevated";
                            size: MaterialButtonSize.medium;
                        }

                        OutlineSplitButton {
                            text: "Outlined";
                            size: MaterialButtonSize.medium;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: MaterialStyleMetrics.spacing_8;

                        for size[size_i] in root.button_sizes: FilledSplitButton {
                            text: "Label";
                            icon: FilledIcons.edit;
                            size: size;
                            menu_items: [
                                { text: "Undo" },
                                { text: "Redo" },
                            ];
                        }
                    }
                }
            }
        }

        Group {
            title: "Communication";

            ComponentCard {
                title: "Badges";

                HorizontalLayout {
                    alignment: start;
                    spacing: MaterialStyleMetrics.spacing_8;
                    padding-bottom: MaterialStyleMetrics.spacing_8;

                    Badge {
                        text: "3";
                    }

                    Badge {
                        text: "999+";
                    }
                }

                NavigationBar {
                    items: [
                          {
                             icon: OutlinedIcons.mail,
                             selected_icon: FilledIcons.mail,
                             text: "Mail",
                             badge: "999+"
                          },
                          {
                             icon: OutlinedIcons.chat_bubble,
                             selected_icon: FilledIcons.chat_bubble,
                             text: "Chat",
                             badge: "10"
                          },
                          {
                             icon: OutlinedIcons.group,
                             selected_icon: FilledIcons.group,
                             text: "Rooms",
                             show_badge: true
                          },
                          {
                             icon: OutlinedIcons.video_chat,
                             selected_icon: FilledIcons.video_chat,
                             text: "Meet",
                             badge: "3"
                          },
                    ];
                }
            }

            ComponentCard {
                title: "Progress indicators";

                Horizontal {
                    IconButton {
                        icon: pi.indeterminate ? FilledIcons.pause :
                            FilledIcons.play_arrow;

                        clicked => {
                            pi.indeterminate = !pi.indeterminate;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        pi := CircularProgressIndicator {
                            progress: 0.5;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        LinearProgressIndicator {
                            indeterminate: pi.indeterminate;
                            progress: 0.5;
                        }
                    }
                }
            }

            ComponentCard {
                title: "Snackbar";

                Horizontal {
                    alignment: center;

                    TextButton {
                        text: "Show snackbar";

                        clicked => {
                            snackbar.show();
                        }
                    }
                }
            }

            ComponentCard {
                title: "Containment";

                Horizontal {
                    alignment: center;

                    TextButton {
                        text: "Show modal bottom sheet";

                        clicked => {
                            modal_bottom_sheet.show();
                        }
                    }
                }
            }

            ComponentCard {
                title: "Cards";

                Horizontal {
                    alignment: center;

                    ElevatedCard {
                        width: 92px;
                        height: self.width;

                        Vertical {
                            alignment: space_between;

                            HorizontalLayout {
                                alignment: end;

                                IconButton {
                                    icon: OutlinedIcons.more_vert;
                                }
                            }

                            MaterialText {
                                text: "Elevated";
                            }
                        }
                    }

                    FilledCard {
                        width: 92px;
                        height: self.width;

                        Vertical {
                            alignment: space_between;

                            HorizontalLayout {
                                alignment: end;

                                IconButton {
                                    icon: OutlinedIcons.more_vert;
                                }
                            }

                            MaterialText {
                                text: "Filled";
                            }
                        }
                    }

                    OutlinedCard {
                        width: 92px;
                        height: self.width;

                        Vertical {
                            alignment: space_between;

                            HorizontalLayout {
                                alignment: end;

                                IconButton {
                                    icon: OutlinedIcons.more_vert;
                                }
                            }

                            MaterialText {
                                text: "Outlined";
                            }
                        }
                    }
                }
            }

            ComponentCard {
                title: "Dialogs";

                Horizontal {
                    alignment: center;

                    TextButton {
                        text: "Show dialog";

                        clicked => {
                            dialog.show();
                        }
                    }

                    TextButton {
                        text: "Show full-screen dialog";

                        clicked => {
                            fullscreen_dialog.show();
                        }
                    }
                }
            }

            ComponentCard {
                title: "Dividers";

                Horizontal {
                    HorizontalDivider {}

                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;
                        height: 40px;

                        VerticalDivider {}
                        VerticalDivider {}
                    }
                }
            }
        }
    }


    // popups

    modal_bottom_sheet := ModalBottomSheet {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: MainWindowAdapter.width;
        height: MainWindowAdapter.height;

        TextIconButton {
            icon: OutlinedIcons.share;
            text: "Share";
        }

        TextIconButton {
            icon: OutlinedIcons.add;
            text: "Add to";
        }

        TextIconButton {
            icon: OutlinedIcons.delete;
            text: "Trash";
        }

        TextIconButton {
            icon: OutlinedIcons.archive;
            text: "Archive";
        }

        TextIconButton {
            icon: OutlinedIcons.settings;
            text: "Settings";
        }

        Group {
            title: "Theme";

            ComponentCard {
                title: "Motion & contrast";

                Horizontal {
                    alignment: center;

                    SegmentedButton {
                        items: [
                            { text: "Expressive" },
                            { text: "Standard" },
                        ];
                        current_index: MaterialAnimations.motion-scheme == MaterialMotionScheme.expressive ? 0 : 1;

                        index_changed(index) => {
                            MaterialAnimations.motion-scheme = index == 0 ? MaterialMotionScheme.expressive : MaterialMotionScheme.standard;
                        }
                    }
                }

                Horizontal {
                    alignment: center;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Reduced motion";
                        vertical_alignment: center;
                    }

                    Switch {
                        checked <=> MaterialPalette.reduced-motion;
                    }
                }

                Horizontal {
                    alignment: center;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Contrast";
                        vertical_alignment: center;
                    }

                    Slider {
                        minimum: -1;
                        maximum: 1;
                        value <=> MaterialTheme.contrast-level;
                        width: 220px;
                    }

                    MaterialText {
                        text: MaterialTheme.contrast-level.to-fixed(2);
                        vertical_alignment: center;
                    }
                }
            }
        }
    }

    snackbar := SnackBar {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: MainWindowAdapter.width;
        height: MainWindowAdapter.height;
        text: "This is a snackbar";
        action_text: "Close";
    }

     dialog := Dialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: MainWindowAdapter.width;
        height: MainWindowAdapter.height;
        title: "What is a dialog?";
        default_action_text: "Okay";
        actions: ["Dismiss"];

        MaterialText {
            max_width: 400px;
            text: "A dialog is a type of modal window that appears in front of app content to provide critical information, or prompt for a decision to be made.";
            wrap: word_wrap;
        }

        action_clicked(index) => {
            dialog.close();
        }

        default_action_clicked => {
            dialog.close();
        }
     }

     fullscreen_dialog := FullscreenDialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: MainWindowAdapter.width;
        height: MainWindowAdapter.height;
        title: "Full-screen dialog";
        actions: ["Close"];

        Rectangle {}

        action_clicked() => {
            fullscreen_dialog.close();
        }
     }
}
