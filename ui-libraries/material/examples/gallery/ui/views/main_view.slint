import { ComponentsView } from "components_view.slint";
import { SchemeDialog } from "scheme_dialog.slint";
import { Palette } from "std-widgets.slint";
import { MainWindowAdapter } from "../main_window_adapter.slint";
import { FilledIcons, OutlinedIcons } from "../icons.slint";
import {
    MaterialText,
    MaterialTypography,
    IconButton,
    MaterialPalette,
    MaterialTheme,
    MaterialAnimations,
    NavigationRail,
    NavigationItem,
    NavigationBar,
    TopAppBar,
    PopupMenu,
    MenuItem,
    MaterialStyleMetrics
} from "../../../../src/material.slint";

export enum Views {
    components
}

export global MainViewAdapter {
    in_out property <[MenuItem]> palettes: [
        { text: "Slint" },
        { text: "Purple" },
        { text: "Red" },
        { text: "Green" },
        { text: "Dynamic accent" },
        { text: "Dynamic slint" },
        { text: "Dynamic purple" },
        { text: "Dynamic red" },
        { text: "Dynamic green" },
    ];

    // Index of the first entry in `palettes` that selects a runtime-generated
    // scheme instead of a static Theme Builder one.
    out property <int> first_dynamic_palette: 4;

    callback load_palette(index: int);
}

export component MainView {
    property <Views> current_view: Views.components;
    property <[NavigationItem]> navigation_items: [
        {
            text: "Components",
            icon: OutlinedIcons.dashboard,
            selected_icon: FilledIcons.dashboard
        }
    ];

    VerticalLayout {
        app_bar := TopAppBar {
            title: "Material 3";
            trailing-buttons: [
                { icon: OutlinedIcons.palette },
                { icon: OutlinedIcons.settings },
                { icon: Palette.color_scheme == ColorScheme.light ? OutlinedIcons.dark_mode : OutlinedIcons.light_mode }
            ];

            trailing-button-clicked(index) => {
                if index == 0 {
                    color_menu.show();
                }

                if index == 1 {
                    // Changes in the dialog configure the runtime scheme, so
                    // make the dynamic palette active while it is open.
                    MaterialPalette.dynamic = true;
                    scheme_dialog.show();
                }

                if index == 2 {

                    if Palette.color_scheme == ColorScheme.light {
                        Palette.color_scheme = ColorScheme.dark;
                        return;
                    }

                    Palette.color_scheme = ColorScheme.light;
                }
            }
        }

        scheme_dialog := SchemeDialog {
            x: -root.absolute_position.x;
            y: -root.absolute_position.y;
            width: MainWindowAdapter.width;
            height: MainWindowAdapter.height;
        }

        Rectangle {
            background: MaterialPalette.background;

            if !MainWindowAdapter.break_layout : HorizontalLayout {

                if root.current_view == Views.components : ComponentsView {
                    horizontal_stretch: 1;
                }
            }

            if MainWindowAdapter.break_layout : VerticalLayout {
                if root.current_view == Views.components : ComponentsView {
                    horizontal_stretch: 1;
                }
            }
        }
    }

    color_menu := PopupMenu {
        x: root.width - MaterialStyleMetrics.size_200 - MaterialStyleMetrics.padding_16;
        y: app_bar.height / 2;
        items: MainViewAdapter.palettes;

        activated(index) => {
            if index < MainViewAdapter.first_dynamic_palette {
                MaterialPalette.dynamic = false;
                MaterialTheme.use-platform-color = false;
                MainViewAdapter.load_palette(index);
            } else {
                MaterialPalette.dynamic = true;
                // The seeds match the seed fields of the Theme Builder
                // JSON files, so a dynamic scheme can be compared with
                // its static counterpart.
                if index == MainViewAdapter.first_dynamic_palette {
                    MaterialTheme.use-platform-color = true;
                } else if index == MainViewAdapter.first_dynamic_palette + 1 {
                    MaterialTheme.use-platform-color = false;
                    MaterialTheme.seed-color = #2379f4;
                } else if index == MainViewAdapter.first_dynamic_palette + 2 {
                    MaterialTheme.use-platform-color = false;
                    MaterialTheme.seed-color = #6750a4;
                } else if index == MainViewAdapter.first_dynamic_palette + 3 {
                    MaterialTheme.use-platform-color = false;
                    MaterialTheme.seed-color = #b33b15;
                } else {
                    MaterialTheme.use-platform-color = false;
                    MaterialTheme.seed-color = #63a002;
                }
            }
            color_menu.close();
        }
    }
}
