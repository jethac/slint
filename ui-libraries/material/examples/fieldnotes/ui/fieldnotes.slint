import {
    MaterialWindow, MaterialText, MaterialTypography, MaterialPalette, MaterialTheme,
    MaterialAnimations, MaterialMotionScheme, NavigationRail, NavigationBar, NavigationItem,
    TopAppBar, FilledButton, FilterChip, SegmentedListItem, IconButton,
    TextField, Dialog, Switch, ScrollView, Icons, HorizontalDivider,
} from "../../../src/material.slint";
import { Palette } from "std-widgets.slint";

export struct Task {
    id: int,
    title: string,
    note: string,
    completed: bool,
}

export component Fieldnotes inherits MaterialWindow {
    title: "Fieldnotes — Material 3 Expressive";
    preferred-width: 1000px;
    preferred-height: 760px;
    min-width: 360px;
    min-height: 520px;

    in property <[Task]> tasks;
    in property <int> total-count;
    in property <int> completed-count;
    in-out property <int> filter;
    in-out property <int> page;
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    in-out property <bool> reduced-motion: Palette.reduced-motion;
    in-out property <string> draft-title;
    in-out property <string> draft-note;
    in-out property <string> form-error;
    out property <bool> compact: root.width < 720px;
    out property <bool> editor-open;

    callback save-task(title: string, note: string) -> bool;
    callback toggle-task(id: int);
    callback edit-task(id: int);
    callback new-task();
    callback filter-changed(filter: int);

    property <[NavigationItem]> destinations: [
        { text: "My day", icon: Icons.schedule, selected-icon: Icons.schedule },
        { text: "Appearance", icon: @image-url("icons/settings.svg"), selected-icon: @image-url("icons/settings.svg") },
    ];
    property <bool> all-selected: true;
    property <bool> open-selected;
    property <bool> done-selected;

    init => {
        MaterialPalette.dynamic = true;
        MaterialTheme.seed-color = #306c64;
        MaterialTheme.dark = root.dark;
        MaterialPalette.reduced-motion = root.reduced-motion;
        MaterialAnimations.motion-scheme = MaterialMotionScheme.expressive;
    }
    changed dark => { MaterialTheme.dark = root.dark; }
    changed reduced-motion => { MaterialPalette.reduced-motion = root.reduced-motion; }
    changed filter => {
        root.all-selected = root.filter == 0;
        root.open-selected = root.filter == 1;
        root.done-selected = root.filter == 2;
        root.filter-changed(root.filter);
    }

    function select-filter(value: int) {
        root.filter = value;
        root.all-selected = value == 0;
        root.open-selected = value == 1;
        root.done-selected = value == 2;
    }

    public function open-editor() {
        root.editor-open = true;
        editor.show();
    }

    public function close-editor() {
        editor.close();
        root.editor-open = false;
    }

    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        spacing: 0;
        TopAppBar {
            title: "Fieldnotes";
            trailing-buttons: [{ icon: root.dark ? @image-url("icons/light_mode.svg") : @image-url("icons/dark_mode.svg"), enabled: true,
                tooltip: root.dark ? "Use light colors" : "Use dark colors" }];
            trailing-button-clicked(index) => { root.dark = !root.dark; }
        }
        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;
            if !root.compact : NavigationRail {
                items: root.destinations;
                current-index <=> root.page;
            }
            ScrollView {
                horizontal-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                VerticalLayout {
                    padding: root.compact ? 20px : 40px;
                    spacing: 24px;
                    alignment: start;

                    if root.page == 0 : VerticalLayout {
                        spacing: 24px;
                        Rectangle {
                            background: MaterialPalette.primary-container;
                            border-radius: 32px;
                            min-height: root.compact ? 180px : 200px;
                            VerticalLayout {
                                padding: 28px;
                                spacing: 12px;
                                MaterialText {
                                    text: "Make room for\nwhat matters.";
                                    style: root.compact ? MaterialTypography.headline-large : MaterialTypography.display-small;
                                    color: MaterialPalette.on-primary-container;
                                    overflow: clip;
                                }
                                MaterialText {
                                    text: root.total-count == 0 ? "Start with one small thing."
                                        : "\{root.completed-count} of \{root.total-count} tasks complete";
                                    style: MaterialTypography.body-large;
                                    color: MaterialPalette.on-primary-container;
                                }
                            }
                        }
                        HorizontalLayout {
                            MaterialText {
                                text: "My day";
                                style: MaterialTypography.headline-medium;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            add-button := FilledButton {
                                horizontal-stretch: 0;
                                width: 156px;
                                text: "Add task";
                                icon: Icons.add;
                                clicked => { root.new-task(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            FilterChip { text: "All"; checked <=> root.all-selected; clicked => { root.select-filter(0); } }
                            FilterChip { text: "Open"; checked <=> root.open-selected; clicked => { root.select-filter(1); } }
                            FilterChip { text: "Done"; checked <=> root.done-selected; clicked => { root.select-filter(2); } }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            for task[index] in root.tasks : SegmentedListItem {
                                text: task.title;
                                supporting-text: task.note;
                                supporting-multiline: root.compact;
                                min-height: root.compact && task.note != "" ? 88px : 68px;
                                checkable: true;
                                checked: task.completed;
                                index: index;
                                count: root.tasks.length;
                                clicked => { root.toggle-task(task.id); }
                                IconButton {
                                    horizontal-stretch: 0;
                                    width: 48px;
                                    icon: Icons.edit;
                                    tooltip: "Edit " + task.title;
                                    accessible-label: "Edit " + task.title;
                                    clicked => { root.edit-task(task.id); }
                                }
                            }
                            if root.tasks.length == 0 : MaterialText {
                                text: root.filter == 2 ? "Completed tasks will appear here."
                                    : root.filter == 1 ? "Everything is done. Make room for something new."
                                    : "Add a task to start your day.";
                                wrap: word-wrap;
                                overflow: clip;
                                style: MaterialTypography.body-large;
                            }
                        }
                        MaterialText {
                            text: "A little progress is still progress.";
                            style: MaterialTypography.body-medium;
                            color: MaterialPalette.on-surface-variant;
                        }
                    }

                    if root.page == 1 : VerticalLayout {
                        spacing: 24px;
                        MaterialText { text: "Make it yours."; style: MaterialTypography.headline-large; }
                        MaterialText {
                            text: "Choose the colors and motion that feel comfortable.";
                            style: MaterialTypography.body-large;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                        HorizontalLayout {
                            MaterialText { horizontal-stretch: 1; text: "Dark colors"; style: MaterialTypography.title-medium; vertical-alignment: center; }
                            Switch { width: 52px; checked <=> root.dark; accessible-label: "Dark colors"; }
                        }
                        HorizontalDivider {}
                        HorizontalLayout {
                            MaterialText { horizontal-stretch: 1; text: "Reduce motion"; style: MaterialTypography.title-medium; vertical-alignment: center; }
                            Switch { width: 52px; checked <=> root.reduced-motion; accessible-label: "Reduce motion"; }
                        }
                        MaterialText {
                            text: "Tasks stay in memory while this window is open.";
                            wrap: word-wrap;
                            overflow: clip;
                            color: MaterialPalette.on-surface-variant;
                        }
                    }
                }
            }
        }
        if root.compact : NavigationBar {
            items: root.destinations;
            current-index <=> root.page;
        }
    }

    editor := Dialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: "Task details";
        forward-focus: title-field;
        default-action-text: "Save task";
        actions: ["Cancel"];
        dismissed => {
            root.editor-open = false;
        }
        action-clicked(index) => { root.close-editor(); }
        default-action-clicked => {
            if root.save-task(root.draft-title, root.draft-note) { root.close-editor(); }
            else { title-field.focus(); }
        }
        VerticalLayout {
            spacing: 16px;
            title-field := TextField {
                label: "Task name";
                text <=> root.draft-title;
                has-error: root.form-error != "";
                supporting-text: root.form-error;
                edited(text) => { root.form-error = ""; }
                key-pressed(event) => {
                    if event.text == Key.Escape { root.close-editor(); return accept; }
                    reject
                }
                accepted(text) => {
                    if root.save-task(root.draft-title, root.draft-note) { root.close-editor(); }
                }
            }
            TextField {
                label: "Notes (optional)";
                text <=> root.draft-note;
                key-pressed(event) => {
                    if event.text == Key.Escape { root.close-editor(); return accept; }
                    reject
                }
                accepted(text) => {
                    if root.save-task(root.draft-title, root.draft-note) { root.close-editor(); }
                    else { title-field.focus(); }
                }
            }
        }
    }
}
