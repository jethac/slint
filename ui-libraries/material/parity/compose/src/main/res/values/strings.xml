<!-- Paparazzi does not load aar resources for unit-test renders (resources.json
     lists no aarExplodedDirs), so the internal getString() lookups of the
     upstream components fail. Declaring the strings they resolve gives them the
     same merged ids with their official default values — the `m3c_*` ones live
     in m3c_strings.xml (androidx.compose.material3:material3:1.5.0-alpha18,
     values.xml; androidx.compose.ui:ui's close_sheet;
     androidx.compose.foundation:foundation's tooltip_*). -->
<resources>
    <string name="close_sheet">Close sheet</string>
    <string name="tooltip_label">show tooltip</string>
    <string name="tooltip_description">tooltip</string>
</resources>
