<!-- Paparazzi does not load aar resources for unit-test renders (resources.json
     lists no aarExplodedDirs), so material3's internal getString() lookups fail.
     Declaring the two strings the pinned SearchBarDefaults.InputField resolves
     here gives them the same merged ids with their official default values
     (androidx.compose.material3:material3:1.5.0-alpha18, values.xml). -->
<resources>
    <string name="m3c_search_bar_search">Search</string>
    <string name="m3c_suggestions_available">Suggestions below</string>
    <!-- The `m3c_time_picker_*`/`m3c_time_*_dialog_title` strings the pinned
         TimePicker.kt/TimePickerDialog.kt getString() calls resolve. -->
    <string name="m3c_time_picker_pm">PM</string>
    <string name="m3c_time_picker_am">AM</string>
    <string name="m3c_time_picker_period_toggle_description">Select AM or PM</string>
    <string name="m3c_time_picker_hour_selection">Select hour</string>
    <string name="m3c_time_picker_minute_selection">Select minutes</string>
    <string name="m3c_time_picker_hour_suffix">%1$d o\'clock</string>
    <string name="m3c_time_picker_hour_24h_suffix">%1$d hours</string>
    <string name="m3c_time_picker_minute_suffix">%1$d minutes</string>
    <string name="m3c_time_picker_minute">Minute</string>
    <string name="m3c_time_picker_hour">Hour</string>
    <string name="m3c_time_picker_minute_text_field">for minutes</string>
    <string name="m3c_time_picker_hour_text_field">for hour</string>
    <string name="m3c_time_picker_toggle_keyboard">Switch to text input mode</string>
    <string name="m3c_time_picker_toggle_scroll">Switch to scroll mode</string>
    <string name="m3c_time_picker_toggle_touch">Switch to clock mode</string>
    <string name="m3c_time_picker_dialog_title">Select Time</string>
    <string name="m3c_time_scroll_dialog_title">Select Time</string>
    <string name="m3c_time_input_dialog_title">Enter Time</string>
    <string name="m3c_time_picker_minute_error">Minute must be 0–59</string>
    <string name="m3c_time_picker_hour_error">Hour must be 1–12</string>
    <string name="m3c_time_picker_hour_error_24h">Hour must be 0–23</string>
</resources>
