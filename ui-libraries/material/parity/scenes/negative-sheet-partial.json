{
  "name": "negative-sheet-partial",
  "type": "canvas",
  "parity": "negative",
  "negative_note": "the Slint sheet skips the partial anchor the Compose reference keeps — the same drag lands on a different offset and must fail the trace compare",
  "size": [360, 240],
  "densities": [1, 2],
  "theme": {
    "seed": "6750A4",
    "variant": "tonal-spot",
    "spec": "spec2025",
    "platform": "phone",
    "dark": false,
    "contrast": 0.0
  },
  "fonts": {
    "plain": "Roboto",
    "brand": "Roboto"
  },
  "times": [0, 33, 66, 200, 260, 450, 900],
  "trace_elements": ["sheet0"],
  "trace_props": ["sheet-offset", "current-value", "target-value", "is-visible"],
  "actions": [
    { "kind": "press", "x": 180, "y": 100, "at": 0 },
    { "kind": "move", "x": 180, "y": 116, "at": 16 },
    { "kind": "move", "x": 180, "y": 132, "at": 33 },
    { "kind": "move", "x": 180, "y": 140, "at": 50 },
    { "kind": "release", "x": 180, "y": 140, "at": 200, "velocity": 0 }
  ],
  "widgets": [
    {
      "kind": "bottom-sheet",
      "x": 0,
      "y": 0,
      "width": 360,
      "height": 240,
      "sheet_height": 120,
      "initial": "expanded",
      "content_color": "tertiary-container",
      "slint_overrides": {
        "skip_partial": true
      }
    }
  ]
}
